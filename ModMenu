        const resultsContainer = document.getElementById('searchResults');
        if (!resultsContainer) return;

        const startTime = performance.now();
        const isDark = currentTheme !== 'standard';

        const allElements = document.querySelectorAll('*');
        const elementMatches = [];

        allElements.forEach(el => {
            const text = el.textContent || el.innerText || '';
            if (text.includes(query)) {
                const tag = el.tagName.toLowerCase();
                const id = el.id ? `#${el.id}` : '';
                const classes = el.className ? `.${el.className.split(' ').join('.')}` : '';
                elementMatches.push({
                    tag: tag,
                    id: id,
                    classes: classes,
                    text: text.substring(0, 200) + (text.length > 200 ? '...' : ''),
                    element: el
                });
            }
        });

        const scriptMatches = [];
        document.querySelectorAll('script').forEach((script, i) => {
            const content = script.textContent || '';
            if (content.includes(query)) {
                const lines = content.split('\n');
                const lineNumbers = [];
                lines.forEach((line, idx) => {
                    if (line.includes(query)) {
                        lineNumbers.push(idx + 1);
                    }
                });
                scriptMatches.push({
                    index: i,
                    lineNumbers: lineNumbers,
                    preview: content.substring(0, 300) + (content.length > 300 ? '...' : '')
                });
            }
        });

        const allKeys = Object.keys(window);
        const varMatches = [];
        allKeys.forEach(key => {
            try {
                const val = window[key];
                const valStr = JSON.stringify(val);
                if (valStr && valStr.includes(query)) {
                    varMatches.push({
                        key: key,
                        type: typeof val,
                        preview: valStr.substring(0, 100) + (valStr.length > 100 ? '...' : '')
                    });
                }
            } catch(e) {}
        });

        let html = `<div style="padding:4px; font-size:9px; color:#6b7280; border-bottom:1px solid ${isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'};">
            Found ${elementMatches.length} DOM elements, ${scriptMatches.length} script tags, ${varMatches.length} variables
            <span style="float:right;">${(performance.now() - startTime).toFixed(1)}ms</span>
        </div>`;

        if (elementMatches.length > 0) {
            html += `<div style="margin-top:4px;"><span style="font-weight:600; font-size:10px; color:${isDark ? '#f3f4f6' : '#111827'};">📄 DOM Elements (${elementMatches.length})</span>`;
            elementMatches.slice(0, 20).forEach(match => {
                const selector = match.tag + match.id + match.classes;
                html += `<div style="padding:2px 4px; font-size:9px; color:${isDark ? '#d1d5db' : '#374151'}; border-bottom:1px solid ${isDark ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.03)'};">
                    <span style="color:#3b82f6;">${selector}</span>
                    <span style="color:#6b7280; font-size:8px;">${match.text}</span>
                </div>`;
            });
            if (elementMatches.length > 20) {
                html += `<div style="color:#6b7280; font-size:8px; padding:2px 4px;">... and ${elementMatches.length - 20} more</div>`;
            }
            html += `</div>`;
        }

        if (scriptMatches.length > 0) {
            html += `<div style="margin-top:4px;"><span style="font-weight:600; font-size:10px; color:${isDark ? '#f3f4f6' : '#111827'};">📜 Script Tags (${scriptMatches.length})</span>`;
            scriptMatches.slice(0, 5).forEach((script, idx) => {
                const lines = script.lineNumbers.join(', ');
                html += `<div style="padding:2px 4px; font-size:8px; color:${isDark ? '#d1d5db' : '#374151'}; border-bottom:1px solid ${isDark ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.03)'};">
                    <span style="color:#8b5cf6;">Script #${script.index + 1}</span>
                    <span style="color:#6b7280;">lines: ${lines}</span>
                    <div style="color:#6b7280; font-size:7px; padding:2px 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${script.preview}</div>
                </div>`;
            });
            if (scriptMatches.length > 5) {
                html += `<div style="color:#6b7280; font-size:8px; padding:2px 4px;">... and ${scriptMatches.length - 5} more</div>`;
            }
            html += `</div>`;
        }

        if (varMatches.length > 0) {
            html += `<div style="margin-top:4px;"><span style="font-weight:600; font-size:10px; color:${isDark ? '#f3f4f6' : '#111827'};">🔧 Variables (${varMatches.length})</span>`;
            varMatches.slice(0, 10).forEach(match => {
                html += `<div style="padding:2px 4px; font-size:9px; color:${isDark ? '#d1d5db' : '#374151'}; border-bottom:1px solid ${isDark ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.03)'};">
