    const FROST_WEBSITE_AUDIO_STORAGE='frostbyteWebsiteAudioV1';

    let frostWebsiteAudioSettings=frostReadJson(FROST_WEBSITE_AUDIO_STORAGE,{
        muted:false,
        volume:1
    });

    const frostWebsiteMediaElements=new Set();
    const frostWebsiteMediaOriginal=new WeakMap();
    const frostWebsiteAudioContexts=new Set();
    const frostWebsiteSuspendedContexts=new Set();

    let frostWebsiteAudioObserver=null;
    let frostWebsiteAudioPatched=false;
    let frostWebsiteOriginalPlay=null;
    let frostWebsiteOriginalBufferStart=null;
    let frostWebsiteOriginalOscStart=null;
    let frostWebsiteOriginalConstantStart=null;

    function frostWebsiteIsOwnAudio(media){
        try{
            if(media===menuSound)return true;
            if(typeof frostV28MusicAudio!=='undefined'&&media===frostV28MusicAudio)return true;
            if(media?.dataset?.frostbyteAudio==='ui')return true;
        }catch(e){}
        return false;
    }

    function frostWebsiteRememberMedia(media){
        if(!media||frostWebsiteIsOwnAudio(media))return;
        frostWebsiteMediaElements.add(media);

        if(!frostWebsiteMediaOriginal.has(media)){
            frostWebsiteMediaOriginal.set(media,{
                muted:!!media.muted,
                volume:Number.isFinite(media.volume)?media.volume:1
            });
        }
    }

    function frostWebsiteApplyMedia(media){
        if(!media||frostWebsiteIsOwnAudio(media))return;
        frostWebsiteRememberMedia(media);

        const base=frostWebsiteMediaOriginal.get(media)||{muted:false,volume:1};
        const master=Math.max(0,Math.min(1,Number(frostWebsiteAudioSettings.volume) || 0));

        try{
            media.volume=Math.max(0,Math.min(1,base.volume*master));
            media.muted=!!frostWebsiteAudioSettings.muted || !!base.muted;
        }catch(e){}
    }

    function frostWebsiteScanMedia(root=document){
        try{
            if(root instanceof HTMLMediaElement)frostWebsiteApplyMedia(root);
            root.querySelectorAll?.('audio,video').forEach(frostWebsiteApplyMedia);
        }catch(e){}
        frostWebsiteUpdateAudioUi();
    }

    function frostWebsiteCaptureContext(ctx){
        if(!ctx)return;
        frostWebsiteAudioContexts.add(ctx);

        if(frostWebsiteAudioSettings.muted && ctx.state==='running'){
            Promise.resolve(ctx.suspend?.()).then(()=>{
                frostWebsiteSuspendedContexts.add(ctx);
            }).catch(()=>{});
        }
    }

    function frostWebsitePatchAudioSources(){
        if(frostWebsiteAudioPatched)return;
        frostWebsiteAudioPatched=true;

        try{
            frostWebsiteOriginalPlay=HTMLMediaElement.prototype.play;
            HTMLMediaElement.prototype.play=function(...args){
                if(!frostWebsiteIsOwnAudio(this))frostWebsiteApplyMedia(this);
                return frostWebsiteOriginalPlay.apply(this,args);
            };
        }catch(e){}

        try{
            if(window.AudioBufferSourceNode?.prototype?.start){
                frostWebsiteOriginalBufferStart=AudioBufferSourceNode.prototype.start;
                AudioBufferSourceNode.prototype.start=function(...args){
                    frostWebsiteCaptureContext(this.context);
                    return frostWebsiteOriginalBufferStart.apply(this,args);
                };
            }
        }catch(e){}

        try{
            if(window.OscillatorNode?.prototype?.start){
                frostWebsiteOriginalOscStart=OscillatorNode.prototype.start;
                OscillatorNode.prototype.start=function(...args){
                    frostWebsiteCaptureContext(this.context);
                    return frostWebsiteOriginalOscStart.apply(this,args);
                };
            }
        }catch(e){}

        try{
            if(window.ConstantSourceNode?.prototype?.start){
                frostWebsiteOriginalConstantStart=ConstantSourceNode.prototype.start;
                ConstantSourceNode.prototype.start=function(...args){
                    frostWebsiteCaptureContext(this.context);
                    return frostWebsiteOriginalConstantStart.apply(this,args);
                };
            }
        }catch(e){}
    }

    function frostWebsiteApplyAudio(){
        frostWebsiteAudioSettings.volume=Math.max(
            0,
            Math.min(1,Number(frostWebsiteAudioSettings.volume)||0)
        );
        frostWriteJson(FROST_WEBSITE_AUDIO_STORAGE,frostWebsiteAudioSettings);

        frostWebsiteScanMedia(document);

        if(frostWebsiteAudioSettings.muted){
            frostWebsiteAudioContexts.forEach(ctx=>{
                try{
                    if(ctx.state==='running'){
                        Promise.resolve(ctx.suspend()).then(()=>{
                            frostWebsiteSuspendedContexts.add(ctx);
                        }).catch(()=>{});
                    }
                }catch(e){}
            });
        }else{
            [...frostWebsiteSuspendedContexts].forEach(ctx=>{
                try{Promise.resolve(ctx.resume()).catch(()=>{})}catch(e){}
            });
            frostWebsiteSuspendedContexts.clear();
        }

        frostWebsiteUpdateAudioUi();
    }

    function frostWebsiteAudioInit(){
        frostWebsitePatchAudioSources();

        try{menuSound.dataset.frostbyteAudio='ui'}catch(e){}
        try{
            if(typeof frostV28MusicAudio!=='undefined'){
                frostV28MusicAudio.dataset.frostbyteAudio='ui';
            }
        }catch(e){}

        if(frostWebsiteAudioObserver)frostWebsiteAudioObserver.disconnect();

        frostWebsiteAudioObserver=new MutationObserver(records=>{
            for(const record of records){
                record.addedNodes.forEach(node=>{
                    if(node.nodeType===1)frostWebsiteScanMedia(node);
                });
            }
        });

        try{
            frostWebsiteAudioObserver.observe(document.documentElement,{
                childList:true,
                subtree:true
            });
        }catch(e){}

        frostWebsiteApplyAudio();
    }

    function frostWebsiteSetMuted(value){
        frostWebsiteAudioSettings.muted=!!value;
        frostWebsiteApplyAudio();
        showNotification(
