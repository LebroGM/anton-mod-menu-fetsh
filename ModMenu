    // ==========================================
    // FINISH LEVEL ALWAYS TYPE = TEST - LEVEL SECTION
    // Normal level event:
    //   { event:"finishLevel", ..., type:"normal" }
    //
    // When enabled, only the top-level type value is changed:
    //   type:"normal" -> type:"test"
    //
    // Every other finishLevel field is forwarded unchanged.
    // ==========================================
    let finishLevelAlwaysTestOriginalLogMethod = null;
    let finishLevelAlwaysTestWrapper = null;
    let finishLevelAlwaysTestInterceptCount = 0;

    function frostFinishLevelAlwaysTestTransform(data) {
        if (
            !finishLevelAlwaysTestActive ||
            !data ||
            data.event !== 'finishLevel' ||
            data.type !== 'normal'
        ) {
            return data;
        }

        // Prefer modifying the original event object, matching the existing
        // interception style used by other Nineytone toggles.
        try {
            data.type = 'test';
        } catch (_) {}

        // Frozen/read-only payload fallback.
        if (data.type === 'normal') {
            return { ...data, type: 'test' };
        }

        return data;
    }

    function toggleFinishLevelAlwaysTest(enable) {
        finishLevelAlwaysTestActive = !!enable;

        if (finishLevelAlwaysTestActive && finishLevelAlwaysNormalActive) {
            toggleFinishLevelAlwaysNormal(false);
        }
        if (finishLevelAlwaysTestActive && finishEventTypeBulbActive) {
            toggleFinishEventTypeBulb(false);
        }

        if (finishLevelAlwaysTestActive) {
            if (
                typeof log === 'undefined' ||
                log === null ||
                typeof log.log !== 'function'
            ) {
                finishLevelAlwaysTestActive = false;
                showNotification('❌ Finish Level Always Type = Test could not attach to log.log', 'error');
                playSound('error');
                return false;
            }

            const downstream = log.log.bind(log);
            finishLevelAlwaysTestOriginalLogMethod = downstream;

            finishLevelAlwaysTestWrapper = function(data) {
                const matched = !!(
                    data &&
                    data.event === 'finishLevel' &&
                    data.type === 'normal'
                );

                const outgoing = frostFinishLevelAlwaysTestTransform(data);

                if (matched) {
                    finishLevelAlwaysTestInterceptCount++;
                    console.log(
                        `[FINISH LEVEL ALWAYS TYPE = TEST] finishLevel type: normal → test ` +
                        `(Changed: ${finishLevelAlwaysTestInterceptCount})`
                    );
                    showNotification(
                        `🧪 finishLevel normal → test (${finishLevelAlwaysTestInterceptCount})`,
                        'success'
                    );
                }

                return downstream(outgoing);
            };

            log.log = finishLevelAlwaysTestWrapper;

            const toggle = document.getElementById('finishLevelAlwaysTestToggle');
            const label = document.getElementById('finishLevelAlwaysTestLabel');
            toggle?.classList.add('active');
            if (label) {
                label.textContent = 'ON';
                label.classList.add('active');
            }

            showNotification('🧪 Finish Level Always Type = Test activated', 'success');
            playSound('toggle');
            return true;
        }

        // Do not destroy a newer wrapper installed above this feature.
        // If our wrapper is still the outermost one, restore its downstream
        // function. If another feature wrapped it later, this wrapper simply
        // becomes a transparent pass-through because the active flag is false.
        try {
            if (
                typeof log !== 'undefined' &&
                log !== null &&
                finishLevelAlwaysTestWrapper &&
                log.log === finishLevelAlwaysTestWrapper &&
                typeof finishLevelAlwaysTestOriginalLogMethod === 'function'
            ) {
                log.log = finishLevelAlwaysTestOriginalLogMethod;
                finishLevelAlwaysTestWrapper = null;
                finishLevelAlwaysTestOriginalLogMethod = null;
            }
        } catch (_) {}

        finishLevelAlwaysTestInterceptCount = 0;

        const toggle = document.getElementById('finishLevelAlwaysTestToggle');
        const label = document.getElementById('finishLevelAlwaysTestLabel');
        toggle?.classList.remove('active');
        if (label) {
            label.textContent = 'OFF';
            label.classList.remove('active');
        }

        showNotification('🧪 Finish Level Always Type = Test deactivated', 'info');
        playSound('toggle');
        return true;
    }

    function toggleFinishLevelAlwaysTestHandler() {
        return toggleFinishLevelAlwaysTest(!finishLevelAlwaysTestActive);
    }

