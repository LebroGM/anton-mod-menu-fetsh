    function frostRenderFavorites() {
        const launch = document.getElementById('frostFavoriteLaunchers');
        const picker = document.getElementById('frostFavoritesPicker');
        if (!launch || !picker) return;
        frostFavorites = frostFavorites.filter(id => !!frostSafeTabMeta(id));
        if (!frostFavorites.length) frostFavorites = ['general'];

        launch.innerHTML = frostFavorites.map(id => {
            const m = frostSafeTabMeta(id);
            return `<button class="frost-favorite-launch" data-favorite-launch="${m.id}"><span>${m.icon}</span>${frostEscapeHtml(m.label)}</button>`;
        }).join('');
        picker.innerHTML = FROST_SAFE_TABS.map(([id,icon,label]) =>
            `<label class="frost-list-item"><input type="checkbox" data-favorite-toggle="${id}" ${frostFavorites.includes(id)?'checked':''}><div class="grow"><strong>${icon} ${frostEscapeHtml(label)}</strong><small>Show in Favorites</small></div></label>`
        ).join('');

        launch.querySelectorAll('[data-favorite-launch]').forEach(btn => btn.addEventListener('click', () => switchSection(btn.dataset.favoriteLaunch)));
        picker.querySelectorAll('[data-favorite-toggle]').forEach(box => box.addEventListener('change', () => {
            const id = box.dataset.favoriteToggle;
            if (box.checked && !frostFavorites.includes(id)) frostFavorites.push(id);
            if (!box.checked) frostFavorites = frostFavorites.filter(x => x !== id);
            frostWriteJson(FROST_FAVORITES_STORAGE, frostFavorites);
            frostRenderFavorites();
        }));
    }

    function frostRenderSnippets() {
        const host = document.getElementById('frostSnippetList');
        if (!host) return;
        host.innerHTML = frostSnippets.length ? frostSnippets.map((txt,i) =>
            `<div class="frost-list-item"><div class="grow"><strong>Snippet ${i+1}</strong><small>${frostEscapeHtml(String(txt).slice(0,120))}</small></div><button class="btn" data-snippet-use="${i}">Use</button><button class="btn danger" data-snippet-del="${i}">Delete</button></div>`
        ).join('') : '<div class="frost-muted">No saved snippets.</div>';

        host.querySelectorAll('[data-snippet-use]').forEach(b => b.addEventListener('click', () => {
            const a = document.getElementById('frostClipboardArea'); if (a) a.value = frostSnippets[+b.dataset.snippetUse] || '';
        }));
        host.querySelectorAll('[data-snippet-del]').forEach(b => b.addEventListener('click', () => {
            frostSnippets.splice(+b.dataset.snippetDel,1); frostWriteJson(FROST_SNIPPETS_STORAGE,frostSnippets); frostRenderSnippets();
        }));
    }

    function frostRenderProfiles() {
        const select = document.getElementById('frostProfileSelect');
        if (!select) return;
        const names = Object.keys(frostProfiles).sort((a,b)=>a.localeCompare(b));
        select.innerHTML = names.length ? names.map(n => `<option value="${frostEscapeHtml(n)}">${frostEscapeHtml(n)}</option>`).join('') : '<option value="">No profiles saved</option>';
    }

