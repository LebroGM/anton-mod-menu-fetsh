    function frostV27ReorderSidebar() {
        const sidebar = document.getElementById('modMenuSidebar');
        if (!sidebar) return;

        sidebar.querySelectorAll('.frost-sidebar-group').forEach(el => el.remove());

        const home = sidebar.querySelector('[data-section="general"]');
        if (home) {
            home.querySelector('.label').textContent = 'Home';
            home.querySelector('.icon').textContent = '⌂';
        }

        const relabel = (section, icon, label) => {
            const btn = sidebar.querySelector(`[data-section="${section}"]`);
            if (!btn) return;
            const iconEl = btn.querySelector('.icon');
            const labelEl = btn.querySelector('.label');
            if (iconEl) iconEl.textContent = icon;
            if (labelEl) labelEl.textContent = label;
        };

        relabel('texture','▧','Website Style');
        relabel('website','◧','Website Controls');
        relabel('eventlistener','↯','Event Listener');
        relabel('autoclicker','✧','Auto Clicker');
        relabel('destroy','×','Destroy GUI');

        let apiBtn = sidebar.querySelector('[data-section="apifetcher"]');
        if (!apiBtn) {
            apiBtn = document.createElement('button');
            apiBtn.className = 'sidebar-item frost-v27-tab';
            apiBtn.dataset.section = 'apifetcher';
            apiBtn.innerHTML = '<span class="icon">⇄</span><span class="label">API Fetcher</span>';
            apiBtn.addEventListener('click', () => {
                switchSection('apifetcher');
                animateSidebarItem(apiBtn);
                playSound('switch');
            });
        }

        const groups = [
            ['HOME', ['general']],
            ['MODS', ['currencies','level','games','account','support','avatar','sounds','antiAfk']],
            ['DEVELOPER', ['autoclicker','eventlistener','apifetcher','console','searchevent','calculator','texture','website']],
            ['Nineytone', ['jkeybinds','themes','effects','frostlab','customize','backgrounds','layout','audiostudio','tools','notes','clipboard','inspector','performance','favorites','activitylog','profiles','importexport','accessibility','commandpalette','notifications','changelog','credits','help']],
            ['SYSTEM', ['destroy']]
        ];

        groups.forEach(([title, sections]) => {
            if (title !== 'HOME') {
                const group = document.createElement('div');
                group.className = 'frost-sidebar-group';
                group.textContent = title;
                sidebar.appendChild(group);
            }
            sections.forEach(section => {
                const btn = section === 'apifetcher' ? apiBtn : sidebar.querySelector(`[data-section="${section}"]`);
                if (btn) sidebar.appendChild(btn);
            });
        });
    }

