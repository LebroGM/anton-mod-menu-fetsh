    function frostV29ConvertValue(value,from,to) {
        const groups = {
            length:{m:1,km:1000,cm:.01,mm:.001,mi:1609.344,ft:.3048,in:.0254},
            data:{b:1,kb:1000,mb:1e6,gb:1e9,kib:1024,mib:1048576,gib:1073741824}
        };
        for(const group of Object.values(groups)) {
            if(group[from] && group[to]) return value * group[from] / group[to];
        }
        if(['c','f','k'].includes(from) && ['c','f','k'].includes(to)) {
            let c = from==='c'?value:from==='f'?(value-32)*5/9:value-273.15;
            return to==='c'?c:to==='f'?c*9/5+32:c+273.15;
        }
        throw new Error('Choose compatible units');
    }

