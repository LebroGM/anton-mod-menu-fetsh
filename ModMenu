            const json=JSON.stringify(value,(key,val)=>{
                if(typeof val==='string'){
                    return val.length>5000?val.slice(0,5000)+'… [truncated]':val;
                }
                if(typeof val==='bigint')return String(val)+'n';
                if(typeof val==='function')return '[Function]';
                if(typeof val==='symbol')return String(val);

                if(val&&typeof val==='object'){
                    if(seen.has(val))return '[Circular]';
                    seen.add(val);
                }
                return val;
            });

            return JSON.parse(json);
        }catch(e){
            try{return {value:String(value),captureError:String(e.message||e)}}catch(_){return {value:'[unserializable]'}}
        }
    }

    function frostAntonCompact(value,max=260){
        let text='';
        try{text=JSON.stringify(value)}catch(e){text=String(value)}
        return text.length>max?text.slice(0,max)+'…':text;
    }

    function frostAntonPretty(value){
        try{return JSON.stringify(value,null,2)}catch(e){return String(value)}
    }

    function frostAntonSignature(data){
        const eventName=String(data?.event||'unknown');
        let payload='';
        try{payload=JSON.stringify(data)}catch(e){payload=String(data)}
        if(payload.length>1200)payload=payload.slice(0,1200);
        return eventName+'|'+payload;
    }

    function frostAntonCapture(data){
        if(!frostAntonLogger.enabled||frostAntonLogger.paused)return;
        if(!data||typeof data!=='object')return;

        const eventName=String(data.event||'unknown');
        const category=frostAntonCategory(eventName);

        if(!frostAntonLogger.filters.has(category))return;

        const cloned=frostAntonSafeClone(data);
        const signature=frostAntonSignature(cloned);
        const nowPerf=performance.now();

        // Prevent duplicate rows if another ANTON feature wraps our wrapper
        // and the logger reconnects around that chain.
        if(
            signature===frostAntonLogger.lastSignature &&
            nowPerf-frostAntonLogger.lastSignatureAt<12
        ){
            return;
        }

        frostAntonLogger.lastSignature=signature;
        frostAntonLogger.lastSignatureAt=nowPerf;

        const entry={
            id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),
            time:Date.now(),
            event:eventName,
            category,
            data:cloned,
            preview:frostAntonCompact(cloned),
            expanded:false
        };

        frostAntonLogger.entries.unshift(entry);

        if(frostAntonLogger.entries.length>frostAntonLogger.maxEvents){
            frostAntonLogger.entries.length=frostAntonLogger.maxEvents;
        }

        frostAntonRender();
    }

    function frostAntonInstallWrapper(force=false){
        if(!frostAntonLogger.enabled)return false;

        const obj=frostAntonGetLogObject();
        if(!obj){
            frostAntonLogger.attached=false;
            frostAntonLogger.hookState='WAITING FOR log.log';
            frostAntonRender();
            return false;
        }

        if(
            !force &&
            frostAntonLogger.attached &&
            frostAntonLogger.logObject===obj &&
            obj.log===frostAntonLogger.latestWrapper
        ){
            return true;
        }

        const base=obj.log;
        if(typeof base!=='function')return false;

        const generation=++frostAntonLogger.generation;

        const wrapper=function(...args){
            // If Session > Anti AFK is active, normalize the session event
            // BEFORE the Event Listener captures it. This prevents the UI
            // from showing the stale `type:"suspend"` value when the listener
            // happens to be the outermost log.log wrapper.
            if(
                antiAfkActive &&
                args[0] &&
                args[0].event==='sessionEnd' &&
                args[0].type==='suspend'
            ){
                args[0]=frostAntiAfkTransform(args[0]);
            }

            if(
                frostAntonPlusUnlockGamesShouldBlock(args[0])
            ){
                // Keep the attempted event visible in the Event Listener
                // for debugging, but never forward it to the website.
                if(
                    frostAntonLogger.enabled &&
                    generation===frostAntonLogger.generation
                ){
                    try{frostAntonCapture(args[0])}catch(e){
                        console.warn('[ANTON EVENT LISTENER] blocked-event capture failed:',e);
                    }
                }

                frostAntonPlusUnlockGamesRecordBlocked(args[0]);
                return undefined;
            }

            if(
                args[0] &&
                frostIsFinishGameEvent(args[0]) &&
                (
                    (
                        gameDebugModeAlwaysActive &&
                        Object.prototype.hasOwnProperty.call(args[0], 'isDebug') &&
                        args[0].isDebug !== true
                    ) ||
                    (
                        args[0].event==='finishGameBroadJump' &&
                        antonSportsSpeedOverrideActive &&
                        Object.prototype.hasOwnProperty.call(args[0], 'speed') &&
                        args[0].speed!==antonSportsSpeedOverrideValue
                    ) ||
                    (
                        args[0].event==='finishGameBroadJump' &&
                        antonSportsAccuracyOverrideActive &&
                        Object.prototype.hasOwnProperty.call(args[0], 'accuracy') &&
                        args[0].accuracy!==antonSportsAccuracyOverrideValue
                    )
                )
            ){
                args[0]=frostGameEventOverridesTransform(args[0]);
            }

            if(
                debugCoinsOverrideActive &&
                debugCoinsOverrideConfigured &&
                args[0] &&
                args[0].event==='debugCoins'
            ){
                args[0]=frostDebugCoinsTransform(args[0]);
            }

            if(
                finishLevelAlwaysTestActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].type==='normal'
            ){
                args[0]=frostFinishLevelAlwaysTestTransform(args[0]);
            }

            if(
                finishLevelAlwaysNormalActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].type==='test'
            ){
                args[0]=frostFinishLevelAlwaysNormalTransform(args[0]);
            }

            if(
                finishEventTypeBulbActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].type!==undefined &&
                args[0].type!=='bulb'
            ){
                args[0]=frostFinishEventTypeBulbTransform(args[0]);
            }

            if(
                finishLevelAlwaysNoMistakesActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].mistakes!==undefined &&
                args[0].mistakes!==0
            ){
                args[0]=frostFinishLevelAlwaysNoMistakesTransform(args[0]);
            }

            if(
                inLevelNoMistakesActive &&
                args[0] &&
                args[0].event==='score' &&
                args[0].mistakes!==undefined &&
                args[0].mistakes!==0
            ){
                args[0]=frostInLevelNoMistakesTransform(args[0]);
            }

            if(
                finishLevelCustomMistakesActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].mistakes!==undefined &&
                args[0].mistakes!==finishLevelCustomMistakesValue
            ){
                args[0]=frostFinishLevelCustomMistakesTransform(args[0]);
            }

            if(
                finishLevelAlwaysNoCorrectsActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].corrects!==undefined &&
                args[0].corrects!==0
            ){
                args[0]=frostFinishLevelAlwaysNoCorrectsTransform(args[0]);
            }

            if(
                finishLevelCustomCorrectsActive &&
                args[0] &&
                args[0].event==='finishLevel' &&
                args[0].corrects!==undefined &&
                args[0].corrects!==finishLevelCustomCorrectsValue
            ){
                args[0]=frostFinishLevelCustomCorrectsTransform(args[0]);
            }

            if(
                finishLevelScoreOverrideActive &&
                frostIsFullFinishLevelEvent(args[0]) &&
                args[0].score!==finishLevelScoreOverrideValue
            ){
                args[0]=frostFinishLevelScoreTransform(args[0]);
            }

            if(
                nextCoinStarsOverrideActive &&
                args[0] &&
                args[0].event==='setNextCoinTotalStars' &&
                args[0].value!==undefined &&
                args[0].value!==nextCoinStarsOverrideValue
            ){
                args[0]=frostNextCoinStarsTransform(args[0]);
            }

            if(
                getAlwaysCoinsActive &&
                args[0] &&
                args[0].event==='setNextCoinTotalStars' &&
                args[0].value!==undefined &&
                args[0].value!==0
            ){
                args[0]=frostGetAlwaysCoinsTransform(args[0]);
            }

            if(
                disableGettingCoinsActive &&
                args[0] &&
                args[0].event==='setNextCoinTotalStars' &&
                args[0].value!==undefined &&
                args[0].value!==DISABLE_GETTING_COINS_VALUE
            ){
                args[0]=frostDisableGettingCoinsTransform(args[0]);
            }

            // Only the newest wrapper captures. Older wrappers that may remain
            // inside another feature's chain become transparent pass-throughs.
            if(
                frostAntonLogger.enabled &&
                generation===frostAntonLogger.generation
            ){
                try{frostAntonCapture(args[0])}catch(e){
                    console.warn('[ANTON EVENT LISTENER] capture failed:',e);
                }
            }

            return base.apply(this,args);
        };

        wrapper.__frostAntonLogger=true;
        wrapper.__frostAntonGeneration=generation;
        wrapper.__frostAntonBase=base;

        try{
            obj.log=wrapper;
        }catch(e){
            frostAntonLogger.attached=false;
            frostAntonLogger.hookState='ATTACH BLOCKED';
            frostAntonRender();
            return false;
        }

        frostAntonLogger.logObject=obj;
        frostAntonLogger.latestBase=base;
        frostAntonLogger.latestWrapper=wrapper;
        frostAntonLogger.wrappers.push(wrapper);
        frostAntonLogger.attached=true;
        frostAntonLogger.hookState='CONNECTED';

        frostAntonRender();
        return true;
    }

    function frostAntonHealthCheck(){
        if(!frostAntonLogger.enabled)return;

        const obj=frostAntonGetLogObject();

        if(!obj){
            frostAntonLogger.attached=false;
            frostAntonLogger.hookState='WAITING FOR log.log';
            frostAntonRender();
            return;
        }

        if(obj.log===frostAntonLogger.latestWrapper){
            frostAntonLogger.attached=true;
            frostAntonLogger.hookState='CONNECTED';
            frostAntonRender();
            return;
        }

        frostAntonLogger.attached=false;
        frostAntonLogger.hookState='HOOK CHANGED';

        if(frostAntonLogger.autoReconnect){
            frostAntonInstallWrapper(true);
        }else{
            frostAntonRender();
        }
    }

    function frostAntonStart(){
        frostAntonLogger.enabled=true;
        frostAntonLogger.paused=false;

        clearInterval(frostAntonLogger.healthTimer);
        frostAntonInstallWrapper(true);

        frostAntonLogger.healthTimer=setInterval(frostAntonHealthCheck,1000);
        frostAntonRender();
    }

    function frostAntonStop(){
        frostAntonLogger.enabled=false;
        frostAntonLogger.paused=false;
        frostAntonLogger.generation++;

        clearInterval(frostAntonLogger.healthTimer);
        frostAntonLogger.healthTimer=null;

        try{
            const obj=frostAntonLogger.logObject;
            if(
                obj &&
                frostAntonLogger.latestWrapper &&
                obj.log===frostAntonLogger.latestWrapper &&
                typeof frostAntonLogger.latestBase==='function'
            ){
                obj.log=frostAntonLogger.latestBase;
            }
        }catch(e){}

        frostAntonLogger.attached=false;
        frostAntonLogger.logObject=null;
        frostAntonLogger.latestWrapper=null;
        frostAntonLogger.latestBase=null;
        frostAntonLogger.hookState='STOPPED';

        frostAntonRender();
    }

    function frostAntonReconnect(){
        if(!frostAntonLogger.enabled){
            frostAntonStart();
            return;
        }

        frostAntonInstallWrapper(true);
        frostAntonRender();
    }

    function frostAntonFiltered(){
        const q=(document.getElementById('fAntonSearch')?.value||'').trim().toLowerCase();

        let rows=frostAntonLogger.entries.filter(entry=>{
            if(!frostAntonLogger.filters.has(entry.category))return false;
            if(!q)return true;

            return (
                entry.event.toLowerCase().includes(q) ||
                entry.category.includes(q) ||
                entry.preview.toLowerCase().includes(q)
            );
        });

        if(frostAntonLogger.groupDuplicates){
            const grouped=new Map();

            rows.forEach(entry=>{
                const key=entry.event+'|'+entry.preview;
                const existing=grouped.get(key);

                if(existing){
                    existing.count++;
                    if(entry.time>existing.time)existing.time=entry.time;
                }else{
                    grouped.set(key,{...entry,count:1});
                }
            });

            rows=[...grouped.values()];
        }

        return rows;
    }

    function frostAntonCategoryColor(category){
        return {
            coins:'#ffd166',
            support:'#53d8fb',
            games:'#b794f4',
            group:'#63e6be',
            avatar:'#ff8fab',
            session:'#ffa94d',
            stars:'#fff36b',
            level:'#74c0fc',
            sound:'#91a7ff',
            name:'#c0eb75',
            other:'#adb5bd'
        }[category]||'#adb5bd';
    }

    function frostAntonRender(){
        const rowsEl=document.getElementById('fAntonRows');
        if(!rowsEl)return;

        // Preserve the user's current Event Listener scroll position across
        // rerenders, especially when expanding/collapsing a row.
        const previousScrollTop=rowsEl.scrollTop;
        const previousScrollLeft=rowsEl.scrollLeft;

        const rows=frostAntonFiltered();

        const stateEl=document.getElementById('fAntonState');
        const totalEl=document.getElementById('fAntonTotal');
        const visibleEl=document.getElementById('fAntonVisible');
        const lastEl=document.getElementById('fAntonLast');
        const pauseBtn=document.getElementById('fAntonPause');
        const startBtn=document.getElementById('fAntonStart');
        const auto=document.getElementById('fAntonAutoReconnect');
        const max=document.getElementById('fAntonMax');

        if(stateEl){
            stateEl.textContent=
                !frostAntonLogger.enabled
                    ? 'STOPPED'
                    : frostAntonLogger.paused
                        ? 'PAUSED'
                        : frostAntonLogger.hookState;
        }

        if(totalEl)totalEl.textContent=String(frostAntonLogger.entries.length);
        if(visibleEl)visibleEl.textContent=String(rows.length);
        if(lastEl)lastEl.textContent=frostAntonLogger.entries[0]?.event||'—';
        if(pauseBtn)pauseBtn.textContent=frostAntonLogger.paused?'RESUME':'PAUSE';
        if(startBtn)startBtn.textContent=frostAntonLogger.enabled?'LISTENING':'START';
        if(auto)auto.checked=!!frostAntonLogger.autoReconnect;
        if(max)max.value=String(frostAntonLogger.maxEvents);

        document.querySelectorAll('[data-fanton-filter]').forEach(input=>{
            input.checked=frostAntonLogger.filters.has(input.dataset.fantonFilter);
        });

        rowsEl.innerHTML=rows.slice(0,220).map((entry,index)=>{
            const color=frostAntonCategoryColor(entry.category);
            const count=entry.count>1?`<span class="fAntonCountChip">×${entry.count}</span>`:'';

            return `
                <div class="fAntonMenuRow" data-fanton-id="${frostV29Esc(entry.id)}">
                    <div class="fAntonMenuTime">${frostV29Esc(new Date(entry.time).toLocaleTimeString())}</div>

                    <div class="fAntonMenuEvent">
                        <span class="fAntonDot" style="background:${color};box-shadow:0 0 8px ${color}66"></span>
                        <strong>${frostV29Esc(entry.event)}</strong>
                        ${count}
                        <small>${frostV29Esc(entry.category)}</small>
                    </div>

                    <code class="fAntonMenuPreview" title="${frostV29Esc(entry.preview)}">${frostV29Esc(entry.preview)}</code>

                    <button class="btn fAntonMenuCopy" data-fanton-copy="${frostV29Esc(entry.id)}">COPY</button>
                    <button class="btn fAntonMenuExpand" data-fanton-expand="${frostV29Esc(entry.id)}">${entry.expanded?'▲':'▼'}</button>

                    ${entry.expanded?`
                        <pre class="fAntonMenuExpanded">${frostV29Esc(frostAntonPretty(entry.data))}</pre>
                    `:''}
                </div>
            `;
        }).join('')||`
            <div class="frost-v29-muted" style="padding:18px">
                ${frostAntonLogger.enabled
                    ? 'Waiting for matching ANTON events…'
                    : 'Listener stopped. Press START to attach to ANTON log.log.'}
            </div>
        `;

        rowsEl.querySelectorAll('[data-fanton-copy]').forEach(btn=>{
            btn.addEventListener('click',async()=>{
                const entry=frostAntonLogger.entries.find(x=>x.id===btn.dataset.fantonCopy);
                if(!entry)return;

                try{
                    await frostCopyText(frostAntonPretty(entry.data));
                    showNotification(`Copied ${entry.event}`,'success');
                }catch(e){
                    showNotification('Copy blocked','warning');
                }
            });
        });

        rowsEl.querySelectorAll('[data-fanton-expand]').forEach(btn=>{
            btn.addEventListener('click',()=>{
                const entry=frostAntonLogger.entries.find(x=>x.id===btn.dataset.fantonExpand);
                if(!entry)return;
                entry.expanded=!entry.expanded;
                frostAntonRender();

                requestAnimationFrame(()=>{
                    const rows=document.getElementById('fAntonRows');
                    if(!rows)return;
                    rows.scrollTop=previousScrollTop;
                    rows.scrollLeft=previousScrollLeft;
                });
            });
        });
        requestAnimationFrame(()=>{
            if(!rowsEl.isConnected)return;
            rowsEl.scrollTop=previousScrollTop;
            rowsEl.scrollLeft=previousScrollLeft;
        });
    }

    function frostAntonExport(){
        const rows=frostAntonFiltered();
        const payload={
            exportedAt:new Date().toISOString(),
            source:'ANTON log.log',
            count:rows.length,
            events:rows.map(x=>({
                time:new Date(x.time).toISOString(),
                event:x.event,
                category:x.category,
                data:x.data
            }))
        };

        const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');

        a.href=url;
        a.download='anton-events-'+new Date().toISOString().replace(/[:.]/g,'-')+'.json';

        document.body.appendChild(a);
        a.click();
        a.remove();

        setTimeout(()=>URL.revokeObjectURL(url),1000);
    }

