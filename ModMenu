        const livesInput = document.getElementById('longJumpLivesInput');

        if (!scoreInput) { showNotification('❌ Score input not found', 'error'); return; }
        const score = parseFloat(scoreInput.value);
        if (isNaN(score) || score < 0) { showNotification('❌ Please enter a valid score', 'error'); return; }

        const speed = parseInt(speedInput ? speedInput.value : 160) || 160;
        const accuracy = parseInt(accuracyInput ? accuracyInput.value : 0) || 0;
        const lives = parseInt(livesInput ? livesInput.value : 2) || 2;

        sendLongJumpScore(score, speed, accuracy, lives);
        scoreInput.value = '';
        if (scoreInput) scoreInput.focus();
        playSound('click');
    }

    function setLongJumpLives(lives) {
        const speedInput = document.getElementById('longJumpSpeedInput');
        const accuracyInput = document.getElementById('longJumpAccuracyInput');
        const scoreInput = document.getElementById('longJumpScoreInput');

        const speed = parseInt(speedInput ? speedInput.value : 160) || 160;
        const accuracy = parseInt(accuracyInput ? accuracyInput.value : 0) || 0;
        const score = parseFloat(scoreInput ? scoreInput.value : 1.2) || 1.2;

        sendLongJumpScore(score, speed, accuracy, lives);
        const livesDisplay = document.getElementById('longJumpLivesDisplay');
        if (livesDisplay) livesDisplay.textContent = lives;
        showNotification(`❤️ Lives set to: ${lives}`, 'info');
    }

    function addLongJumpLives(amount) {
        const currentLives = parseInt(document.getElementById('longJumpLivesDisplay')?.textContent || '2');
        const newLives = currentLives + amount;
        setLongJumpLives(newLives);
    }

    function removeLongJumpLives(amount) {
        const currentLives = parseInt(document.getElementById('longJumpLivesDisplay')?.textContent || '2');
        const newLives = Math.max(0, currentLives - amount);
        setLongJumpLives(newLives);
    }

    function toggleUnlimitedLongJumpLives() {
        const toggle = document.getElementById('unlimitedLivesToggle');
        const label = document.getElementById('unlimitedLivesLabel');
        const isActive = toggle.classList.toggle('active');
        label.textContent = isActive ? 'ON' : 'OFF';
        label.classList.toggle('active', isActive);

        if (isActive) {
            setLongJumpLives(999);
            document.querySelectorAll('.lives-control-btn').forEach(btn => btn.disabled = true);
            document.getElementById('longJumpLivesInput').disabled = true;
            showNotification('🔒 Unlimited Lives Activated', 'success');
        } else {
            setLongJumpLives(2);
            document.querySelectorAll('.lives-control-btn').forEach(btn => btn.disabled = false);
            document.getElementById('longJumpLivesInput').disabled = false;
            showNotification('🔒 Unlimited Lives Deactivated', 'info');
        }
        playSound('toggle');
    }

    function longJumpGodMode() {
        const score = 9999.99;
        const speed = 999;
        const accuracy = 100;
        const lives = 999;
        sendLongJumpScore(score, speed, accuracy, lives);

        const scoreInput = document.getElementById('longJumpScoreInput');
        const speedInput = document.getElementById('longJumpSpeedInput');
        const accuracyInput = document.getElementById('longJumpAccuracyInput');
        const livesInput = document.getElementById('longJumpLivesInput');
