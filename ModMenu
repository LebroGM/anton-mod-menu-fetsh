    // RESTART GUI - ENHANCED
    // ==========================================
    function restartGui() {
        if (window.__frostGuiRestarting) return false;

        const menu = document.getElementById('modMenuContainer');
        if (!menu) {
            showNotification('❌ GUI is not available to reboot', 'error');
            return false;
        }

        window.__frostGuiRestarting = true;

        const activeSection =
            document.querySelector('#modMenuSidebar .sidebar-item.active[data-section]')?.dataset.section ||
            document.querySelector('.section-panel.active[data-section]')?.dataset.section ||
            'general';

        const styleIds = [
            'antonHacksStyles',
            'notificationStyles',
            'frostV27Styles',
            'frostV28Styles',
            'frostV29Styles',
            'frostV29SupplementalStyles',
            'frostV29GuiPolishStyles',
            'frostV293Styles',
            'websiteTextureStyles'
        ];

        const detachedStyles = styleIds
            .map(id => document.getElementById(id))
            .filter(Boolean);

        const detachableIds = [
            'frostWebsiteSnowLayer',
            'frostV29WeatherLayer',
            'frostV29MiniBar',
            'frostV29Hud',
            'frostV29ContextMenu',
            'notificationContainer'
        ];

        const detachedExtras = detachableIds
            .map(id => {
                const node = document.getElementById(id);
                return node ? { node, parent: node.parentNode } : null;
            })
            .filter(Boolean);

        const savedToggleApi = window.toggleAntonHacks;
        const savedPluginApi = window.Nineytone;

        showNotification('↻ Rebooting Nineytone GUI…', 'info');
        playSound('toggle');

        setTimeout(() => {
            destroyGui();

            // destroyGui has a short exit animation. Reattach the same DOM
            // nodes afterwards so their existing event listeners survive.
            setTimeout(() => {
                try {
                    detachedStyles.forEach(node => {
                        if (!node.isConnected) document.head.appendChild(node);
                    });

                    if (!menu.isConnected) document.body.appendChild(menu);

                    detachedExtras.forEach(({ node, parent }) => {
                        if (node.isConnected) return;
                        const target = parent === menu ? menu : document.body;
                        target.appendChild(node);
                    });

                    menu.classList.remove('hidden','minimized','destroying');
                    menu.style.removeProperty('opacity');
                    menu.style.removeProperty('pointer-events');
                    menu.style.removeProperty('transform');
                    menu.style.removeProperty('transition');

                    isMenuOpen = true;
                    isMinimized = false;

                    if (savedToggleApi) window.toggleAntonHacks = savedToggleApi;
                    if (savedPluginApi) window.Nineytone = savedPluginApi;

                    if (clockInterval) clearInterval(clockInterval);
                    clockInterval = setInterval(updateClock, 1000);
                    updateClock();

                    startSlideshow();
                    initSnowEffect();

                    try { applyFrostUiSettings(false); } catch (e) {}
                    try { applyTheme(currentTheme || 'soldier'); } catch (e) {}
                    try { frostV27ApplyWebsiteStyle(); } catch (e) {}
                    try { frostV29RenderWeather(); } catch (e) {}
                    try { frostApplyModStampVisibility(); } catch (e) {}
                    try { frostV29ApplySidebarStructure(); } catch (e) {}
                    try { frostV29RefreshFeatureSystems(); } catch (e) {}
                    try { frostV28ApplyLanguage(); } catch (e) {}
                    try { frostV29ApplyTranslationOverrides(); } catch (e) {}
                    try { switchSection(activeSection); } catch (e) { switchSection('general'); }

                    showNotification('✓ Nineytone GUI rebooted', 'success');
                    playSound('success');
                } catch (e) {
                    console.error('[Nineytone] GUI reboot failed:', e);
                    showNotification('❌ GUI reboot failed', 'error');
                } finally {
                    window.__frostGuiRestarting = false;
                }
            }, 430);
        }, 120);

        return true;
    }


