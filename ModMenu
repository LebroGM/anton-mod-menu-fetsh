    const FROST_USERNAME_API_URL = 'https://e-apis-db.anton.app/?p=user/setName/set';
    const FROST_DELETE_ACCOUNT_API_URL = 'https://b-apis-db.anton.app/?p=user/markForDelete/mark';
    const FROST_CREATE_ACCOUNT_API_URL = 'https://c-apis-db.anton.app/?p=user/create2/create';
    const FROST_USER_TIMELINE_API_URL = 'https://b-apis-db.anton.app/?p=getUserTimelineEvents/query';

    // ==========================================================
    // ☣︎ Nineytone ☣︎ v29 - API LAB + URL LISTENER
    // Listener captures URL/method/status/timing only.
    // ==========================================================
    const frostV29Net={
        active:false,
        paused:false,
        entries:[],
        totalSeen:0,
        seq:0,
        groupDuplicates:true,
        maxEntries:300,
        expanded:new Set(),
        fetchOriginal:null,
        xhrOpenOriginal:null,
        xhrSendOriginal:null,
        xhrSetHeaderOriginal:null
    };

    function frostV29SafeUrl(raw){
        try{
            const u=new URL(raw,location.href);
            if(!['http:','https:'].includes(u.protocol))throw 0;
            return u.href;
        }catch(e){return ''}
    }

    function frostV29SensitiveKey(key){
        return /(authorization|auth.?token|access.?token|refresh.?token|password|passwd|secret|cookie|session.?token|api.?key)/i.test(String(key||''));
    }

    function frostV29SanitizeNetUrl(rawUrl){
        const safe=frostV29SafeUrl(rawUrl);
        if(!safe)return String(rawUrl||'');

        try{
            const u=new URL(safe);
            [...u.searchParams.keys()].forEach(key=>{
                if(frostV29SensitiveKey(key))u.searchParams.set(key,'[REDACTED]');
            });
            return u.href;
        }catch(e){
            return safe;
        }
    }

    function frostV29EndpointLabel(rawUrl){
        try{
            const u=new URL(rawUrl,location.href);
            const p=u.searchParams.get('p');

            if(u.protocol==='https:'&&u.hostname==='e-apis-db.anton.app'&&p==='user/setName/set')return 'USERNAME';
            if(u.protocol==='https:'&&u.hostname==='b-apis-db.anton.app'&&p==='user/markForDelete/mark')return 'DELETE ACCOUNT';
            if(u.protocol==='https:'&&u.hostname==='c-apis-db.anton.app'&&p==='user/create2/create')return 'CREATE ACCOUNT';
            if(u.protocol==='https:'&&u.hostname==='b-apis-db.anton.app'&&p==='getUserTimelineEvents/query')return 'USER TIMELINE';
        }catch(e){}

        return '';
    }

    function frostV29NormalizeNetUrl(rawUrl){
        // Preserve the real path and all non-sensitive query parameters.
        // This avoids the old listener problem where canonicalization hid
        // parameters needed to reconstruct an actual request.
        return frostV29SanitizeNetUrl(rawUrl);
    }

    function frostV29CaptureTargetEndpoint(url){
        return ['USERNAME','DELETE ACCOUNT','CREATE ACCOUNT','USER TIMELINE']
            .includes(frostV29EndpointLabel(url));
    }

    function frostV29RedactCaptured(value,key=''){
        if(frostV29SensitiveKey(key))return '[REDACTED]';

        if(Array.isArray(value))return value.map(v=>frostV29RedactCaptured(v,''));

        if(value&&typeof value==='object'){
            const out={};
            for(const [k,v] of Object.entries(value)){
                out[k]=frostV29RedactCaptured(v,k);
            }
            return out;
        }

        return value;
    }

    function frostV29CaptureRequestHeaders(headers){
        const out={};
        if(!headers)return out;

        try{
            const h=new Headers(headers);
            h.forEach((v,k)=>{
                out[k]=frostV29RedactCaptured(v,k);
            });
        }catch(e){
            try{
                Object.entries(headers||{}).forEach(([k,v])=>{
                    out[k]=frostV29RedactCaptured(String(v??''),k);
                });
            }catch(_){}
        }

        return out;
    }

    function frostV29CaptureRequestBody(body){
        if(body===undefined||body===null)return null;

        try{
            if(typeof body==='string'){
                const trimmed=body.trim();
                if(!trimmed)return '';

                try{
                    return frostV29RedactCaptured(JSON.parse(trimmed));
                }catch(_){
                    return trimmed.length>16000
                        ? trimmed.slice(0,16000)+'… [truncated]'
                        : trimmed;
                }
            }

            if(body instanceof URLSearchParams){
                const obj={};
                for(const [k,v] of body.entries()){
                    obj[k]=frostV29RedactCaptured(v,k);
                }
                return obj;
            }

            if(typeof FormData!=='undefined'&&body instanceof FormData){
                const obj={};
                for(const [k,v] of body.entries()){
                    obj[k]=typeof v==='string'
                        ? frostV29RedactCaptured(v,k)
                        : `[${v?.constructor?.name||'Blob'}]`;
                }
                return obj;
            }

            if(typeof Blob!=='undefined'&&body instanceof Blob){
                return `[Blob ${body.type||'unknown'} · ${body.size} bytes]`;
            }

            if(typeof ArrayBuffer!=='undefined'&&body instanceof ArrayBuffer){
                return `[ArrayBuffer ${body.byteLength} bytes]`;
            }

            if(typeof body==='object'){
                return `[${body?.constructor?.name||'object'} body]`;
            }

            return String(body);
        }catch(e){
            return '[body capture failed]';
        }
    }

    function frostV29LimitResponseText(raw){
        const value=String(raw??'');
        return value.length>30000
            ? value.slice(0,30000)+'… [truncated]'
            : value;
    }

    function frostV29NetStateText(){
        if(!frostV29Net.active)return frostRemakeText('off');
        if(frostV29Net.paused)return frostRemakeText('paused');
        return frostRemakeText('listening');
    }

    function frostV29PushNet(entry){
        if(!frostV29Net.active||frostV29Net.paused)return;

        const normalized={
            id:++frostV29Net.seq,
            source:'PAGE',
            ...entry,
            url:frostV29NormalizeNetUrl(entry?.url||'')
        };

        normalized.endpoint=frostV29EndpointLabel(normalized.url);
        frostV29Net.totalSeen++;
        frostV29Net.entries.unshift(normalized);
        frostV29Net.entries=frostV29Net.entries.slice(
            0,
            Math.max(50,Math.min(2000,Number(frostV29Net.maxEntries)||300))
        );
        frostV29RenderNetListener();
    }

    async function frostV29ReadFetchTargetBody(input,init){
        if(init?.body!==undefined)return frostV29CaptureRequestBody(init.body);

        try{
            if(input instanceof Request){
                const clone=input.clone();
                const raw=await clone.text();
                return frostV29CaptureRequestBody(raw);
            }
        }catch(e){}

        return null;
    }

    function frostV29StartUrlListener(){
        if(frostV29Net.active){
            frostV29Net.paused=false;
            frostV29RenderNetListener();
            return;
        }

        frostV29Net.active=true;
        frostV29Net.paused=false;

        if(!frostV29Net.fetchOriginal)frostV29Net.fetchOriginal=window.fetch;
        const originalFetch=frostV29Net.fetchOriginal;

        window.fetch=async function(input,init){
            const method=String(init?.method||input?.method||'GET').toUpperCase();
            let rawUrl='';

            try{
                rawUrl=typeof input==='string'||input instanceof URL
                    ? String(input)
                    : input?.url||'';
            }catch(e){
                rawUrl='';
            }

            const url=frostV29NormalizeNetUrl(rawUrl);
            const target=frostV29CaptureTargetEndpoint(url);
            const source=init?.__frostGeneratedAccountRequest?'Nineytone':'PAGE';
            const requestHeaders=target
                ? frostV29CaptureRequestHeaders(init?.headers||(input instanceof Request?input.headers:null))
                : undefined;
            const requestBody=target
                ? await frostV29ReadFetchTargetBody(input,init)
                : undefined;

            const start=performance.now();

            try{
                const response=await originalFetch.apply(this,arguments);
                let responseText;

                if(target){
                    try{
                        responseText=frostV29LimitResponseText(await response.clone().text());
                    }catch(e){
                        responseText='[response unavailable]';
                    }
                }

                frostV29PushNet({
                    time:Date.now(),
                    kind:'fetch',
                    source,
                    method,
                    url,
                    status:response.status,
                    duration:Math.round(performance.now()-start),
                    ...(target?{
                        requestHeaders,
                        requestBody,
                        responseText
                    }:{})
                });

                return response;
            }catch(e){
                frostV29PushNet({
                    time:Date.now(),
                    kind:'fetch',
                    source,
                    method,
                    url,
                    status:'ERR',
                    duration:Math.round(performance.now()-start),
                    ...(target?{
                        requestHeaders,
                        requestBody,
                        responseText:`${e?.name||'Error'}: ${e?.message||String(e)}`
                    }:{})
                });
                throw e;
            }
        };

        if(!frostV29Net.xhrOpenOriginal)frostV29Net.xhrOpenOriginal=XMLHttpRequest.prototype.open;
        if(!frostV29Net.xhrSendOriginal)frostV29Net.xhrSendOriginal=XMLHttpRequest.prototype.send;
        if(!frostV29Net.xhrSetHeaderOriginal)frostV29Net.xhrSetHeaderOriginal=XMLHttpRequest.prototype.setRequestHeader;

        const openOriginal=frostV29Net.xhrOpenOriginal;
        const sendOriginal=frostV29Net.xhrSendOriginal;
        const setHeaderOriginal=frostV29Net.xhrSetHeaderOriginal;

        XMLHttpRequest.prototype.open=function(method,url){
            this.__f29Meta={
                method:String(method||'GET').toUpperCase(),
                url:frostV29NormalizeNetUrl(String(url)),
                requestHeaders:{},
                source:this.__frostGeneratedAccountRequest?'Nineytone':'PAGE'
            };
            return openOriginal.apply(this,arguments);
        };

        XMLHttpRequest.prototype.setRequestHeader=function(name,value){
            try{
                const meta=this.__f29Meta;
                if(meta&&frostV29CaptureTargetEndpoint(meta.url)){
                    const key=String(name||'');
                    meta.requestHeaders[key]=frostV29RedactCaptured(String(value??''),key);
                }
            }catch(e){}

            return setHeaderOriginal.apply(this,arguments);
        };

        XMLHttpRequest.prototype.send=function(body){
            const start=performance.now();
            const meta=this.__f29Meta||{
                method:'GET',
                url:'',
                requestHeaders:{},
                source:'PAGE'
            };
            const target=frostV29CaptureTargetEndpoint(meta.url);

            if(target)meta.requestBody=frostV29CaptureRequestBody(body);

            const done=()=>{
                let responseText;

                if(target){
                    try{
                        responseText=frostV29LimitResponseText(this.responseText||'');
                    }catch(e){
                        responseText='[response unavailable]';
                    }
                }

                frostV29PushNet({
                    time:Date.now(),
                    kind:'xhr',
                    source:meta.source||'PAGE',
                    method:meta.method,
                    url:meta.url,
                    status:this.status||'ERR',
                    duration:Math.round(performance.now()-start),
                    ...(target?{
                        requestHeaders:meta.requestHeaders||{},
                        requestBody:meta.requestBody??null,
                        responseText
                    }:{})
                });
            };

            this.addEventListener('loadend',done,{once:true});
            return sendOriginal.apply(this,arguments);
        };

        frostV29RenderNetListener();
    }

