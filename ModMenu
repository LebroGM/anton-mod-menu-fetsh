                    <span style="color:#6b7280; font-size:8px;">${match.preview}</span>
                </div>`;
            });
            if (varMatches.length > 10) {
                html += `<div style="color:#6b7280; font-size:8px; padding:2px 4px;">... and ${varMatches.length - 10} more</div>`;
            }
            html += `</div>`;
        }

        if (elementMatches.length === 0 && scriptMatches.length === 0 && varMatches.length === 0) {
            html += `<div style="padding:12px; text-align:center; color:#6b7280; font-size:10px;">No results found for "${query}"</div>`;
        }

        resultsContainer.innerHTML = html;
        resultsContainer.style.display = 'block';
        searchActive = true;
        showNotification(`🔍 Found ${elementMatches.length + scriptMatches.length + varMatches.length} results for "${query}"`, 'info');
    }

