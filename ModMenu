    function frostEnsureNoticeContainer() {
        frostInstallNotificationStyles();

        let box = document.getElementById('notificationContainer');
        if (!box) {
            box = document.createElement('div');
            box.id = 'notificationContainer';
            document.body.appendChild(box);
        }

        const settings = window.__frostUiSettings || {};
        box.classList.toggle('compact', !!settings.notificationCompact);

        try {
            if (typeof frostApplyNotificationPosition === 'function') {
                frostApplyNotificationPosition();
            }
        } catch (e) {
            box.dataset.position = settings.notificationPosition || 'bottom-right';
            box.style.right = '16px';
            box.style.bottom = '16px';
        }

        return box;
    }

    function frostNoticeProgress(card, remaining) {
        const bar = card.querySelector('.frost-notice-progress');
        if (!bar) return;

        const settings = window.__frostUiSettings || {};
        if (settings.notificationProgress === false) {
            bar.parentElement.style.display = 'none';
            return;
        }

        bar.parentElement.style.display = '';

        const timing = card.__frostNoticeTiming;
        const total = Math.max(1, timing?.duration || remaining || 1);
        const ratio = Math.max(0, Math.min(1, remaining / total));

        bar.style.transition = 'none';
        bar.style.width = `${ratio * 100}%`;

        requestAnimationFrame(() => requestAnimationFrame(() => {
            if (!card.isConnected || card.classList.contains('paused')) return;
            bar.style.transition = `width ${Math.max(0, remaining)}ms linear`;
            bar.style.width = '0%';
        }));
    }

    function frostScheduleNotice(card, remaining) {
        if (!card?.isConnected || !card.__frostNoticeTiming) return;

        const timing = card.__frostNoticeTiming;
        clearTimeout(timing.timer);

        timing.remaining = Math.max(0, remaining);
        timing.startedAt = performance.now();

        card.classList.remove('paused');
        frostNoticeProgress(card, timing.remaining);

        timing.timer = setTimeout(() => frostDismissNotice(card), timing.remaining);
    }

    function frostPauseNotice(card) {
        const settings = window.__frostUiSettings || {};
        if (settings.notificationPauseOnHover === false) return;

        const timing = card?.__frostNoticeTiming;
        if (!timing || card.classList.contains('closing')) return;

        const elapsed = performance.now() - timing.startedAt;
        timing.remaining = Math.max(120, timing.remaining - elapsed);
        clearTimeout(timing.timer);

        const bar = card.querySelector('.frost-notice-progress');
        if (bar) {
            bar.style.transition = 'none';
            bar.style.width = `${Math.max(0, Math.min(1, timing.remaining / timing.duration)) * 100}%`;
        }

        card.classList.add('paused');
    }

    function frostResumeNotice(card) {
        const settings = window.__frostUiSettings || {};
        if (settings.notificationPauseOnHover === false) return;
        if (!card?.__frostNoticeTiming || card.classList.contains('closing')) return;

        frostScheduleNotice(card, card.__frostNoticeTiming.remaining);
    }

    function frostDismissNotice(card, immediate = false) {
        if (!card || card.__frostNoticeDismissed) return;
        card.__frostNoticeDismissed = true;

        if (card.__frostNoticeTiming?.timer) {
            clearTimeout(card.__frostNoticeTiming.timer);
        }

        const key = card.dataset.noticeKey;
        if (key && frostNoticeLive.get(key) === card) {
            frostNoticeLive.delete(key);
        }

        if (immediate) {
            card.remove();
            return;
        }

        card.classList.remove('paused');
        card.classList.add('closing');
        setTimeout(() => card.remove(), 260);
    }

    function frostClearLiveNotifications() {
        document.querySelectorAll('#notificationContainer .frost-notice-card')
            .forEach(card => frostDismissNotice(card, true));
        frostNoticeLive.clear();
    }

    function showNotification(message, type = 'info') {
        const settings = window.__frostUiSettings || {};
        if (settings.notificationsEnabled === false) return null;

        const normalized = frostNoticeType(type);
        const meta = FROST_NOTICE_META[normalized];
        const text = String(message ?? '').trim() || 'Notification';
        const key = normalized + '|' + text;
        const now = Date.now();

        const box = frostEnsureNoticeContainer();
        const duration = Math.max(
            800,
            Math.min(20000, Number(settings.notificationDuration) || 3000)
        );

        const existing = frostNoticeLive.get(key);

        if (
            existing &&
            existing.isConnected &&
            now - Number(existing.dataset.lastShown || 0) < 1200
        ) {
            const count = Number(existing.dataset.repeatCount || 1) + 1;
            existing.dataset.repeatCount = String(count);
            existing.dataset.lastShown = String(now);
            existing.__frostNoticeDismissed = false;

            const badge = existing.querySelector('.frost-notice-repeat');
            if (badge) {
                badge.textContent = `×${count}`;
                badge.classList.add('on');
            }

            const time = existing.querySelector('.frost-notice-time');
            if (time) {
                time.textContent = new Date().toLocaleTimeString([], {
                    hour:'2-digit',
                    minute:'2-digit',
                    second:'2-digit'
                });
            }

            existing.__frostNoticeTiming.duration = duration;
            existing.__frostNoticeTiming.remaining = duration;
            frostScheduleNotice(existing, duration);

            existing.animate?.(
                [{transform:'scale(1)'},{transform:'scale(1.025)'},{transform:'scale(1)'}],
                {duration:200,easing:'ease-out'}
            );

            return existing;
        }

        const card = document.createElement('div');
        card.className = 'frost-notice-card';
        card.id = `frostNotice${++frostNoticeId}`;
        card.dataset.noticeKey = key;
        card.dataset.repeatCount = '1';
        card.dataset.lastShown = String(now);

        card.style.setProperty('--notice-color', meta.color);
        card.style.setProperty('--notice-glow', meta.glow);

        card.innerHTML = `
            <div class="frost-notice-content">
                <div class="frost-notice-icon">${meta.icon}</div>

