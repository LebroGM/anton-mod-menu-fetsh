    // ==========================================
    // DRAG VARIABLES
    // ==========================================
    let isDragging = false;
    let dragStartX, dragStartY, startLeft, startTop;
    let hasDragged = false;

    const header = document.getElementById('modMenuHeader');

    const frostTouchCapable =
        (navigator.maxTouchPoints || 0) > 0 ||
