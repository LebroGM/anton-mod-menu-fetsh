    // ==========================================
    // FINISH LEVEL - CURRENT STARTED LEVEL
    //
    // The website emits startLevel when a level begins. Nineytone remembers
    // exactly the current level identity fields requested for this restored
    // feature: `puid` and `level`.
    //
    // Pressing FINISH LEVEL builds only:
    //   { event:"finishLevel", puid:<start.puid>, level:<start.level>, score:<0..3> }
    //
    // No corrects/mistakes/type/block/round fields are invented here.
    // ==========================================
    function frostNormalizeFinishLevelActionScore(value) {
        const num = Number(value);
        if (!Number.isFinite(num) || num < 0 || num > 3) return null;
        return num;
    }

    function frostSetFinishLevelActionScore(value, notify = false) {
        const num = frostNormalizeFinishLevelActionScore(value);
        if (num === null) {
            if (notify) {
                showNotification('❌ Finish Level score must be between 0 and 3', 'error');
                playSound('error');
            }
            return false;
        }

        finishLevelActionScoreValue = num;
        const input = document.getElementById('finishLevelActionScoreInput');
        const current = document.getElementById('finishLevelActionScoreCurrent');
        if (input) input.value = String(num);
        if (current) current.textContent = String(num);
        return true;
    }

    function frostUpdateFinishLevelActionUi() {
        const status = document.getElementById('finishLevelActionCaptureStatus');
        const puid = document.getElementById('finishLevelActionCurrentPuid');
        const level = document.getElementById('finishLevelActionCurrentLevel');
        const current = document.getElementById('finishLevelActionScoreCurrent');

        if (current) current.textContent = String(finishLevelActionScoreValue);

        if (!finishLevelActionLastStart) {
            if (status) status.textContent = 'WAITING FOR startLevel';
            if (puid) puid.textContent = '—';
            if (level) level.textContent = '—';
            return;
        }

        if (status) status.textContent = 'CURRENT LEVEL CAPTURED';
        if (puid) puid.textContent = finishLevelActionLastStart.puid;
        if (level) level.textContent = finishLevelActionLastStart.level;
    }

    function frostCaptureFinishLevelStart(data) {
        if (
            !finishLevelStartTrackerEnabled ||
            !data ||
            data.event !== 'startLevel' ||
            typeof data.puid !== 'string' ||
            !data.puid ||
            typeof data.level !== 'string' ||
            !data.level
        ) {
            return false;
        }

        finishLevelActionLastStart = {
            puid: data.puid,
            level: data.level,
            capturedAt: new Date().toISOString()
        };

        console.log(
            `[FINISH LEVEL] Captured startLevel · puid=${data.puid} · level=${data.level}`
        );
        frostUpdateFinishLevelActionUi();
        return true;
    }

    function frostInstallFinishLevelStartTracker() {
        finishLevelStartTrackerEnabled = true;

        const attach = () => {
            if (
                typeof log === 'undefined' ||
                log === null ||
                typeof log.log !== 'function'
            ) {
                return false;
            }

            if (finishLevelStartTrackerWrapper && log.log === finishLevelStartTrackerWrapper) {
                return true;
            }

            const downstream = log.log.bind(log);
            finishLevelStartTrackerOriginalLogMethod = downstream;

            finishLevelStartTrackerWrapper = function(data) {
                try { frostCaptureFinishLevelStart(data); } catch (_) {}
                return downstream(data);
            };

            log.log = finishLevelStartTrackerWrapper;
            return true;
        };

        if (attach()) {
            if (finishLevelStartTrackerRetryTimer) {
                clearInterval(finishLevelStartTrackerRetryTimer);
                finishLevelStartTrackerRetryTimer = null;
            }
            return true;
        }

        if (!finishLevelStartTrackerRetryTimer) {
            finishLevelStartTrackerRetryTimer = setInterval(() => {
                if (!finishLevelStartTrackerEnabled) {
                    clearInterval(finishLevelStartTrackerRetryTimer);
                    finishLevelStartTrackerRetryTimer = null;
                    return;
                }
                if (attach()) {
                    clearInterval(finishLevelStartTrackerRetryTimer);
                    finishLevelStartTrackerRetryTimer = null;
                }
            }, 500);
        }

        return false;
    }

    function frostStopFinishLevelStartTracker() {
        finishLevelStartTrackerEnabled = false;

        if (finishLevelStartTrackerRetryTimer) {
            clearInterval(finishLevelStartTrackerRetryTimer);
            finishLevelStartTrackerRetryTimer = null;
        }

        try {
            if (
                typeof log !== 'undefined' &&
                log !== null &&
                finishLevelStartTrackerWrapper &&
                log.log === finishLevelStartTrackerWrapper &&
                typeof finishLevelStartTrackerOriginalLogMethod === 'function'
            ) {
                log.log = finishLevelStartTrackerOriginalLogMethod;
            }
        } catch (_) {}

        finishLevelStartTrackerWrapper = null;
        finishLevelStartTrackerOriginalLogMethod = null;
    }

    function frostBuildFinishLevelActionEvent(score) {
        const num = frostNormalizeFinishLevelActionScore(score);
        if (num === null || !finishLevelActionLastStart) return null;

        return {
            event: 'finishLevel',
            puid: finishLevelActionLastStart.puid,
            level: finishLevelActionLastStart.level,
            score: num
        };
    }

    function frostFinishCurrentLevel() {
        const input = document.getElementById('finishLevelActionScoreInput');
        const requested = input ? input.value : finishLevelActionScoreValue;

        if (!frostSetFinishLevelActionScore(requested, true)) {
            return false;
        }

        if (!finishLevelActionLastStart) {
            showNotification('❌ No startLevel captured yet. Start a level first.', 'error');
            playSound('error');
            return false;
        }

        if (
            typeof log === 'undefined' ||
            log === null ||
            typeof log.log !== 'function'
        ) {
            showNotification('❌ Finish Level failed: game logger not available', 'error');
            playSound('error');
            return false;
        }

        const payload = frostBuildFinishLevelActionEvent(finishLevelActionScoreValue);
        if (!payload) {
            showNotification('❌ Finish Level could not build the event', 'error');
            playSound('error');
            return false;
        }

        /*
         * This manual feature owns its own score input. If the separate
         * "Finish Level Custom & Full Score" wrapper is enabled, make it
         * transparent for this one synchronous send so it cannot replace
         * the score chosen here.
         */
        const scoreOverrideWasActive = finishLevelScoreOverrideActive;
        try {
            if (scoreOverrideWasActive) finishLevelScoreOverrideActive = false;
            log.log(payload);
        } catch (e) {
            console.error('[FINISH LEVEL] Send failed:', e);
            showNotification('❌ Finish Level event failed', 'error');
            playSound('error');
            return false;
        } finally {
            if (scoreOverrideWasActive) finishLevelScoreOverrideActive = true;
        }

        console.log('[FINISH LEVEL] Sent:', payload);
        showNotification(
            `🏁 Finish Level sent · score ${finishLevelActionScoreValue}`,
            'success'
        );
        playSound('success');
        return true;
    }

    // ==========================================
    // FINISH LEVEL CUSTOM & FULL SCORE
    //
    // Full score default = 3.
    // Custom values: any finite number from 0 through 3,
    // including decimals such as 0.1 and 2.5.
    //
    // Only full level-completion payloads are rewritten. This avoids
    // changing the simplified finishLevel events used by currency tools.
    // ==========================================
    let finishLevelScoreOverrideOriginalLogMethod = null;
    let finishLevelScoreOverrideWrapper = null;
    let finishLevelScoreOverrideInterceptCount = 0;

    function frostIsFullFinishLevelEvent(data) {
        return !!(
            data &&
            data.event === 'finishLevel' &&
            data.score !== undefined &&
            (
                data.puid !== undefined ||
                data.level !== undefined ||
                data.blockPuid !== undefined ||
                data.round !== undefined
            )
        );
    }

    function frostNormalizeFinishLevelScoreValue(value) {
        const num = Number(value);
        if (!Number.isFinite(num) || num < 0 || num > 3) return null;
        return num;
    }

    function frostSetFinishLevelScoreOverrideValue(value, notify = true) {
        const num = frostNormalizeFinishLevelScoreValue(value);

        if (num === null) {
            if (notify) {
                showNotification('❌ Score must be between 0 and 3', 'error');
                playSound('error');
            }
            return false;
        }

        finishLevelScoreOverrideValue = num;

        const input = document.getElementById('finishLevelScoreValueInput');
        const current = document.getElementById('finishLevelScoreCurrentValue');

        if (input) input.value = String(num);
        if (current) current.textContent = String(num);

        if (notify) {
            showNotification(`🎯 Finish Level score override = ${num}`, 'success');
            playSound('toggle');
        }

        return true;
    }

    function frostFinishLevelScoreTransform(data) {
        if (
            !finishLevelScoreOverrideActive ||
            !frostIsFullFinishLevelEvent(data)
        ) {
            return data;
        }

        const target = finishLevelScoreOverrideValue;

        try { data.score = target; } catch (_) {}

        if (data.score !== target) {
            return { ...data, score: target };
        }

        return data;
    }

    function toggleFinishLevelScoreOverride(enable) {
        finishLevelScoreOverrideActive = !!enable;

        if (finishLevelScoreOverrideActive) {
            const input = document.getElementById('finishLevelScoreValueInput');
            const requested = input ? input.value : finishLevelScoreOverrideValue;

            if (!frostSetFinishLevelScoreOverrideValue(requested, false)) {
                finishLevelScoreOverrideActive = false;
                showNotification('❌ Choose a score from 0 to 3 before enabling', 'error');
                playSound('error');
                return false;
            }

            if (
                typeof log === 'undefined' ||
                log === null ||
                typeof log.log !== 'function'
            ) {
                finishLevelScoreOverrideActive = false;
                showNotification('❌ Finish Level Custom & Full Score could not attach to log.log', 'error');
                playSound('error');
                return false;
            }

            const downstream = log.log.bind(log);
            finishLevelScoreOverrideOriginalLogMethod = downstream;

            finishLevelScoreOverrideWrapper = function(data) {
                const matched = !!(
                    frostIsFullFinishLevelEvent(data) &&
                    data.score !== finishLevelScoreOverrideValue
                );

                const before = matched ? data.score : null;
                const outgoing = frostFinishLevelScoreTransform(data);

                if (matched) {
                    finishLevelScoreOverrideInterceptCount++;
                    console.log(
                        `[FINISH LEVEL CUSTOM & FULL SCORE] finishLevel score: ${before} → ` +
                        `${finishLevelScoreOverrideValue} ` +
                        `(Changed: ${finishLevelScoreOverrideInterceptCount})`
                    );
                    showNotification(
                        `🎯 finishLevel score ${before} → ${finishLevelScoreOverrideValue} ` +
                        `(${finishLevelScoreOverrideInterceptCount})`,
                        'success'
                    );
                }

                return downstream(outgoing);
            };

            log.log = finishLevelScoreOverrideWrapper;

            const toggle = document.getElementById('finishLevelScoreOverrideToggle');
            const label = document.getElementById('finishLevelScoreOverrideLabel');
            toggle?.classList.add('active');
            if (label) {
                label.textContent = 'ON';
                label.classList.add('active');
            }

            showNotification(
                `🎯 Finish Level Custom & Full Score activated · ${finishLevelScoreOverrideValue}`,
                'success'
            );
            playSound('toggle');
            return true;
        }

        try {
            if (
                typeof log !== 'undefined' &&
                log !== null &&
                finishLevelScoreOverrideWrapper &&
                log.log === finishLevelScoreOverrideWrapper &&
                typeof finishLevelScoreOverrideOriginalLogMethod === 'function'
            ) {
                log.log = finishLevelScoreOverrideOriginalLogMethod;
                finishLevelScoreOverrideWrapper = null;
                finishLevelScoreOverrideOriginalLogMethod = null;
            }
        } catch (_) {}

        finishLevelScoreOverrideInterceptCount = 0;

        const toggle = document.getElementById('finishLevelScoreOverrideToggle');
        const label = document.getElementById('finishLevelScoreOverrideLabel');
        toggle?.classList.remove('active');
        if (label) {
            label.textContent = 'OFF';
            label.classList.remove('active');
        }

        showNotification('🎯 Finish Level Custom & Full Score deactivated', 'info');
        playSound('toggle');
        return true;
    }

    function toggleFinishLevelScoreOverrideHandler() {
        return toggleFinishLevelScoreOverride(!finishLevelScoreOverrideActive);
    }

