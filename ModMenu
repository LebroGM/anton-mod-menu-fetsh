    function frostV28EnsurePanel(section) {
        const content = document.getElementById('modMenuContent');
        if (!content) return null;
        let panel = content.querySelector(`.section-panel[data-section="${section}"]`);
        if (!panel) {
            panel = document.createElement('div');
            panel.className = 'section-panel';
            panel.dataset.section = section;
            const destroyPanel = content.querySelector('.section-panel[data-section="destroy"]');
            if (destroyPanel) content.insertBefore(panel, destroyPanel);
            else content.appendChild(panel);
        }
        panel.classList.add('frost-v28-panel');
        return panel;
    }

    function frostV28EnsureSidebarButton(section, icon, label) {
        const sidebar = document.getElementById('modMenuSidebar');
        if (!sidebar) return null;
        let btn = sidebar.querySelector(`[data-section="${section}"]`);
        if (!btn) {
            btn = document.createElement('button');
            btn.className = 'sidebar-item frost-v28-tab';
            btn.dataset.section = section;
            btn.innerHTML = `<span class="icon">${icon}</span><span class="label">${frostEscapeHtml(label)}</span>`;
            btn.addEventListener('click', () => {
                switchSection(section);
                animateSidebarItem(btn);
                playSound('switch');
            });
            sidebar.appendChild(btn);
        }
        return btn;
    }

    function frostV28ReorderSidebar() {
        const sidebar = document.getElementById('modMenuSidebar');
        if (!sidebar) return;

        frostV28EnsureSidebarButton('music','♫','Music');
        frostV28EnsureSidebarButton('config','⚙','Config');

        sidebar.querySelectorAll('.frost-sidebar-group').forEach(el => el.remove());

        const groups = [
            ['HOME',['general']],
            ['MODS',['currencies','level','games','account','support','avatar','sounds','session']],
            ['DEVELOPER',['autoclicker','eventlistener','apifetcher','console','searchevent','calculator','texture','website']],
            ['Nineytone',['jkeybinds','config','themes','effects','frostlab','customize','backgrounds','layout','audiostudio','music','tools','notes','clipboard','inspector','performance','favorites','activitylog','profiles','importexport','accessibility','commandpalette','notifications','changelog','credits','help']],
            ['SYSTEM',['destroy']]
        ];

        groups.forEach(([groupKey, sections]) => {
            if (groupKey !== 'HOME') {
                const label = document.createElement('div');
                label.className = 'frost-sidebar-group';
                label.dataset.frostGroupKey = groupKey;
                label.textContent = groupKey;
                sidebar.appendChild(label);
            }
