    function frostV29ExecuteUiCommand(raw){
        const cmd=String(raw||'').trim();
        if(!cmd)return false;
        if(cmd.startsWith('open:')){
            const section=cmd.slice(5).trim();
            if(document.querySelector(`#modMenuSidebar .sidebar-item[data-section="${CSS.escape(section)}"]`)){switchSection(section);return true}
            return false;
        }
        if(!FROST_V29_SAFE_MACRO_COMMANDS.has(cmd))return false;
        const [type,value]=cmd.split(':');
        if(type==='theme')applyTheme(value==='white'?'standard':value);
        if(type==='snow'){frostUiSettings.snowEnabled=value==='on';frostSaveUiSettings();initSnowEffect();frostSyncControls?.()}
        if(type==='hud')frostV29SetHud(value==='on');
        if(type==='mini')frostV29SetMiniMode(value==='on');
        if(type==='privacy')frostV29SetPrivacy(value==='on');
        if(type==='screenshot')frostV29SetScreenshot(value==='on');
        if(type==='website'&&typeof frostV27ApplyWebsiteStyle==='function')frostV27ApplyWebsiteStyle(value);
        if(type==='music'&&value==='pause')frostV28MusicAudio.pause();
        if(type==='music'&&value==='play')frostV28MusicAudio.play().catch(()=>{});
        frostV29RenderStatusCenter();
        return true;
    }
    function frostV29RunMacro(index){
        const m=frostV29.macros[index];if(!m)return;
        const cmds=String(m.commands||'').split(';').map(x=>x.trim()).filter(Boolean);
        let done=0,bad=[];
        cmds.forEach(c=>frostV29ExecuteUiCommand(c)?done++:bad.push(c));
        showNotification(`${m.name}: ${done} UI command${done===1?'':'s'} run${bad.length?` · skipped ${bad.length}`:''}`,bad.length?'warning':'success');
    }
