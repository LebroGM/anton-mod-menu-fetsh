    async function frostV29ManualRequest(){
        const out=document.getElementById('f29ApiOutput');
        const meta=document.getElementById('f29ApiMeta');
        const responseHeaders=document.getElementById('f29ApiHeaders');

        const method=(document.getElementById('f29ApiMethod')?.value||'GET').toUpperCase();
        const url=frostV29SafeUrl(document.getElementById('f29ApiUrl')?.value||'');
        const credentials=document.getElementById('f29ApiCredentials')?.value||'omit';
        const contentType=document.getElementById('f29ApiContentType')?.value||'none';
        const bodyRaw=document.getElementById('f29ApiBody')?.value||'';
        const timeout=Math.max(
            500,
            Math.min(30000,Number(document.getElementById('f29ApiTimeout')?.value)||8000)
        );

        if(!url){
            if(out)out.textContent='Enter a valid http/https URL.';
            return;
        }

        const controller=new AbortController();
        const timer=setTimeout(()=>controller.abort(),timeout);
        const start=performance.now();

        try{
            const options={
                method,
                credentials,
                cache:'no-store',
                redirect:'follow',
                signal:controller.signal,
                headers:{}
            };

            if(method!=='GET'&&method!=='HEAD'&&bodyRaw!==''){
                if(contentType==='json'){
                    JSON.parse(bodyRaw);
                    options.headers['Content-Type']='application/json';
                    options.body=bodyRaw;
                }else if(contentType==='text'){
                    options.headers['Content-Type']='text/plain;charset=UTF-8';
                    options.body=bodyRaw;
                }else if(contentType==='form'){
                    options.headers['Content-Type']='application/x-www-form-urlencoded;charset=UTF-8';
                    options.body=bodyRaw;
                }else{
                    options.body=bodyRaw;
                }
            }

            const runner=frostV29Net.fetchOriginal||window.fetch;
            const response=await runner(url,options);
            const ms=Math.round(performance.now()-start);

            let body='';
            if(method!=='HEAD'){
                body=await response.text();
                if(body.length>150000)body=body.slice(0,150000)+'\n… [preview truncated at 150 KB]';
                try{body=JSON.stringify(JSON.parse(body),null,2)}catch(_){}
            }

            if(meta)meta.textContent=`${response.status} ${response.statusText} · ${ms}ms · ${response.type}`;
            if(out)out.textContent=body||'(no response body)';
            if(responseHeaders){
                responseHeaders.textContent=[...response.headers.entries()]
                    .map(([k,v])=>`${k}: ${v}`)
                    .join('\n')||'(no readable response headers)';
            }

            frostV29ApiHistory.unshift({
                time:Date.now(),
                method,
                url,
                status:response.status,
                duration:ms,
                credentials,
                contentType,
                body:bodyRaw.slice(0,12000)
            });
            frostV29ApiHistory=frostV29ApiHistory.slice(0,40);
            frostWriteJson(FROST_V29_API_HISTORY,frostV29ApiHistory);
            frostV29RenderApiHistory();
        }catch(e){
            const ms=Math.round(performance.now()-start);
            if(meta)meta.textContent=`REQUEST FAILED · ${ms}ms`;
            if(out){
                out.textContent=e.name==='AbortError'
                    ? 'Request timed out.'
                    : `${e.name}: ${e.message}\n\nThe browser may have blocked the request because of CORS or the endpoint rejected the request.`;
            }
        }finally{
            clearTimeout(timer);
        }
    }

