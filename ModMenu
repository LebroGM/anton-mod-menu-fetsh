                frostV29PushEvent({time:Date.now(),type,target:frostV29SafeTarget(e.target),meta:frostV29EventMeta(e)});
            };
            frostV29EventMonitor.handlers.set(type,fn);
            document.addEventListener(type,fn,true);
        });
        frostV29RenderEventMonitor();
    }
    function frostV29StopEventMonitor(){
        frostV29EventMonitor.handlers.forEach((fn,type)=>document.removeEventListener(type,fn,true));
        frostV29EventMonitor.handlers.clear();frostV29EventMonitor.active=false;frostV29EventMonitor.paused=false;frostV29RenderEventMonitor();
    }

