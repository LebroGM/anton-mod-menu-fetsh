        function cleanText(value) {
            return String(value || '').replace(/\s+/g, ' ').trim();
        }

        function panelName(section) {
            const btn = document.querySelector(`#modMenuSidebar .sidebar-item[data-section="${section}"] .label`);
            return cleanText(btn?.textContent || frostV28NavLabel(section) || section);
        }

        function closestSearchTarget(el) {
            if (!el) return null;
            return el.closest(
                '.frost-v27-row,.frost-control-row,.panel-item,.keybind-row,.frost-list-item,.frost-setting-card,.frost-tool-card,.frost-v27-card'
            ) || el;
        }

        function buildFeatureIndex() {
            const features = [];
            const seen = new Set();

            const add = (section, element, title, keywords='', description='') => {
                if (!element || !element.isConnected) return;

                const target = closestSearchTarget(element);
                const tab = panelName(section);
                const targetText = cleanText(target?.textContent);
                const titleText = cleanText(title) || targetText || tab;
                const allKeywords = cleanText(`${keywords} ${titleText} ${tab} ${targetText}`).toLowerCase();
                const key = `${section}|${titleText.toLowerCase()}|${targetText.toLowerCase().slice(0,100)}`;

                if (seen.has(key)) return;
                seen.add(key);

                features.push({
                    section,
                    tab,
                    title: titleText,
                    keywords: allKeywords,
                    description: cleanText(description || targetText).slice(0,145),
                    element: target
                });
            };

            // Curated high-quality names for important controls.
            curated.forEach(([section, selector, title, keywords]) => {
                const el = document.querySelector(`.section-panel[data-section="${section}"] ${selector}`);
                if (el) add(section, el, title, keywords);
            });

            // Automatically index the rest of the actual FEATURES, not whole tabs.
            document.querySelectorAll('.section-panel[data-section]').forEach(panel => {
                const section = panel.dataset.section;
                const tab = panelName(section);

                panel.querySelectorAll(
                    '.frost-v27-row,.frost-control-row,.panel-item,.keybind-row,.frost-list-item,.frost-tool-card'
                ).forEach(row => {
                    if (!row.querySelector('button,input,select,textarea,.toggle,.frost-switch')) return;

                    const card = row.closest('.frost-v27-card,.frost-setting-card,.frost-safe-card,.frost-tool-card');
                    const cardTitle = cleanText(
                        card?.querySelector('h3,.frost-v28-card-title,.frost-subtitle')?.textContent
                    );
                    const rowLabel = cleanText(
                        row.querySelector(':scope > label,:scope > .label,.keybind-copy strong')?.textContent
                    );
                    const buttons = [...row.querySelectorAll('button')]
                        .map(btn => cleanText(btn.textContent))
                        .filter(text => text && text !== '×')
                        .slice(0,4);

                    let title = '';
                    if (rowLabel && cardTitle && !cardTitle.toLowerCase().includes(rowLabel.toLowerCase())) {
                        title = `${cardTitle} — ${rowLabel}`;
                    } else if (rowLabel) {
                        title = rowLabel;
                    } else if (cardTitle && buttons.length) {
                        title = `${cardTitle} — ${buttons.join(' / ')}`;
                    } else if (buttons.length) {
                        title = buttons.join(' / ');
                    } else {
                        title = cleanText(row.textContent).slice(0,65);
                    }

                    if (title) add(section, row, title, `${tab} ${row.textContent}`);
                });
            });

            return features;
        }

        function rankFeature(feature, query) {
            const q = query.toLowerCase();
            const tokens = q.split(/\s+/).filter(Boolean);
            const title = feature.title.toLowerCase();
            const tab = feature.tab.toLowerCase();
            const hay = feature.keywords;

            if (!tokens.every(token => hay.includes(token))) return -1;

            let score = 0;
            if (title === q) score += 300;
            if (title.startsWith(q)) score += 180;
            if (title.includes(q)) score += 120;
            if (tab.includes(q)) score += 25;
            tokens.forEach(token => {
                if (title.startsWith(token)) score += 35;
                else if (title.includes(token)) score += 20;
                if (hay.includes(token)) score += 8;
            });
            return score;
        }

        function closeResults(clearInput=false) {
            results.classList.remove('open');
            results.innerHTML = '';
            if (clearInput) input.value = '';
        }

        function openFeature(feature) {
            if (!feature) return;

            switchSection(feature.section);
            closeResults(true);

            requestAnimationFrame(() => {
                setTimeout(() => {
                    const target = feature.element?.isConnected ? feature.element : null;
                    if (!target) return;

                    try {
                        target.scrollIntoView({behavior:'smooth', block:'center', inline:'nearest'});
                    } catch (e) {
                        target.scrollIntoView();
                    }

                    target.classList.remove('frost-feature-search-hit');
                    void target.offsetWidth;
                    target.classList.add('frost-feature-search-hit');
                    setTimeout(() => target.classList.remove('frost-feature-search-hit'), 1100);
                }, 40);
            });
        }

        const runSearch = () => {
            if (isMinimized) {
                closeResults(false);
                return;
            }

            const q = input.value.trim().toLowerCase();
            if (!q) {
                closeResults(false);
                return;
            }

            const features = buildFeatureIndex()
                .map(feature => ({feature, score: rankFeature(feature, q)}))
                .filter(row => row.score >= 0)
                .sort((a,b) => b.score - a.score)
                .slice(0,20)
                .map(row => row.feature);

            if (!features.length) {
                results.innerHTML = '<div class="frost-muted" style="padding:9px">No matching features.</div>';
                results.classList.add('open');
                return;
            }

            results.innerHTML = features.map((feature,index) => `
                <button class="frost-search-result" data-feature-index="${index}">
                    <span class="frost-search-title">
                        <span>›</span>
                        <span>${frostEscapeHtml(feature.title)}</span>
                        <span class="frost-search-tab">${frostEscapeHtml(feature.tab)}</span>
                    </span>
                    <small>${frostEscapeHtml(feature.description || 'Open feature')}</small>
                </button>
            `).join('');

            results.classList.add('open');

            results.querySelectorAll('[data-feature-index]').forEach(btn => {
                btn.addEventListener('click', () => {
                    openFeature(features[Number(btn.dataset.featureIndex)]);
                });
            });
        };

        input.addEventListener('input', runSearch);
        input.addEventListener('focus', () => {
            if (input.value.trim()) runSearch();
        });
        input.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                closeResults(true);
                input.blur();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                results.querySelector('[data-feature-index]')?.click();
            }
        });

        document.addEventListener('mousedown', e => {
            if (!wrap.contains(e.target)) closeResults(false);
        });

        if (isMinimized) wrap.style.display = 'none';
    }

    function frostV28InstallFpsCounter() {
        if (document.getElementById('frostHeaderFps')) return;
        const close = document.getElementById('modMenuClose');
        if (!close) return;

        const fps = document.createElement('span');
        fps.id = 'frostHeaderFps';
        fps.textContent = 'FPS --';
        close.insertAdjacentElement('beforebegin', fps);

        let frames = 0;
        let last = performance.now();

        const tick = now => {
            if (!document.getElementById('modMenuContainer')) return;
            frames++;
            if (now - last >= 650) {
                const value = Math.round(frames * 1000 / (now - last));
                fps.textContent = `FPS ${value}`;
                frames = 0;
                last = now;
            }
            requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    }

