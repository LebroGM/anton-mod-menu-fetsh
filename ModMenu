    function frostGetBasicLogObject() {
        try {
            if (typeof log !== 'undefined' && log && typeof log.log === 'function') {
                return log;
            }
        } catch (_) {}

        try {
            if (globalThis.log && typeof globalThis.log.log === 'function') {
                return globalThis.log;
            }
        } catch (_) {}

        return null;
    }

    function frostDebugCoinsSafeSnapshot(data) {
        const out = { event: 'debugCoins' };

        [
            'adjustBy',
            'coinsBefore',
            'coinsAfter',
            'numFilteredAdjust',
            'snapshotDate',
            'coinChecksum'
        ].forEach(key => {
            if (Object.prototype.hasOwnProperty.call(data, key)) {
                out[key] = data[key];
