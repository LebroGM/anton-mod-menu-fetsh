    function animateClick(element) {
        if (!element) return;
        element.classList.remove('clicked', 'pop');
        void element.offsetWidth;
        element.classList.add('clicked');
        setTimeout(() => {
            element.classList.remove('clicked');
        }, 300);
    }

    function animateToggle(element) {
        if (!element) return;
        element.classList.add('toggle-bounce');
        setTimeout(() => {
            element.classList.remove('toggle-bounce');
        }, 400);
    }

    function animateSidebarItem(element) {
        if (!element) return;
