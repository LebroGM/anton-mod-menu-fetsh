    function frostAntonCategory(eventName){
        const n=String(eventName||'').toLowerCase();

        if(n.includes('coin'))return 'coins';
        if(n.includes('support'))return 'support';
        if(n.includes('game')||n.includes('astro')||n.includes('snowball')||n.includes('broadjump')||n.includes('jump'))return 'games';
        if(n.includes('group'))return 'group';
        if(n.includes('avatar')||n.includes('cosmetic'))return 'avatar';
        if(n.includes('session'))return 'session';
        if(n.includes('star'))return 'stars';
        if(n.includes('level')||n.includes('block')||n.includes('topic')||n.includes('plan'))return 'level';
        if(n.includes('sound')||n.includes('audio'))return 'sound';
        if(n.includes('name')||n.includes('nickname'))return 'name';

        return 'other';
    }

    function frostAntonSafeClone(value){
