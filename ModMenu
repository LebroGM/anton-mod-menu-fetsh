            ) {
                antonPlusUnlockGamesActive = false;
                showNotification('❌ Unlock Games could not attach to log.log', 'error');
                playSound('error');
                return false;
            }

            const downstream = log.log.bind(log);
            antonPlusUnlockGamesOriginalLogMethod = downstream;

            antonPlusUnlockGamesWrapper = function(data, ...rest) {
                if (frostAntonPlusUnlockGamesShouldBlock(data)) {
                    frostAntonPlusUnlockGamesRecordBlocked(data);

                    // Critical behavior: DO NOT call downstream().
                    // Returning here prevents the stop-game event from
                    // reaching the website's original log.log handler.
                    return undefined;
                }

                return downstream(data, ...rest);
            };

            log.log = antonPlusUnlockGamesWrapper;

