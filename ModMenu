                <code>Ctrl + Shift + S</code> stops it. Press <code>Esc</code> to cancel PICK mode.
                TEST ONCE does not change the running action counter.
            </div>
        `;

        function parseFiniteInput(id, label, {min=null,max=null,integer=false,emptyAllowed=false}={}) {
            const el = document.getElementById(id);
            const raw = String(el?.value ?? '').trim();

            if (!raw && emptyAllowed) return null;
            if (!raw) throw new Error(`${label} is required`);

            const num = Number(raw);
            if (!Number.isFinite(num)) throw new Error(`${label} must be a finite number`);
            if (integer && !Number.isInteger(num)) throw new Error(`${label} must be a whole number`);
            if (min !== null && num < min) throw new Error(`${label} must be at least ${min}`);
            if (max !== null && num > max) throw new Error(`${label} must be at most ${max}`);

            return num;
        }

        function readConfig() {
            const mode = document.getElementById('autoClickerMode')?.value || 'selector';

            const delay = parseFiniteInput(
                'autoClickerDelayInput',
                'Interval',
                {min:10,max:60000,integer:true}
            );

            const max = parseFiniteInput(
                'autoClickerMaxClicks',
                'Max actions',
                {min:0,max:1000000,integer:true}
            );

            const cfg = {
                mode,
                delay,
                max,
                selector:(document.getElementById('autoClickerSelector')?.value || '').trim(),
                x:null,
                y:null,
                mouseButton:document.getElementById('autoClickerMouseButton')?.value || 'left',
                key:frostV27NormalizeAutoKey(
                    document.getElementById('autoClickerKeyInput')?.value || 'Space'
                )
            };

            if (mode === 'selector') {
                if (!cfg.selector) throw new Error('Enter or pick a CSS selector');

                let target;
                try {
                    target = document.querySelector(cfg.selector);
                } catch (_) {
                    throw new Error('Selector is not valid CSS');
                }

                if (!target) throw new Error('No element matches that selector');
                if (target.closest?.('#modMenuContainer')) {
                    throw new Error('Nineytone controls cannot be auto-clicked');
                }
            }

            if (mode === 'mouse') {
                cfg.x = parseFiniteInput('autoClickerXPos','X coordinate');
                cfg.y = parseFiniteInput('autoClickerYPos','Y coordinate');

                if (
                    cfg.x < 0 ||
                    cfg.y < 0 ||
                    cfg.x >= window.innerWidth ||
                    cfg.y >= window.innerHeight
                ) {
                    throw new Error('Coordinates must be inside the visible browser viewport');
                }

                const target = document.elementFromPoint(cfg.x,cfg.y);
                if (!target) throw new Error('No element exists at those coordinates');
                if (target.closest?.('#modMenuContainer')) {
                    throw new Error('Coordinates point inside Nineytone');
                }
            }

            return cfg;
        }

        function updateModeVisibility() {
            const mode = document.getElementById('autoClickerMode')?.value || 'selector';
            const selectorRow = document.getElementById('autoClickerSelectorRow');
            const posRow = document.getElementById('autoClickerPosRow');
            const keyRow = document.getElementById('autoClickerKeyRow');

            if (selectorRow) selectorRow.style.display = mode === 'selector' ? 'flex' : 'none';
            if (posRow) posRow.style.display = mode === 'mouse' ? 'flex' : 'none';
            if (keyRow) keyRow.style.display = mode === 'keyboard' ? 'flex' : 'none';
        }

        function updateAutoUi(message=null) {
            const status = document.getElementById('autoClickerStatus');
            const startBtn = document.getElementById('autoClickerStartBtn');
            const stopBtn = document.getElementById('autoClickerStopBtn');
            const counter = document.getElementById('autoClickerCounter');

            if (status) {
                status.textContent = message || (isAutoClickerActive ? 'RUNNING' : 'IDLE');
                status.classList.toggle('running', isAutoClickerActive);
            }

            if (startBtn) startBtn.disabled = isAutoClickerActive;
            if (stopBtn) stopBtn.disabled = !isAutoClickerActive;
            if (counter) counter.textContent = String(autoClickerCurrentClicks);
        }

        function resolveActionTarget(cfg) {
            if (cfg.mode === 'selector') {
                let target;
                try {
                    target = document.querySelector(cfg.selector);
                } catch (_) {
                    throw new Error('Selector is not valid CSS');
                }

                if (!target) throw new Error('Target element is no longer available');
                if (target.closest?.('#modMenuContainer')) {
                    throw new Error('Nineytone controls cannot be auto-clicked');
                }

                return target;
            }

            if (cfg.mode === 'mouse') {
                const target = document.elementFromPoint(cfg.x,cfg.y);

                if (!target) throw new Error('No element exists at the configured coordinates');
                if (target.closest?.('#modMenuContainer')) {
                    throw new Error('Coordinates now point inside Nineytone');
                }

                return target;
            }

            const active = document.activeElement;
            if (
                active &&
                active !== document.body &&
                !active.closest?.('#modMenuContainer')
            ) {
                return active;
            }

            return document.body || document;
        }

        function performOnce({showErrors=true,countAction=true,config=null}={}) {
            let cfg;

            try {
                cfg = config || readConfig();

                if (cfg.mode === 'selector') {
                    const target = resolveActionTarget(cfg);
                    frostV27DispatchPointerClick(target, null, null, 'left');

                    const info = document.getElementById('autoClickerTargetInfo');
                    if (info) info.textContent = `${frostV27AutoTargetLabel(target)} · selector click`;

                } else if (cfg.mode === 'mouse') {
                    const target = resolveActionTarget(cfg);
                    frostV27DispatchPointerClick(target, cfg.x, cfg.y, cfg.mouseButton);

                    const info = document.getElementById('autoClickerTargetInfo');
                    if (info) {
                        info.textContent =
                            `${frostV27AutoTargetLabel(target)}\n` +
                            `coordinates: ${cfg.x}, ${cfg.y} · ${cfg.mouseButton} click`;
                    }

                } else if (cfg.mode === 'keyboard') {
                    const target = resolveActionTarget(cfg);
                    frostV27DispatchKeyboard(target, cfg.key);

                    const info = document.getElementById('autoClickerTargetInfo');
                    if (info) {
                        info.textContent =
                            `Keyboard: ${cfg.key.label}\n` +
                            `target: ${frostV27AutoTargetLabel(target)}`;
                    }
                } else {
                    throw new Error('Unknown Auto Clicker mode');
                }

                if (countAction) {
                    autoClickerCurrentClicks++;
                    updateAutoUi();
                }

                return true;

            } catch (err) {
                if (showErrors) {
                    showNotification(err.message || 'Auto Clicker action failed','warning');
                    playSound('error');
                }
                return false;
            }
        }

        function scheduleNext() {
            if (!isAutoClickerActive || !frostV27AutoRunConfig) return;

            const cfg = frostV27AutoRunConfig;

            if (
                cfg.max > 0 &&
                autoClickerCurrentClicks >= cfg.max
            ) {
                window.frostV27StopAutoClicker(false);
                showNotification(
                    `Auto Clicker finished after ${autoClickerCurrentClicks} actions`,
                    'info'
                );
                return;
            }

            const ok = performOnce({
                showErrors:false,
                countAction:true,
                config:cfg
            });

            if (!ok) {
                window.frostV27StopAutoClicker(false);
                showNotification(
                    'Auto Clicker stopped: target is unavailable or invalid',
                    'warning'
                );
                return;
            }

            if (
                cfg.max > 0 &&
                autoClickerCurrentClicks >= cfg.max
            ) {
                window.frostV27StopAutoClicker(false);
                showNotification(
                    `Auto Clicker finished after ${autoClickerCurrentClicks} actions`,
                    'info'
                );
                return;
            }

            autoClickerInterval = setTimeout(scheduleNext, cfg.delay);
        }

        window.frostV27StartAutoClicker = function() {
            if (isAutoClickerActive) {
                showNotification('Auto Clicker is already running','warning');
                return false;
            }

            let cfg;
            try {
                cfg = readConfig();
            } catch (err) {
                showNotification(err.message || 'Invalid Auto Clicker settings','warning');
                playSound('error');
                return false;
            }

            frostV27CancelAutoPicker(false);

            if (autoClickerInterval) {
                clearTimeout(autoClickerInterval);
                clearInterval(autoClickerInterval);
                autoClickerInterval = null;
            }

            frostV27AutoRunConfig = cfg;
            autoClickerCurrentClicks = 0;
            isAutoClickerActive = true;

            updateAutoUi('RUNNING');

            const modeText =
                cfg.mode === 'selector'
                    ? cfg.selector
                    : cfg.mode === 'mouse'
                        ? `${cfg.x}, ${cfg.y} · ${cfg.mouseButton}`
                        : cfg.key.label;

            showNotification(
                `Auto Clicker started · ${cfg.mode}: ${modeText} · ${cfg.delay} ms`,
                'success'
            );
            playSound('toggle');

            // Execute immediately; subsequent actions use the configured delay.
            scheduleNext();
            return true;
        };

        window.frostV27StopAutoClicker = function(notify=true) {
            if (autoClickerInterval) {
                clearTimeout(autoClickerInterval);
                clearInterval(autoClickerInterval);
                autoClickerInterval = null;
            }

            const wasRunning = isAutoClickerActive;

            isAutoClickerActive = false;
            frostV27AutoRunConfig = null;
            updateAutoUi('IDLE');

            if (notify && wasRunning) {
                showNotification('Auto Clicker stopped','info');
                playSound('click');
            }

            return true;
        };

        startAutoClicker = window.frostV27StartAutoClicker;
        stopAutoClicker = window.frostV27StopAutoClicker;

        toggleAutoClicker = function() {
            return isAutoClickerActive
                ? stopAutoClicker()
                : startAutoClicker();
        };

        resetAutoClickerCounter = function() {
            autoClickerCurrentClicks = 0;
            updateAutoUi();
            showNotification('Auto Clicker counter reset','info');
            playSound('click');
        };

        document.getElementById('autoClickerMode')?.addEventListener('change', () => {
            updateModeVisibility();
            playSound('switch');
        });

        document.getElementById('autoClickerStartBtn')?.addEventListener(
            'click',
            startAutoClicker
        );

        document.getElementById('autoClickerStopBtn')?.addEventListener(
            'click',
            stopAutoClicker
        );

        document.getElementById('autoClickerTestBtn')?.addEventListener('click', () => {
            const ok = performOnce({
                showErrors:true,
                countAction:false
            });

            if (ok) {
                showNotification('Auto Clicker test action sent','success');
            }
        });

        document.getElementById('autoClickerResetBtn')?.addEventListener(
            'click',
            resetAutoClickerCounter
        );

        document.getElementById('autoClickerPickBtn')?.addEventListener('click', () => {
            frostV27AutoPickerArmed = true;

            const info = document.getElementById('autoClickerTargetInfo');
            if (info) {
                info.textContent =
                    'PICK MODE: click an element outside Nineytone.\n' +
                    'Press Esc to cancel.';
            }

            showNotification(
                'Pick an element outside Nineytone · Esc cancels',
                'info'
            );
        });

        updateModeVisibility();
        updateAutoUi();
    }

    function frostV27EventTarget(el) {
        if (!(el instanceof Element)) return 'document';
        let out=el.tagName.toLowerCase();
        if(el.id) out+='#'+el.id;
        else if(el.classList.length) out+='.'+[...el.classList].slice(0,2).join('.');
        return out;
    }

    function frostV27RenderEvents() {
        const list=document.getElementById('eventList');
        const count=document.getElementById('eventCount');
        if(count) count.textContent=`${frostV27Events.length} events`;
        if(!list) return;
        if(!frostV27Events.length){
            list.innerHTML='<div class="frost-v27-display">No page events captured yet.</div>';
            return;
        }
        list.innerHTML=frostV27Events.map(ev=>`
            <div class="frost-v27-event">
                <small>${frostV27Escape(ev.time)}</small>
                <code>${frostV27Escape(ev.type)}</code>
                <span>${frostV27Escape(ev.target)}${ev.detail ? ' · '+frostV27Escape(ev.detail) : ''}</span>
            </div>`).join('');
    }

    function frostV27StopEventMonitor() {
        frostV27EventHandlers.forEach(({type,handler})=>document.removeEventListener(type,handler,true));
        frostV27EventHandlers=[];
        frostV27EventActive=false;
        const status=document.getElementById('eventListenerLabel');
        if(status){status.textContent='OFF';status.classList.remove('active');}
        const toggle=document.getElementById('eventListenerToggle');
        if(toggle)toggle.classList.remove('active');
    }

    function frostV27StartEventMonitor() {
        if(frostV27EventActive) return;
        frostV27EventActive=true;
        const types=Object.keys(frostV27EventFilters);
        types.forEach(type=>{
            const handler=e=>{
                if(!frostV27EventActive || !frostV27EventFilters[type]) return;
                if(e.target?.closest?.('#modMenuContainer')) return;
                let detail='';
                if(type==='keydown') detail=`key=${e.key}`;
                if((type==='input'||type==='change') && e.target instanceof HTMLInputElement) detail=`input[type=${e.target.type || 'text'}]`;
                frostV27Events.unshift({time:new Date().toLocaleTimeString(),type,target:frostV27EventTarget(e.target),detail});
                frostV27Events=frostV27Events.slice(0,250);
                frostV27RenderEvents();
            };
            document.addEventListener(type,handler,true);
            frostV27EventHandlers.push({type,handler});
        });
        const status=document.getElementById('eventListenerLabel');
        if(status){status.textContent='ON';status.classList.add('active');}
        const toggle=document.getElementById('eventListenerToggle');
        if(toggle)toggle.classList.add('active');
    }

