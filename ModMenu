    function frostApplyDeleteAccountLanguage() {
        const t = frostDeleteAccountLang();
        const row = document.getElementById('frostDeleteAccountRow');
        if (!row) return;

        const title = row.querySelector('[data-delete-account-i18n="title"]');
        const desc = row.querySelector('[data-delete-account-i18n="desc"]');
        const button = document.getElementById('deleteAccountBtn');

        if (title) title.textContent = t.title;
        if (desc) desc.textContent = t.desc;
