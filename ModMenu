    // ==========================================
    // AUTO CLICKER ENGINE - FIXED & IMPROVED
    // ==========================================
    let autoClickerInterval = null;
    let isAutoClickerActive = false;
    let autoClickerKey = 'Space';
    let autoClickerMouseButton = 'left';
    let autoClickerDelay = 1000;
    let autoClickerMaxClicks = 0;
    let autoClickerCurrentClicks = 0;
    let autoClickerMode = 'keyboard';
    let autoClickerTargetElement = null;
    let autoClickerPositionX = 0;
    let autoClickerPositionY = 0;

    function simulateKeyPress(key) {
        try {
            const event = new KeyboardEvent('keydown', {
                key: key,
                code: key,
                bubbles: true,
                cancelable: true,
                composed: true
            });
            document.dispatchEvent(event);
            setTimeout(() => {
                const upEvent = new KeyboardEvent('keyup', {
                    key: key,
                    code: key,
                    bubbles: true,
                    cancelable: true,
                    composed: true
                });
                document.dispatchEvent(upEvent);
            }, 10);
            console.log(`[AUTO CLICKER] Simulated key press: ${key}`);
            return true;
        } catch(e) {
            console.error('[AUTO CLICKER] Error simulating key:', e);
            return false;
        }
    }

    function simulateMouseClick(button, x, y) {
        try {
            const target = autoClickerTargetElement || document.elementFromPoint(x, y) || document.body;
            const rect = target.getBoundingClientRect();
            const clickX = x || rect.left + rect.width / 2;
            const clickY = y || rect.top + rect.height / 2;

            const eventOptions = {
                bubbles: true,
                cancelable: true,
                composed: true,
                clientX: clickX,
                clientY: clickY,
                screenX: clickX,
                screenY: clickY,
                button: button === 'left' ? 0 : button === 'middle' ? 1 : 2,
                buttons: button === 'left' ? 1 : button === 'middle' ? 4 : 2
            };

            const downEvent = new MouseEvent('mousedown', eventOptions);
            target.dispatchEvent(downEvent);

            setTimeout(() => {
                const upEvent = new MouseEvent('mouseup', eventOptions);
                target.dispatchEvent(upEvent);
                const clickEvent = new MouseEvent('click', eventOptions);
                target.dispatchEvent(clickEvent);
            }, 10);

            console.log(`[AUTO CLICKER] Simulated mouse click: ${button} at (${clickX}, ${clickY})`);
            return true;
        } catch(e) {
            console.error('[AUTO CLICKER] Error simulating mouse click:', e);
            return false;
        }
    }

    function performAutoClick() {
        if (!isAutoClickerActive) return;
        if (autoClickerMaxClicks > 0 && autoClickerCurrentClicks >= autoClickerMaxClicks) {
            stopAutoClicker();
            showNotification('⏹️ Auto Clicker finished (max clicks reached)', 'info');
            return;
        }

        let success = false;
        if (autoClickerMode === 'keyboard') {
            success = simulateKeyPress(autoClickerKey);
        } else if (autoClickerMode === 'mouse') {
            const posX = autoClickerPositionX || window.innerWidth / 2;
            const posY = autoClickerPositionY || window.innerHeight / 2;
            success = simulateMouseClick(autoClickerMouseButton, posX, posY);
        }

        if (success) {
            autoClickerCurrentClicks++;
            const counterDisplay = document.getElementById('autoClickerCounter');
            if (counterDisplay) {
                counterDisplay.textContent = autoClickerCurrentClicks;
            }
            playSound('click');
        }
    }

    function startAutoClicker() {
        if (isAutoClickerActive) {
            showNotification('⚠️ Auto Clicker is already running!', 'warning');
            return;
        }

        const keyInput = document.getElementById('autoClickerKeyInput');
        if (keyInput) {
            autoClickerKey = keyInput.value || 'Space';
        }

        const mouseButtonSelect = document.getElementById('autoClickerMouseButton');
        if (mouseButtonSelect) {
            autoClickerMouseButton = mouseButtonSelect.value;
        }

        const modeSelect = document.getElementById('autoClickerMode');
        if (modeSelect) {
            autoClickerMode = modeSelect.value;
        }

        const delayInput = document.getElementById('autoClickerDelayInput');
        if (delayInput) {
            autoClickerDelay = parseInt(delayInput.value) || 1000;
            if (autoClickerDelay < 10) autoClickerDelay = 10;
        }

        const maxClicksInput = document.getElementById('autoClickerMaxClicks');
        if (maxClicksInput) {
            autoClickerMaxClicks = parseInt(maxClicksInput.value) || 0;
            if (autoClickerMaxClicks < 0) autoClickerMaxClicks = 0;
        }

        const xPosInput = document.getElementById('autoClickerXPos');
        if (xPosInput) {
            autoClickerPositionX = parseInt(xPosInput.value) || 0;
        }

        const yPosInput = document.getElementById('autoClickerYPos');
        if (yPosInput) {
            autoClickerPositionY = parseInt(yPosInput.value) || 0;
        }

        autoClickerCurrentClicks = 0;

        const statusDisplay = document.getElementById('autoClickerStatus');
        if (statusDisplay) {
            statusDisplay.textContent = '● RUNNING';
            statusDisplay.style.color = '#ef4444';
        }

        const startBtn = document.getElementById('autoClickerStartBtn');
        const stopBtn = document.getElementById('autoClickerStopBtn');
        if (startBtn) startBtn.disabled = true;
        if (stopBtn) stopBtn.disabled = false;

        const counterDisplay = document.getElementById('autoClickerCounter');
        if (counterDisplay) {
            counterDisplay.textContent = '0';
        }

        isAutoClickerActive = true;
        autoClickerInterval = setInterval(performAutoClick, autoClickerDelay);
        setTimeout(performAutoClick, 50);

        showNotification(`🔄 Auto Clicker started (${autoClickerMode === 'keyboard' ? 'Key: ' + autoClickerKey : 'Mouse: ' + autoClickerMouseButton + ' click'})`, 'success');
        playSound('toggle');
    }

    function stopAutoClicker() {
        if (autoClickerInterval) {
            clearInterval(autoClickerInterval);
            autoClickerInterval = null;
        }
        isAutoClickerActive = false;

        const statusDisplay = document.getElementById('autoClickerStatus');
        if (statusDisplay) {
            statusDisplay.textContent = '● IDLE';
            statusDisplay.style.color = '#6b7280';
        }

        const startBtn = document.getElementById('autoClickerStartBtn');
        const stopBtn = document.getElementById('autoClickerStopBtn');
        if (startBtn) startBtn.disabled = false;
        if (stopBtn) stopBtn.disabled = true;

        showNotification('⏹️ Auto Clicker stopped', 'info');
        playSound('click');
    }

    function toggleAutoClicker() {
        if (isAutoClickerActive) {
            stopAutoClicker();
        } else {
            startAutoClicker();
        }
    }

    function resetAutoClickerCounter() {
        autoClickerCurrentClicks = 0;
        const counterDisplay = document.getElementById('autoClickerCounter');
        if (counterDisplay) {
            counterDisplay.textContent = '0';
        }
        showNotification('🔄 Auto Clicker counter reset', 'info');
        playSound('click');
    }

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'A') {
            e.preventDefault();
            toggleAutoClicker();
        }
        if (e.ctrlKey && e.shiftKey && e.key === 'S') {
            e.preventDefault();
            if (isAutoClickerActive) {
                stopAutoClicker();
            }
        }
    });

