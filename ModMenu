    function frostV28ApplyAdBlock() {
        document.documentElement.classList.toggle('frost-v28-adblock-enabled', !!frostV28Prefs.adBlock);

        if (frostV28AdObserver) {
            frostV28AdObserver.disconnect();
            frostV28AdObserver = null;
        }

        if (!frostV28Prefs.adBlock) return;

        const selectors = [
            '[data-ad-slot]','[data-ad-client]','.adsbygoogle','ins.adsbygoogle',
            'iframe[src*="doubleclick.net"]','iframe[src*="googlesyndication.com"]',
            'iframe[src*="googleadservices.com"]','iframe[src*="adservice.google."]',
            '[aria-label="Advertisement" i]','[aria-label="Ads" i]'
        ];

        const hideAds = root => {
            if (!(root instanceof Element || root instanceof Document)) return;
            selectors.forEach(selector => {
                try {
                    root.querySelectorAll?.(selector).forEach(el => {
                        if (!el.closest?.('#modMenuContainer')) el.style.setProperty('display','none','important');
                    });
                } catch (e) {}
            });
        };

        hideAds(document);
        frostV28AdObserver = new MutationObserver(records => {
            for (const record of records) {
                record.addedNodes.forEach(node => {
                    if (node.nodeType === 1) hideAds(node);
                });
            }
        });
        frostV28AdObserver.observe(document.documentElement, {childList:true,subtree:true});
    }

