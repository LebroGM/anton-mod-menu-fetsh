    function frostV27BuildApiFetcher() {
        const content=document.getElementById('modMenuContent');
        if(!content) return;
        let panel=document.querySelector('.section-panel[data-section="apifetcher"]');
        if(!panel){
            panel=document.createElement('div');
            panel.className='section-panel';
            panel.dataset.section='apifetcher';
            content.appendChild(panel);
        }
        panel.innerHTML=`
            <div class="panel-title"><span class="title-icon">⇄</span> API URL Fetcher</div>
            <div class="frost-v27-intro">Developer utility for testing a URL with browser fetch. Requests omit cookies/credentials. Cross-origin requests still depend on the target server's CORS policy.</div>
            <div class="frost-v27-card">
                <div class="frost-v27-row">
                    <label>Method</label><select id="frostApiMethod"><option>GET</option><option>HEAD</option></select>
                    <input id="frostApiUrl" class="frost-v27-wide" type="url" placeholder="https://api.example.com/data">
                    <button class="btn primary" id="frostApiFetchBtn">FETCH</button>
                    <button class="btn" id="frostApiClearBtn">CLEAR</button>
                </div>
                <div class="frost-v27-row">
                    <label>Timeout</label><input id="frostApiTimeout" class="frost-v27-number" type="number" min="1000" max="30000" step="1000" value="12000"><span class="frost-v27-status">ms</span>
                    <span id="frostApiStatus" class="frost-v27-status">READY</span>
                </div>
            </div>
            <div class="frost-v27-section-title">Response</div>
            <div class="frost-v27-row"><button class="btn" id="frostApiCopyBtn">COPY RESPONSE</button></div>
            <div id="frostApiOutput" class="frost-v27-display" style="max-height:330px;overflow:auto">No request yet.</div>
        `;

        const output=document.getElementById('frostApiOutput');
        const status=document.getElementById('frostApiStatus');
        document.getElementById('frostApiFetchBtn')?.addEventListener('click',async()=>{
            const url=(document.getElementById('frostApiUrl')?.value||'').trim();
            const method=document.getElementById('frostApiMethod')?.value||'GET';
            const timeout=Math.max(1000,Math.min(30000,Number(document.getElementById('frostApiTimeout')?.value)||12000));
            let parsed;
            try{parsed=new URL(url,location.href);if(!['http:','https:'].includes(parsed.protocol))throw new Error('Only http/https URLs are supported');}
            catch(e){showNotification('Enter a valid http/https URL','warning');return;}
            const controller=new AbortController();
            const timer=setTimeout(()=>controller.abort(),timeout);
            const started=performance.now();
            status.textContent='FETCHING';
            output.textContent='Requesting '+parsed.href+' ...';
            try{
                const response=await fetch(parsed.href,{method,credentials:'omit',cache:'no-store',redirect:'follow',signal:controller.signal,headers:{Accept:'application/json,text/plain,*/*'}});
                const elapsed=Math.round(performance.now()-started);
                const headers=[...response.headers.entries()].map(([k,v])=>`${k}: ${v}`).join('\n');
                let body='';
                if(method!=='HEAD'){
                    body=await response.text();
                    if(body.length>100000) body=body.slice(0,100000)+'\n\n[truncated at 100 KB]';
                    const ct=response.headers.get('content-type')||'';
                    if(ct.includes('application/json')){
                        try{body=JSON.stringify(JSON.parse(body),null,2);}catch(e){}
                    }
                }
                status.textContent=`${response.status} ${response.statusText}`;
                output.textContent=`URL: ${response.url}\nSTATUS: ${response.status} ${response.statusText}\nTIME: ${elapsed} ms\nTYPE: ${response.headers.get('content-type')||'unknown'}\n\nHEADERS\n${headers||'(none exposed)'}\n\nBODY\n${body||'(empty)'}`;
            }catch(err){
                status.textContent=err.name==='AbortError'?'TIMEOUT':'ERROR';
                output.textContent=err.name==='AbortError'
                    ?`Request timed out after ${timeout} ms.`
                    :`Fetch failed.\n${err.message}\n\nFor cross-origin URLs this is often caused by the remote server's CORS policy.`;
            }finally{clearTimeout(timer);}
        });
        document.getElementById('frostApiClearBtn')?.addEventListener('click',()=>{
            document.getElementById('frostApiUrl').value='';
            output.textContent='No request yet.';status.textContent='READY';
        });
        document.getElementById('frostApiCopyBtn')?.addEventListener('click',async()=>{
            try{await frostCopyText(output.textContent||'');showNotification('API response copied','success');}
            catch(e){showNotification('Could not copy response','warning');}
        });
    }

