    function exportEvents() {
        if (capturedEvents.length === 0) {
            showNotification('❌ No events to export', 'warning');
            return;
        }
        const json = JSON.stringify(capturedEvents, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `events_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showNotification('📡 Events exported!', 'success');
    }

    window.copyEventData = function(index) {
        if (index < 0 || index >= capturedEvents.length) return;
        const event = capturedEvents[index];
        const text = JSON.stringify(event, null, 2);
        navigator.clipboard.writeText(text).then(() => {
            showNotification('📋 Event copied to clipboard!', 'success');
        }).catch(() => {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showNotification('📋 Event copied!', 'success');
        });
    };

    window.toggleEventExpand = function(index) {
        if (index < 0 || index >= capturedEvents.length) return;
        capturedEvents[index]._expanded = !capturedEvents[index]._expanded;
