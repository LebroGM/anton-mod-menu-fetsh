    function frostWebsiteAudioRestore(){
        try{frostWebsiteAudioObserver?.disconnect()}catch(e){}
        frostWebsiteAudioObserver=null;

        frostWebsiteMediaElements.forEach(media=>{
            const base=frostWebsiteMediaOriginal.get(media);
            if(!base)return;
            try{
                media.muted=base.muted;
                media.volume=base.volume;
            }catch(e){}
        });

        [...frostWebsiteSuspendedContexts].forEach(ctx=>{
            try{Promise.resolve(ctx.resume()).catch(()=>{})}catch(e){}
        });
        frostWebsiteSuspendedContexts.clear();

        try{
            if(frostWebsiteOriginalPlay){
                HTMLMediaElement.prototype.play=frostWebsiteOriginalPlay;
            }
        }catch(e){}

        try{
            if(frostWebsiteOriginalBufferStart&&window.AudioBufferSourceNode){
                AudioBufferSourceNode.prototype.start=frostWebsiteOriginalBufferStart;
            }
        }catch(e){}

        try{
            if(frostWebsiteOriginalOscStart&&window.OscillatorNode){
                OscillatorNode.prototype.start=frostWebsiteOriginalOscStart;
            }
        }catch(e){}

        try{
            if(frostWebsiteOriginalConstantStart&&window.ConstantSourceNode){
                ConstantSourceNode.prototype.start=frostWebsiteOriginalConstantStart;
            }
        }catch(e){}

        frostWebsiteAudioPatched=false;
    }

