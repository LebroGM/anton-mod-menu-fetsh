                typeof antonPlusUnlockGamesOriginalLogMethod === 'function'
            ) {
                log.log = antonPlusUnlockGamesOriginalLogMethod;
                antonPlusUnlockGamesWrapper = null;
                antonPlusUnlockGamesOriginalLogMethod = null;
