    // ==========================================================
    // ☣︎ Nineytone ☣︎ v29 - CALCULATOR STUDIO
    // Safe expression parser: no eval(), no Function().
    // ==========================================================
    let frostV29CalcHistory = frostReadJson(FROST_V29_CALC_HISTORY, []);
    let frostV29CalcAns = 0;
    let frostV29CalcMemory = 0;
    let frostV29CalcAngle = 'deg';

    function frostV29CalcTokenize(source) {
        const out = [];
        const src = String(source || '').replace(/π/g, 'pi').replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-');
        let i = 0;
        while (i < src.length) {
            const ch = src[i];
            if (/\s/.test(ch)) { i++; continue; }
            if (/[0-9.]/.test(ch)) {
                let j = i;
                let seenDot = false;
                while (j < src.length && /[0-9.eE+-]/.test(src[j])) {
                    const c = src[j];
                    if (c === '.') {
                        if (seenDot) break;
                        seenDot = true;
                    }
                    if ((c === '+' || c === '-') && j > i && !/[eE]/.test(src[j-1])) break;
                    j++;
                }
                const raw = src.slice(i, j);
                const n = Number(raw);
                if (!Number.isFinite(n)) throw new Error('Invalid number');
                out.push({type:'number', value:n});
                i = j;
                continue;
            }
            if (/[A-Za-z_]/.test(ch)) {
                let j = i + 1;
                while (j < src.length && /[A-Za-z0-9_]/.test(src[j])) j++;
                out.push({type:'name', value:src.slice(i,j).toLowerCase()});
                i = j;
                continue;
            }
            if ('+-*/^%(),!'.includes(ch)) {
                out.push({type:ch, value:ch});
                i++;
                continue;
            }
            throw new Error(`Unexpected "${ch}"`);
        }
        out.push({type:'eof', value:''});
        return out;
    }

    function frostV29CalcParse(source) {
        const tokens = frostV29CalcTokenize(source);
        let pos = 0;
        const peek = () => tokens[pos];
        const take = type => {
            if (peek().type !== type) throw new Error(`Expected ${type}`);
            return tokens[pos++];
        };
        const angleIn = x => frostV29CalcAngle === 'deg' ? x * Math.PI / 180 : x;
        const angleOut = x => frostV29CalcAngle === 'deg' ? x * 180 / Math.PI : x;

        const factorial = n => {
            if (!Number.isInteger(n) || n < 0 || n > 170) throw new Error('Factorial needs integer 0–170');
            let r = 1;
            for (let k=2;k<=n;k++) r *= k;
            return r;
        };

        const callFn = (name,args) => {
            const one = () => {
                if (args.length !== 1) throw new Error(`${name} expects 1 value`);
                return args[0];
            };
            switch (name) {
                case 'sin': return Math.sin(angleIn(one()));
                case 'cos': return Math.cos(angleIn(one()));
                case 'tan': return Math.tan(angleIn(one()));
                case 'asin': return angleOut(Math.asin(one()));
                case 'acos': return angleOut(Math.acos(one()));
                case 'atan': return angleOut(Math.atan(one()));
                case 'sqrt': return Math.sqrt(one());
                case 'abs': return Math.abs(one());
                case 'ln': return Math.log(one());
                case 'log': return Math.log10(one());
                case 'exp': return Math.exp(one());
                case 'floor': return Math.floor(one());
                case 'ceil': return Math.ceil(one());
                case 'round': return Math.round(one());
                case 'min': return Math.min(...args);
                case 'max': return Math.max(...args);
                case 'pow':
                    if (args.length !== 2) throw new Error('pow expects 2 values');
                    return Math.pow(args[0],args[1]);
                default: throw new Error(`Unknown function: ${name}`);
            }
        };

        function primary() {
            let value;
            if (peek().type === 'number') {
                value = take('number').value;
            } else if (peek().type === 'name') {
                const name = take('name').value;
                if (peek().type === '(') {
                    take('(');
                    const args = [];
                    if (peek().type !== ')') {
                        args.push(expression());
                        while (peek().type === ',') { take(','); args.push(expression()); }
                    }
                    take(')');
                    value = callFn(name,args);
                } else {
                    if (name === 'pi') value = Math.PI;
                    else if (name === 'e') value = Math.E;
                    else if (name === 'ans') value = frostV29CalcAns;
                    else if (name === 'mem' || name === 'm') value = frostV29CalcMemory;
                    else throw new Error(`Unknown constant: ${name}`);
                }
            } else if (peek().type === '(') {
                take('(');
                value = expression();
                take(')');
            } else {
                throw new Error('Expected a number, constant or "("');
            }

            while (peek().type === '!') {
                take('!');
                value = factorial(value);
            }
            return value;
        }

        function unary() {
            if (peek().type === '+') { take('+'); return unary(); }
            if (peek().type === '-') { take('-'); return -unary(); }
            return primary();
        }

        function power() {
            let left = unary();
            if (peek().type === '^') {
                take('^');
                left = Math.pow(left, power());
            }
            return left;
        }

        function term() {
            let left = power();
            while (['*','/','%'].includes(peek().type)) {
                const op = tokens[pos++].type;
                const right = power();
                if ((op === '/' || op === '%') && right === 0) throw new Error('Division by zero');
                left = op === '*' ? left * right : op === '/' ? left / right : left % right;
            }
            return left;
        }

        function expression() {
            let left = term();
            while (peek().type === '+' || peek().type === '-') {
                const op = tokens[pos++].type;
                const right = term();
                left = op === '+' ? left + right : left - right;
            }
            return left;
        }

        const value = expression();
        if (peek().type !== 'eof') throw new Error('Unexpected input');
        if (!Number.isFinite(value)) throw new Error('Result is not finite');
        return value;
    }

    function frostV29CalcFormat(value) {
        if (!Number.isFinite(value)) return 'Error';
        const abs = Math.abs(value);
        if ((abs !== 0 && abs < 1e-8) || abs >= 1e12) return value.toExponential(10).replace(/\.?0+e/,'e');
        return Number(value.toPrecision(14)).toString();
    }

    function frostV29CalcEvaluate(expression) {
        const raw = String(expression || '').trim();
        if (!raw) throw new Error('Enter an expression');
        const result = frostV29CalcParse(raw);
        frostV29CalcAns = result;
        frostV29CalcHistory.unshift({expr:raw,result:frostV29CalcFormat(result),time:Date.now()});
        frostV29CalcHistory = frostV29CalcHistory.slice(0,40);
        frostWriteJson(FROST_V29_CALC_HISTORY, frostV29CalcHistory);
        frostV29RenderCalcHistory();
        return result;
