    function switchSection(sectionName) {
        const targetItem = document.querySelector(`#modMenuSidebar .sidebar-item[data-section="${sectionName}"]`);
        const targetPanel = document.querySelector(`#modMenuContent .section-panel[data-section="${sectionName}"]`);
        if (!targetItem || !targetPanel) return;

        document.querySelectorAll('#modMenuSidebar .sidebar-item').forEach(item => {
            const active = item.dataset.section === sectionName;
            item.classList.toggle('active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.tabIndex = active ? 0 : -1;
        });

        document.querySelectorAll('#modMenuContent .section-panel').forEach(panel => {
            const active = panel.dataset.section === sectionName;
            panel.classList.toggle('active', active);
            panel.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        targetItem.scrollIntoView({ block: 'nearest' });
        targetPanel.scrollTop = 0;
        playSound('switch');
