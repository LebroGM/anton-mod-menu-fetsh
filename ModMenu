        c('frostNotificationsEnabled',frostUiSettings.notificationsEnabled);v('frostNotificationPosition',frostUiSettings.notificationPosition);v('frostNotificationDuration',frostUiSettings.notificationDuration);x('frostNotificationDurationValue',(Number(frostUiSettings.notificationDuration)/1000).toFixed(1)+'s');
