    let eventListenerActive = false;
    let capturedEvents = [];
    let eventFilters = {
        adjustCoins: true,
        supportChat: true,
        finishGameAstroBang: true,
        finishGameSnowballBattle: true,
        finishGameBatCave: true,
        finishGameTowerBuilder: true,
        finishGameBroadJump: true,
        debugCoins: true,
        setCurrentGroup: true,
        unlockAvatarOption: true,
        sessionEnd: true,
        setName: true,
        setGameSoundDisabled: true,
        debugDeviceLogDetails: true,
        finishLevel: true,
        other: true
    };
    let originalEventListenerMethod = null;
    let maxEvents = 200;

    function toggleEventListener(enable) {
        eventListenerActive = enable;

        if (enable) {
            if (!originalEventListenerMethod && typeof log !== 'undefined' && log !== null && typeof log.log === 'function') {
                originalEventListenerMethod = log.log.bind(log);
            }

            if (typeof log !== 'undefined' && log !== null) {
                log.log = function(data) {
                    if (data && data.event) {
                        const eventType = data.event;
                        let shouldCapture = false;
                        if (eventFilters[eventType] !== undefined) {
                            shouldCapture = eventFilters[eventType];
                        } else {
                            shouldCapture = eventFilters.other;
                        }

                        if (shouldCapture) {
                            const timestamp = new Date().toLocaleTimeString();
                            capturedEvents.unshift({
                                timestamp: timestamp,
                                event: eventType,
                                data: data,
                                _expanded: false
                            });
                            if (capturedEvents.length > maxEvents) {
                                capturedEvents.pop();
                            }
                            updateEventDisplay();
                        }
                    }

                    if (originalEventListenerMethod) {
                        originalEventListenerMethod(data);
                    } else if (typeof log !== 'undefined' && log !== null && log.log !== undefined) {
                        if (log.log !== arguments.callee) {
                            log.log(data);
                        }
                    }
                };
            }

            const toggle = document.getElementById('eventListenerToggle');
            const label = document.getElementById('eventListenerLabel');
            if (toggle) {
                toggle.classList.add('active');
                if (label) {
                    label.textContent = 'ON';
                    label.classList.add('active');
                }
            }
            showNotification('📡 Event Listener Activated', 'success');
            playSound('toggle');

        } else {
            if (originalEventListenerMethod && typeof log !== 'undefined' && log !== null) {
                log.log = originalEventListenerMethod;
                originalEventListenerMethod = null;
            }

            const toggle = document.getElementById('eventListenerToggle');
            const label = document.getElementById('eventListenerLabel');
            if (toggle) {
                toggle.classList.remove('active');
                if (label) {
                    label.textContent = 'OFF';
                    label.classList.remove('active');
                }
            }
            showNotification('📡 Event Listener Deactivated', 'info');
            playSound('toggle');
        }
    }

    function toggleEventFilter(filterName) {
        if (eventFilters[filterName] !== undefined) {
            eventFilters[filterName] = !eventFilters[filterName];
            const toggle = document.getElementById(`filter_${filterName}`);
            if (toggle) {
                toggle.classList.toggle('active');
            }
            const label = document.getElementById(`filterLabel_${filterName}`);
            if (label) {
                label.textContent = eventFilters[filterName] ? 'ON' : 'OFF';
                label.classList.toggle('active', eventFilters[filterName]);
            }
            showNotification(`📡 Filter ${filterName}: ${eventFilters[filterName] ? 'ON' : 'OFF'}`, 'info');
        }
    }

    function updateEventDisplay() {
        const container = document.getElementById('eventList');
        if (!container) return;

        const countEl = document.getElementById('eventCount');
        if (countEl) countEl.textContent = `${capturedEvents.length} events`;

        if (capturedEvents.length === 0) {
