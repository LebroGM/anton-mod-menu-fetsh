        if (clock && !isMinimized) clock.style.display = frostUiSettings.showClock === false ? 'none' : 'block';
        const marquee = document.getElementById('slideshowContainer');
        if (marquee && !isMinimized) marquee.style.display = frostUiSettings.showMarquee === false ? 'none' : 'block';

        menuSound.volume = Math.max(0, Math.min(1, Number(frostUiSettings.uiSoundVolume) || 0));

        if (currentTheme === 'soldier') {
            const url = frostValidateImageUrl(frostUiSettings.backgroundUrl) || FROST_DEFAULT_BACKGROUND;
            const dim = Math.max(0, Math.min(.85, Number(frostUiSettings.backgroundDim) || 0));
            menu.style.setProperty('background-image',
                `linear-gradient(rgba(0,0,0,${dim}),rgba(0,0,0,${dim})),url("${frostCssUrl(url)}")`,
                'important');
            menu.style.setProperty('background-size', frostUiSettings.backgroundFit || 'cover', 'important');
            menu.style.setProperty('background-position', frostUiSettings.backgroundPosition || 'center center', 'important');
            menu.style.setProperty('background-repeat','no-repeat','important');
        } else {
            menu.style.removeProperty('background-image');
            menu.style.removeProperty('background-size');
            menu.style.removeProperty('background-position');
            menu.style.removeProperty('background-repeat');
        }

        frostApplyNotificationPosition();
        if (save) frostWriteJson(FROST_UI_STORAGE, frostUiSettings);
    }

    function frostLogActivity(message) {
        if (!message) return;
        frostActivityEntries.unshift({ time:new Date().toISOString(), message:String(message) });
        frostActivityEntries = frostActivityEntries.slice(0,100);
        frostWriteJson(FROST_ACTIVITY_STORAGE, frostActivityEntries);
        frostRenderActivityLog();
    }

    function frostRenderActivityLog() {
        const host = document.getElementById('frostActivityList');
        if (!host) return;
        host.innerHTML = frostActivityEntries.length
            ? frostActivityEntries.map(e => `<div class="frost-list-item"><div class="grow"><strong>${frostEscapeHtml(e.message)}</strong><small>${frostEscapeHtml(new Date(e.time).toLocaleTimeString())}</small></div></div>`).join('')
            : '<div class="frost-muted">No interface activity recorded yet.</div>';
    }

    function frostSafeTabMeta(id) {
        const row = FROST_SAFE_TABS.find(x => x[0] === id);
        return row ? { id:row[0], icon:row[1], label:row[2] } : null;
    }

