    const frostKeyLogger = {
        active:false,
        events:[],
        max:300,
        keydown:true,
        keyup:false
    };

    function frostKeyLoggerLang(){
        const code=frostV28Prefs.language||'en';
        return FROST_KEYLOGGER_I18N[code]||FROST_KEYLOGGER_I18N.en;
    }

    function frostKeyLoggerEditableTarget(target){
        if(!(target instanceof Element))return false;
        if(target.closest('input,textarea,select,[contenteditable="true"],[role="textbox"]'))return true;
        return false;
    }

    function frostKeyLoggerMods(e){
        const out=[];
        if(e.ctrlKey)out.push('CTRL');
        if(e.altKey)out.push('ALT');
        if(e.shiftKey)out.push('SHIFT');
        if(e.metaKey)out.push('META');
        return out.length?out.join(' + '):'NONE';
    }

    function frostKeyLoggerTarget(target){
        if(!(target instanceof Element))return 'document';
        const tag=target.tagName?.toLowerCase()||'element';
        const id=target.id?('#'+target.id):'';
        const section=target.closest?.('.section-panel')?.dataset?.section;
        return section?`${tag}${id} @ ${section}`:`${tag}${id}`;
    }

    function frostKeyLoggerHandle(e){
        if(!frostKeyLogger.active)return;
        if(e.type==='keydown'&&!frostKeyLogger.keydown)return;
        if(e.type==='keyup'&&!frostKeyLogger.keyup)return;
        if(frostKeyLoggerEditableTarget(e.target))return;

        frostKeyLogger.events.unshift({
            type:e.type,
            key:String(e.key),
            code:String(e.code),
            mods:frostKeyLoggerMods(e),
            repeat:!!e.repeat,
            target:frostKeyLoggerTarget(e.target),
            time:new Date().toISOString()
        });

        frostKeyLogger.events=frostKeyLogger.events.slice(0,frostKeyLogger.max);
        frostKeyLoggerRender();
    }

    function frostKeyLoggerStart(){
        if(frostKeyLogger.active)return;
        frostKeyLogger.active=true;
        document.addEventListener('keydown',frostKeyLoggerHandle,true);
        document.addEventListener('keyup',frostKeyLoggerHandle,true);
        frostKeyLoggerRender();
    }

    function frostKeyLoggerStop(){
        document.removeEventListener('keydown',frostKeyLoggerHandle,true);
        document.removeEventListener('keyup',frostKeyLoggerHandle,true);
        frostKeyLogger.active=false;
        frostKeyLoggerRender();
    }

    function frostKeyLoggerPublicEvents(){
        return frostKeyLogger.events.map(x=>({...x}));
    }

    async function frostKeyLoggerCopy(){
        const t=frostKeyLoggerLang();
        try{
            await frostCopyText(JSON.stringify(frostKeyLoggerPublicEvents(),null,2));
            showNotification(t.copied,'success');
        }catch(e){
            showNotification(t.copyBlocked,'warning');
        }
    }

    function frostKeyLoggerExport(){
        const t=frostKeyLoggerLang();
        const payload={
            exportedAt:new Date().toISOString(),
            source:'☣︎ Nineytone ☣︎ Key Logger',
            count:frostKeyLogger.events.length,
            events:frostKeyLoggerPublicEvents()
        };

        const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');
        a.href=url;
        a.download='fr0stbyte-key-events-'+new Date().toISOString().replace(/[:.]/g,'-')+'.json';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(()=>URL.revokeObjectURL(url),1000);
        showNotification(t.exported,'success');
    }

    function frostKeyLoggerRender(){
        const t=frostKeyLoggerLang();
        const host=document.getElementById('fKeyLoggerRows');
        const state=document.getElementById('fKeyLoggerState');
        const total=document.getElementById('fKeyLoggerTotal');
        const last=document.getElementById('fKeyLoggerLast');

        if(state)state.textContent=frostKeyLogger.active?t.listening:t.stopped;
        if(total)total.textContent=String(frostKeyLogger.events.length);
        if(last)last.textContent=frostKeyLogger.events[0]?.key||'—';

        if(!host)return;

        host.innerHTML=frostKeyLogger.events.length
            ? frostKeyLogger.events.slice(0,180).map(x=>`
                <div class="frost-v29-log-row fKeyLoggerRow">
                    <code>${frostV29Esc(x.type)}</code>
                    <span>${frostV29Esc(x.key)}</span>
                    <span class="target">${frostV29Esc(x.code)} · ${frostV29Esc(x.mods)} · ${frostV29Esc(x.target)}</span>
                    <small>${frostV29Esc(new Date(x.time).toLocaleTimeString())}</small>
                </div>
            `).join('')
            : `<div class="frost-v29-muted">${frostV29Esc(t.empty)}</div>`;
    }

    function frostKeyLoggerApplyLanguage(){
        const p=document.querySelector('.section-panel[data-section="keylogger"]');
