    function frostNextCoinStarsTransform(data) {
        if (
            !nextCoinStarsOverrideActive ||
            !data ||
            data.event !== 'setNextCoinTotalStars' ||
            data.value === undefined
        ) {
            return data;
        }

        const target = nextCoinStarsOverrideValue;

        try {
            data.value = target;
        } catch (_) {}

        // Frozen/read-only payload fallback.
        if (data.value !== target) {
            return { ...data, value: target };
        }

        return data;
    }

    function toggleNextCoinStarsOverride(enable) {
