    function frostV30ApplyUnifiedDesign(){
        const root=document.getElementById('modMenuContainer');
        if(!root)return;

        root.classList.add('n91-unified-ui');

        // Mark every current panel so dynamically built and legacy tabs
        // share one design scope without changing their feature logic.
        root.querySelectorAll('.section-panel').forEach(panel=>{
            panel.classList.add('n91-unified-panel');
        });
    }

    function frostV30InstallUnifiedDesign(){
        frostV30InjectUnifiedDesignStyles();
        frostV30ApplyUnifiedDesign();

        // Panels can be rebuilt by language/settings/reload helpers.
        // Re-apply only the harmless design class when that happens.
        try{
            window.__n91UnifiedDesignObserver?.disconnect?.();
        }catch(e){}

        const root=document.getElementById('modMenuContainer');
        if(!root)return;

        const observer=new MutationObserver(()=>{
            frostV30ApplyUnifiedDesign();
        });

        observer.observe(root,{
            childList:true,
            subtree:true
        });

        window.__n91UnifiedDesignObserver=observer;
    }

    function frostRemoveBrokenGroupMod(){
        try{
            if(groupJoinInterval){
                clearInterval(groupJoinInterval);
                groupJoinInterval=null;
            }
        }catch(e){}

        isGroupJoining=false;

        document.querySelectorAll(
            '#modMenuSidebar .sidebar-item[data-section="group"],' +
            '.section-panel[data-section="group"]'
        ).forEach(el=>el.remove());

        if (sections && Object.prototype.hasOwnProperty.call(sections,'group')) {
            delete sections.group;
        }
    }

