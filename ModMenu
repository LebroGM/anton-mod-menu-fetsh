            if (Math.abs(w - oldW) < 18 && Math.abs(h - oldH) < 18) return;

            clearTimeout(n91SnowResizeTimer);
            n91SnowResizeTimer = setTimeout(initSnowEffect, 180);
        });

        n91SnowResizeObserver.observe(menu);
    }
}

