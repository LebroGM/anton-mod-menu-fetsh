    function frostEventSenderLang(){
        const code=frostV28Prefs.language||'en';
        return FROST_EVENT_SENDER_I18N[code]||FROST_EVENT_SENDER_I18N.en;
    }

    function frostEventSenderPretty(value){
        try{return JSON.stringify(value,null,2)}catch(e){return String(value)}
    }

    function frostEventSenderGetLogger(){
        try{
            if(typeof log!=='undefined'&&log&&typeof log.log==='function')return log;
        }catch(e){}

        try{
            if(globalThis.log&&typeof globalThis.log.log==='function')return globalThis.log;
        }catch(e){}

        return null;
    }

    function frostEventSenderParse(){
        const t=frostEventSenderLang();
        const input=document.getElementById('fEventSenderJson');
        if(!input)return null;

        let value;
        try{
            value=JSON.parse(input.value);
        }catch(e){
            showNotification(t.invalidJson+': '+e.message,'error');
            return null;
        }

        if(!value||Array.isArray(value)||typeof value!=='object'){
            showNotification(t.objectOnly,'error');
            return null;
        }

        if(typeof value.event!=='string'||!value.event.trim()){
            showNotification(t.eventMissing,'warning');
            return null;
        }

        value.event=value.event.trim();
        return value;
    }

    function frostEventSenderLoadPreset(name){
        const preset=FROST_EVENT_SENDER_PRESETS[name];
        const input=document.getElementById('fEventSenderJson');
        if(!preset||!input)return;

        input.value=frostEventSenderPretty(preset);
        input.focus();
        input.setSelectionRange?.(0,0);
    }

    function frostEventSenderFormat(){
        const t=frostEventSenderLang();
        const value=frostEventSenderParse();
        if(!value)return;

        const input=document.getElementById('fEventSenderJson');
        if(input)input.value=frostEventSenderPretty(value);
        showNotification(t.formatted,'success');
    }

    async function frostEventSenderCopyCurrent(){
        const t=frostEventSenderLang();
        const value=frostEventSenderParse();
        if(!value)return;

        try{
            await frostCopyText(frostEventSenderPretty(value));
            showNotification(t.copied,'success');
        }catch(e){
            showNotification(t.copyBlocked,'warning');
        }
    }

    function frostEventSenderSendObject(value,record=true){
        const t=frostEventSenderLang();
        const logger=frostEventSenderGetLogger();

        if(!logger){
            showNotification(t.loggerMissing,'error');
            playSound('error');
            return false;
        }

        const payload=JSON.parse(JSON.stringify(value));

        try{
            logger.log(payload);

            if(record){
                frostEventSenderState.history.unshift({
                    id:'sender-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),
                    time:Date.now(),
                    data:payload
                });

                frostEventSenderState.history=frostEventSenderState.history.slice(
                    0,
                    frostEventSenderState.maxHistory
                );
            }

            frostEventSenderRenderHistory();
            showNotification(t.sent+': '+payload.event,'success');
            playSound('success');
            return true;
        }catch(e){
            showNotification('Event send failed: '+(e?.message||e),'error');
            playSound('error');
            return false;
        }
    }

    function frostEventSenderSend(){
        const value=frostEventSenderParse();
        if(!value)return false;
        return frostEventSenderSendObject(value,true);
    }

    function frostEventSenderRenderHistory(){
        const host=document.getElementById('fEventSenderHistory');
        if(!host)return;

        const t=frostEventSenderLang();
        const rows=frostEventSenderState.history;

        host.innerHTML=rows.map(entry=>{
            const data=entry.data||{};
            const preview=frostEventSenderPretty(data)
                .replace(/\s+/g,' ')
                .slice(0,220);

            return `
                <div class="frost-v29-feature fEventSenderHistoryRow">
                    <div class="grow">
                        <strong>${frostV29Esc(String(data.event||'unknown'))}</strong>
                        <small>${frostV29Esc(new Date(entry.time).toLocaleTimeString())} · ${frostV29Esc(preview)}</small>
                    </div>
                    <button class="btn" data-fsender-copy="${frostV29Esc(entry.id)}">${frostV29Esc(t.copyRow)}</button>
                    <button class="btn primary" data-fsender-resend="${frostV29Esc(entry.id)}">${frostV29Esc(t.resend)}</button>
                </div>
            `;
        }).join('')||`<div class="frost-v29-muted">${frostV29Esc(t.emptyHistory)}</div>`;

        host.querySelectorAll('[data-fsender-copy]').forEach(btn=>{
            btn.addEventListener('click',async()=>{
                const entry=frostEventSenderState.history.find(x=>x.id===btn.dataset.fsenderCopy);
                if(!entry)return;

                try{
                    await frostCopyText(frostEventSenderPretty(entry.data));
                    showNotification(t.copied,'success');
                }catch(e){
                    showNotification(t.copyBlocked,'warning');
                }
            });
        });

        host.querySelectorAll('[data-fsender-resend]').forEach(btn=>{
            btn.addEventListener('click',()=>{
                const entry=frostEventSenderState.history.find(x=>x.id===btn.dataset.fsenderResend);
                if(!entry)return;
                frostEventSenderSendObject(entry.data,true);
            });
        });
    }

