    function frostInstallDebugCoinsTracker() {
        debugCoinsTrackerEnabled = true;

        const tryAttach = () => {
            if (!debugCoinsTrackerEnabled) return false;
            if (debugCoinsTrackerWrapper) return true;

            const obj = frostGetBasicLogObject();
            if (!obj || typeof obj.log !== 'function') return false;

            const downstream = obj.log.bind(obj);
            debugCoinsTrackerOriginalLogMethod = downstream;

            debugCoinsTrackerWrapper = function(data, ...rest) {
                if (data && data.event === 'debugCoins') {
                    frostCaptureDebugCoinsEvent(data);
                    data = frostDebugCoinsTransform(data);
                }

                return downstream(data, ...rest);
            };

            obj.log = debugCoinsTrackerWrapper;
            return true;
        };

        if (tryAttach()) return true;

        clearInterval(debugCoinsTrackerRetryTimer);
        debugCoinsTrackerRetryTimer = setInterval(() => {
            if (tryAttach()) {
                clearInterval(debugCoinsTrackerRetryTimer);
                debugCoinsTrackerRetryTimer = null;
            }
        }, 500);

        return false;
    }

    function frostStopDebugCoinsTracker() {
        debugCoinsTrackerEnabled = false;
        clearInterval(debugCoinsTrackerRetryTimer);
        debugCoinsTrackerRetryTimer = null;

        const obj = frostGetBasicLogObject();

        try {
            if (
                obj &&
                debugCoinsTrackerWrapper &&
                obj.log === debugCoinsTrackerWrapper &&
                typeof debugCoinsTrackerOriginalLogMethod === 'function'
            ) {
                obj.log = debugCoinsTrackerOriginalLogMethod;
            }
        } catch (_) {}

        debugCoinsTrackerWrapper = null;
        debugCoinsTrackerOriginalLogMethod = null;
    }


