    async function frostDeleteAccount() {
        const t = frostDeleteAccountLang();

        if (!window.confirm(t.confirm)) {
            showNotification(t.cancelled, 'info');
            return false;
        }

        const typed = window.prompt(t.type, '');
        if (typed !== 'DELETE') {
            showNotification(t.mismatch, 'warning');
            playSound('error');
            return false;
        }

        const button = document.getElementById('deleteAccountBtn');
        const oldText = button?.textContent || t.button;

        if (button) {
            button.disabled = true;
            button.textContent = '…';
        }

        showNotification(t.sending, 'warning');

        try {
            const result = await new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                xhr.__frostGeneratedAccountRequest = true;

                // Captured native request:
                // XHR POST https://b-apis-db.anton.app/?p=user/markForDelete/mark
                //
                // IMPORTANT: no withCredentials here.
                // The endpoint returns Access-Control-Allow-Origin: *.
                // Browsers reject wildcard CORS when credentials are enabled.
                //
                // Also do not add application/json yet: that creates a CORS
                // preflight. Until the real native body/headers are captured,
                // keep this a simple empty-body POST.
                xhr.open('POST', FROST_DELETE_ACCOUNT_API_URL, true);
                xhr.timeout = 15000;

                xhr.onload = () => {
                    const status = Number(xhr.status) || 0;
                    let responseText = '';

                    try {
                        responseText = String(xhr.responseText || '');
                    } catch (_) {}

                    console.log('[DELETE ACCOUNT] simple XHR response:', {
                        url: FROST_DELETE_ACCOUNT_API_URL,
                        status,
                        statusText: xhr.statusText || '',
                        response: responseText
                    });

                    if (status >= 200 && status < 300) {
                        resolve({
                            status,
                            statusText: xhr.statusText || '',
                            responseText
                        });
                        return;
                    }

                    reject(new Error(
                        `HTTP ${status}${xhr.statusText ? ' ' + xhr.statusText : ''}`
                    ));
                };

                xhr.onerror = () => reject(new Error('XHR network/CORS error'));
                xhr.ontimeout = () => reject(new Error('XHR request timed out'));
                xhr.onabort = () => reject(new Error('XHR request aborted'));

                xhr.send();
            });

            showNotification(`${t.success} HTTP ${result.status}`, 'success');
            playSound('success');
            return true;
        } catch (e) {
            console.error('[DELETE ACCOUNT] simple XHR POST failed:', {
                url: FROST_DELETE_ACCOUNT_API_URL,
                name: e?.name || 'Error',
                message: e?.message || String(e),
                error: e
            });

            showNotification(`${t.failed} ${e?.message || ''}`.trim(), 'error');
            playSound('error');
            return false;
        } finally {
            if (button && button.isConnected) {
                button.disabled = false;
                button.textContent = oldText;
                frostApplyDeleteAccountLanguage();
            }
        }
    }


