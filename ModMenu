    function generateRandomGroupCode() {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let result = 'GROUP-';
        for (let i = 0; i < 4; i++) {
            for (let j = 0; j < 4; j++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            if (i < 3) result += '-';
        }
        return result;
    }

    function tryJoinGroup(groupCode) {
        if (typeof log !== 'undefined' && log !== null) {
            log.log({ event: "setCurrentGroup", groupCode: groupCode });
            console.log(`[GROUP] Attempting to join: ${groupCode}`);
            showNotification(`👥 Trying to join: ${groupCode}`, 'info');
            playSound('click');
            return true;
        }
        playSound('error');
        showNotification('❌ Error joining group', 'error');
        return false;
    }

    function tryJoinRandomGroup() {
