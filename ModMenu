    function frostV27InstallAutoPicker() {
        if (!frostV27AutoPickerHandler) {
            frostV27AutoPickerHandler = function(e) {
                if (!frostV27AutoPickerArmed) return;

                const target = e.target instanceof Element ? e.target : null;
                if (!target) return;

                // Clicking inside Nineytone while PICK is armed should not
                // accidentally select a menu control. STOP / cancel remains usable.
                if (target.closest('#modMenuContainer')) return;

                frostV27AutoPickerArmed = false;

                // Picker click is selection only; do not activate the page element.
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation?.();

                const selector = frostV27CreateSelector(target);
                const rect = target.getBoundingClientRect();
                const centerX = Math.round(rect.left + rect.width / 2);
                const centerY = Math.round(rect.top + rect.height / 2);

                const selectorInput = document.getElementById('autoClickerSelector');
                const xInput = document.getElementById('autoClickerXPos');
                const yInput = document.getElementById('autoClickerYPos');
                const info = document.getElementById('autoClickerTargetInfo');

                if (selectorInput) selectorInput.value = selector;
                if (xInput) xInput.value = String(centerX);
                if (yInput) yInput.value = String(centerY);

                frostV27AutoLastTarget = target;

                if (info) {
                    info.textContent =
                        `${selector || target.tagName.toLowerCase()}\n` +
                        `center: ${centerX}, ${centerY} · ` +
                        `${Math.round(rect.width)}×${Math.round(rect.height)} px`;
                }

                showNotification('Auto Clicker target selected','success');
            };

            document.addEventListener('click', frostV27AutoPickerHandler, true);
        }

        if (!frostV27AutoPickerKeyHandler) {
            frostV27AutoPickerKeyHandler = function(e) {
                if (!frostV27AutoPickerArmed) return;
                if (e.key !== 'Escape') return;

                e.preventDefault();
                e.stopPropagation();
                frostV27CancelAutoPicker(true);
            };

            document.addEventListener('keydown', frostV27AutoPickerKeyHandler, true);
        }
    }

