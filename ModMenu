        currencies.insertAdjacentHTML('beforebegin', "<div class=\"section-panel frost-v26-panel\" data-section=\"favorites\"><div class=\"panel-title\"><span class=\"title-icon\">★</span> Favorites</div>\n<div class=\"frost-panel-intro\">Pin the Nineytone utility pages you use most. Favorites only launch interface pages.</div>\n<div id=\"frostFavoriteLaunchers\" class=\"frost-favorite-grid\"></div>\n<div class=\"frost-subtitle\">Choose favorites</div>\n<div id=\"frostFavoritesPicker\" class=\"frost-list\"></div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"effects\"><div class=\"panel-title\"><span class=\"title-icon\">✦</span> Effects</div>\n<div class=\"frost-panel-intro\">Remade multi-depth snow with smoother drift, adaptive fall distance and lighter performance.</div>\n<div class=\"frost-setting-card\">\n  <h3>Snow engine · Remade</h3>\n  <div class=\"frost-control-row\"><label>Enabled</label><input id=\"frostSnowEnabled\" class=\"frost-switch\" type=\"checkbox\"></div>\n  <div class=\"frost-control-row\"><label>Density</label><input id=\"frostSnowDensity\" type=\"range\" min=\"0\" max=\"100\" step=\"1\"><span id=\"frostSnowDensityValue\" class=\"frost-value\"></span></div>\n  <div class=\"frost-control-row\"><label>Speed</label><input id=\"frostSnowSpeed\" type=\"range\" min=\"0.4\" max=\"2.5\" step=\"0.1\"><span id=\"frostSnowSpeedValue\" class=\"frost-value\"></span></div>\n  <div class=\"frost-control-row\"><label>Flake size</label><input id=\"frostSnowSize\" type=\"range\" min=\"0.5\" max=\"2\" step=\"0.1\"><span id=\"frostSnowSizeValue\" class=\"frost-value\"></span></div>\n  <div class=\"frost-control-row\"><label>Opacity</label><input id=\"frostSnowOpacity\" type=\"range\" min=\"0.2\" max=\"1\" step=\"0.05\"><span id=\"frostSnowOpacityValue\" class=\"frost-value\"></span></div>\n  <div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostRestartSnowBtn\">↻ Restart snow</button></div>\n</div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"frostlab\"><div class=\"panel-title\"><span class=\"title-icon\">❄</span> Frost Lab</div>\n<div class=\"frost-panel-intro\">Experimental Nineytone atmosphere controls and one-click visual presets.</div>\n<div class=\"frost-safe-grid\">\n  <div class=\"frost-setting-card\">\n    <h3>Atmosphere</h3>\n    <div class=\"frost-control-row\"><label>Vignette</label><input id=\"frostVignette\" class=\"frost-switch\" type=\"checkbox\"></div>\n    <div class=\"frost-control-row\"><label>Grain</label><input id=\"frostGrain\" class=\"frost-switch\" type=\"checkbox\"></div>\n    <div class=\"frost-control-row\"><label>Frost border</label><input id=\"frostBorder\" class=\"frost-switch\" type=\"checkbox\"></div>\n    <div class=\"frost-control-row\"><label>Background dim</label><input id=\"frostBackgroundDim\" type=\"range\" min=\"0\" max=\"0.75\" step=\"0.05\"><span id=\"frostBackgroundDimValue\" class=\"frost-value\"></span></div>\n  </div>\n  <div class=\"frost-setting-card\">\n    <h3>Presets</h3>\n    <p>Apply a visual recipe and fine-tune it afterwards.</p>\n    <div class=\"frost-chip-row\">\n      <button class=\"frost-chip\" data-frost-preset=\"minimal\">Minimal</button>\n      <button class=\"frost-chip\" data-frost-preset=\"soft\">Soft Snow</button>\n      <button class=\"frost-chip\" data-frost-preset=\"blizzard\">Blizzard</button>\n      <button class=\"frost-chip\" data-frost-preset=\"glass\">Frozen Glass</button>\n    </div>\n    <div class=\"frost-control-row\"><button class=\"btn\" id=\"frostPreviewEffectsBtn\">✦ Preview pulse</button></div>\n  </div>\n</div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"customize\"><div class=\"panel-title\"><span class=\"title-icon\">◈</span> Customize</div>\n<div class=\"frost-panel-intro\">Tune the visual identity of the Nineytone interface.</div>\n<div class=\"frost-safe-grid\">\n  <div class=\"frost-setting-card\">\n    <h3>Colors</h3>\n    <div class=\"frost-control-row\"><label>Accent</label><input id=\"frostAccentColor\" type=\"color\"><span id=\"frostAccentColorValue\" class=\"frost-value\"></span></div>\n    <div class=\"frost-control-row\"><label>Title</label><input id=\"frostTitleColor\" type=\"color\"><span id=\"frostTitleColorValue\" class=\"frost-value\"></span></div>\n  </div>\n  <div class=\"frost-setting-card\">\n    <h3>Typography & shape</h3>\n    <div class=\"frost-control-row\"><label>Font</label><select id=\"frostFontFamily\" class=\"frost-select\">\n      <option value=\"Space Grotesk\">Space Grotesk</option><option value=\"Inter\">Inter</option>\n      <option value=\"JetBrains Mono\">JetBrains Mono</option><option value=\"Orbitron\">Orbitron</option><option value=\"system-ui\">System UI</option>\n    </select></div>\n    <div class=\"frost-control-row\"><label>Corner radius</label><input id=\"frostCornerRadius\" type=\"range\" min=\"8\" max=\"32\" step=\"1\"><span id=\"frostCornerRadiusValue\" class=\"frost-value\"></span></div>\n    <div class=\"frost-control-row\"><label>Text scale</label><input id=\"frostTextScale\" type=\"range\" min=\"0.85\" max=\"1.3\" step=\"0.05\"><span id=\"frostTextScaleValue\" class=\"frost-value\"></span></div>\n  </div>\n</div>\n<div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostResetCustomizeBtn\">↺ Reset style</button></div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"backgrounds\"><div class=\"panel-title\"><span class=\"title-icon\">▧</span> Backgrounds</div>\n<div class=\"frost-panel-intro\">Set the Soldier-theme image, framing and darkness overlay.</div>\n<div class=\"frost-setting-card\">\n  <h3>Image source</h3>\n  <div class=\"frost-control-row\"><label>Image URL</label><input id=\"frostBackgroundUrl\" type=\"text\" style=\"flex:1 1 320px\" placeholder=\"https://...\"></div>\n  <div class=\"frost-control-row\"><label>Fit</label><select id=\"frostBackgroundFit\" class=\"frost-select\">\n    <option value=\"cover\">Cover</option><option value=\"contain\">Contain</option><option value=\"auto\">Original size</option>\n  </select><label style=\"min-width:auto\">Position</label><select id=\"frostBackgroundPosition\" class=\"frost-select\">\n    <option value=\"center center\">Center</option><option value=\"center top\">Top</option><option value=\"center bottom\">Bottom</option>\n    <option value=\"left center\">Left</option><option value=\"right center\">Right</option>\n  </select></div>\n  <div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostApplyBackgroundBtn\">Apply</button><button class=\"btn\" id=\"frostResetBackgroundBtn\">Reset default</button></div>\n</div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"layout\"><div class=\"panel-title\"><span class=\"title-icon\">⌗</span> Layout</div>\n<div class=\"frost-panel-intro\">Adjust how Nineytone uses space and reset the window when needed.</div>\n<div class=\"frost-safe-grid\">\n  <div class=\"frost-setting-card\"><h3>Sidebar & density</h3>\n    <div class=\"frost-control-row\"><label>Sidebar width</label><input id=\"frostSidebarWidth\" type=\"range\" min=\"145\" max=\"240\" step=\"1\"><span id=\"frostSidebarWidthValue\" class=\"frost-value\"></span></div>\n    <div class=\"frost-control-row\"><label>Compact mode</label><input id=\"frostCompactMode\" class=\"frost-switch\" type=\"checkbox\"></div>\n  </div>\n  <div class=\"frost-setting-card\"><h3>Header elements</h3>\n    <div class=\"frost-control-row\"><label>Show clock</label><input id=\"frostShowClock\" class=\"frost-switch\" type=\"checkbox\"></div>\n    <div class=\"frost-control-row\"><label>Show marquee</label><input id=\"frostShowMarquee\" class=\"frost-switch\" type=\"checkbox\"></div>\n  </div>\n</div>\n<div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostResetWindowBtn\">Center & reset size</button><button class=\"btn\" id=\"frostResetLayoutBtn\">Reset layout settings</button></div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"audiostudio\"><div class=\"panel-title\"><span class=\"title-icon\">♫</span> Audio Studio</div>\n<div class=\"frost-panel-intro\">Control Nineytone interface sounds separately from page audio.</div>\n<div class=\"frost-setting-card\">\n  <div class=\"frost-control-row\"><label>UI sounds</label><input id=\"frostUiSoundEnabled\" class=\"frost-switch\" type=\"checkbox\"></div>\n  <div class=\"frost-control-row\"><label>Volume</label><input id=\"frostUiSoundVolume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.05\"><span id=\"frostUiSoundVolumeValue\" class=\"frost-value\"></span></div>\n  <div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostPreviewSoundBtn\">♫ Preview sound</button></div>\n</div>\n</div>\n<div class=\"section-panel frost-v26-panel\" data-section=\"tools\"><div class=\"panel-title\"><span class=\"title-icon\">⌁</span> Tools</div>\n<div class=\"frost-safe-grid\">\n  <div class=\"frost-tool-card\"><h3>Stopwatch</h3><div id=\"frostStopwatchDisplay\" class=\"frost-code\">00:00.0</div>\n    <div class=\"frost-control-row\"><button class=\"btn primary\" id=\"frostStopwatchStart\">Start</button><button class=\"btn\" id=\"frostStopwatchReset\">Reset</button></div></div>\n  <div class=\"frost-tool-card\"><h3>Countdown</h3>\n    <div class=\"frost-control-row\"><input id=\"frostTimerSeconds\" type=\"number\" min=\"1\" value=\"60\" style=\"width:90px\"><button class=\"btn primary\" id=\"frostTimerStart\">Start</button><button class=\"btn\" id=\"frostTimerStop\">Stop</button></div>\n    <div id=\"frostTimerDisplay\" class=\"frost-code\">01:00</div></div>\n  <div class=\"frost-tool-card\"><h3>Random number</h3>\n    <div class=\"frost-control-row\"><input id=\"frostRandomMin\" type=\"number\" value=\"1\" style=\"width:72px\"><input id=\"frostRandomMax\" type=\"number\" value=\"100\" style=\"width:72px\"><button class=\"btn\" id=\"frostRandomBtn\">Generate</button></div>\n    <div id=\"frostRandomOut