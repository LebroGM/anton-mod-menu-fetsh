    function frostCaptureDebugCoinsEvent(data) {
        if (!data || data.event !== 'debugCoins') return false;

        debugCoinsDetectedCount++;
        debugCoinsLastDetected = frostDebugCoinsSafeSnapshot(data);

        if (!debugCoinsFormInitialized && !debugCoinsOverrideActive) {
            setTimeout(() => frostLoadDetectedDebugCoinsIntoForm(false), 0);
        }

        setTimeout(frostUpdateDebugCoinsUi, 0);

        console.log(
            `[DEBUG COINS] Detected debugCoins event #${debugCoinsDetectedCount}`,
            debugCoinsLastDetected
        );

        return true;
    }

    function frostDebugCoinsTransform(data) {
        if (
            !debugCoinsOverrideActive ||
            !debugCoinsOverrideConfigured ||
            !data ||
            data.event !== 'debugCoins'
        ) {
            return data;
        }

        let clone = null;

        const setField = (field, value) => {
            if (!Object.prototype.hasOwnProperty.call(data, field)) return;

            try {
                data[field] = value;
            } catch (_) {}

            if (data[field] !== value) {
                if (!clone) clone = { ...data };
                clone[field] = value;
            }
        };

        FROST_DEBUG_COINS_NUMERIC_FIELDS.forEach(field => {
            setField(field, debugCoinsOverrideValues[field]);
        });

        setField('snapshotDate', debugCoinsOverrideValues.snapshotDate);

        return clone || data;
    }

    function frostReadDebugCoinsForm() {
        const readNumber = (id, label) => {
            const el = document.getElementById(id);
            const raw = String(el?.value ?? '').trim();
            const value = Number(raw);

            if (!raw || !Number.isFinite(value)) {
                throw new Error(`${label} must be a finite number`);
            }
            return value;
        };

        const snapshot = String(
            document.getElementById('debugCoinsSnapshotDateInput')?.value ?? ''
        ).trim();

        if (!snapshot) {
            throw new Error('Snapshot Date cannot be empty');
        }

        return {
            adjustBy: readNumber('debugCoinsAdjustByInput','adjustBy'),
            coinsBefore: readNumber('debugCoinsBeforeInput','coinsBefore'),
            coinsAfter: readNumber('debugCoinsAfterInput','coinsAfter'),
            numFilteredAdjust: readNumber('debugCoinsFilteredInput','numFilteredAdjust'),
            snapshotDate: snapshot,
            coinChecksum: readNumber('debugCoinsChecksumInput','coinChecksum')
        };
    }

