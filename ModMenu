    function executeConsoleCommand() {
        const input = document.getElementById('consoleInput');
        if (!input) return;
        const command = input.value.trim();
        if (!command) return;

        const output = document.getElementById('consoleOutput');
        if (!output) return;

        const isDark = currentTheme !== 'standard';

        consoleCommandHistory.push(command);
        consoleHistoryIndex = consoleCommandHistory.length;

        const commandEntry = document.createElement('div');
        commandEntry.style.cssText = `
            color: ${isDark ? '#60a5fa' : '#3b82f6'};
            font-family: 'Inter', monospace;
            font-size: 11px;
            padding: 2px 0;
        `;
        commandEntry.textContent = `> ${command}`;
        output.appendChild(commandEntry);

        try {
            let result;
            if (command === 'clear' || command === 'cls') {
                output.innerHTML = '';
                input.value = '';
                return;
            }
            if (command === 'help') {
                result = `
Available commands:
  help          - Show this help
  clear / cls   - Clear console
  log           - Show log object
  events        - Show captured events
  events clear  - Clear events
  window        - Show window object
  document      - Show document object
  [any JS]      - Execute JavaScript
                `;
            } else if (command === 'log') {
                result = typeof log !== 'undefined' ? log : 'log not found';
            } else if (command === 'events') {
                result = capturedEvents;
            } else if (command === 'events clear') {
                clearEvents();
                result = 'Events cleared';
            } else if (command === 'window') {
                result = window;
            } else if (command === 'document') {
                result = document;
            } else {
                result = Function('"use strict"; return (' + command + ')')();
            }

            const resultEntry = document.createElement('div');
            resultEntry.style.cssText = `
                color: ${isDark ? '#f3f4f6' : '#111827'};
                font-family: 'Inter', monospace;
                font-size: 11px;
                padding: 2px 0 2px 16px;
                white-space: pre-wrap;
                word-break: break-all;
                border-left: 2px solid ${isDark ? '#374151' : '#e5e7eb'};
                padding-left: 12px;
                margin: 2px 0 4px 0;
            `;
            resultEntry.textContent = typeof result === 'object' ? JSON.stringify(result, null, 2) : String(result);
            output.appendChild(resultEntry);
        } catch(e) {
            const errorEntry = document.createElement('div');
            errorEntry.style.cssText = `
                color: #ef4444;
                font-family: 'Inter', monospace;
                font-size: 11px;
                padding: 2px 0 2px 16px;
                border-left: 2px solid #ef4444;
                padding-left: 12px;
                margin: 2px 0 4px 0;
            `;
            errorEntry.textContent = `Error: ${e.message}`;
            output.appendChild(errorEntry);
        }

        output.scrollTop = output.scrollHeight;
        input.value = '';
    }

    function consoleKeyDown(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            executeConsoleCommand();
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (consoleCommandHistory.length > 0) {
                consoleHistoryIndex = Math.max(0, consoleHistoryIndex - 1);
                const input = document.getElementById('consoleInput');
                if (input) {
                    input.value = consoleCommandHistory[consoleHistoryIndex] || '';
                }
            }
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (consoleCommandHistory.length > 0) {
                consoleHistoryIndex = Math.min(consoleCommandHistory.length, consoleHistoryIndex + 1);
                const input = document.getElementById('consoleInput');
                if (input) {
                    input.value = consoleHistoryIndex < consoleCommandHistory.length ? consoleCommandHistory[consoleHistoryIndex] : '';
                }
            }
        }
    }

