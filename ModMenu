        @keyframes wobbleDragContinuous {
            0% { transform: scale(1.02) rotate(0deg); }
            25% { transform: scale(1.03) rotate(-1.2deg); }
            50% { transform: scale(1.04) rotate(1.2deg); }
            75% { transform: scale(1.03) rotate(-0.8deg); }
            100% { transform: scale(1.02) rotate(0deg); }
        }

        #modMenuContainer.dragging-end {
