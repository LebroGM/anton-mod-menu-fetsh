    const FROST_V29_GROUPS={
        HOME:['general'],
        MODS:['currencies','level','games','antonplus','account','support','avatar','sounds','session'],
        DEVELOPER:['autoclicker','eventlistener','eventsender','apifetcher','keylogger','keyinspector','console','searchevent','calculator','texture','website'],
        Nineytone:['jkeybinds','themes','effects','customize','backgrounds','layout','audiostudio','notifications','accessibility'],
        STUDIO:['tabmanager','hud','themebuilder','statuscenter','sessioncenter','macros','backup','urltools','jsonlab','uiplayground','plugins','translation','docs'],
        SYSTEM:['destroy']
    };

    // Developer Mode owns BOTH developer workspaces. STUDIO contains advanced
    // tools such as UI Macros, JSON Lab and UI Playground, so it must never be
    // exposed while Developer Mode is disabled.
    const FROST_V29_DEVELOPER_GROUPS=new Set(['DEVELOPER','STUDIO']);
    const FROST_V29_DEVELOPER_SECTIONS=new Set(
        [...FROST_V29_GROUPS.DEVELOPER,...FROST_V29_GROUPS.STUDIO]
    );

    function frostV29IsDeveloperSection(section){
        return !!section&&FROST_V29_DEVELOPER_SECTIONS.has(section);
    }

    // Rebuild/normalize every sidebar tab from the canonical group model.
    // This removes duplicate legacy buttons, restores missing tabs, refreshes
    // labels/icons and gives every tab one predictable v29 route binding.
    function frostV29RemakeSidebarTabs(){
        const sidebar=document.getElementById('modMenuSidebar');
        if(!sidebar)return;

        const allSections=[...new Set(Object.values(FROST_V29_GROUPS).flat())];

        allSections.forEach(section=>{
            let matches=[...sidebar.querySelectorAll(`.sidebar-item[data-section="${section}"]`)];
            let button=matches.find(x=>x.classList.contains('active'))||matches[0]||null;

            if(button){
                matches.filter(x=>x!==button).forEach(x=>x.remove());
            }else{
                const registry=FROST_SAFE_TABS.find(row=>row[0]===section);
                const technical=(typeof FROST_V29_ICON_PACKS==='object'&&FROST_V29_ICON_PACKS.technical)
                    ?FROST_V29_ICON_PACKS.technical[section]
                    :null;
                const icon=registry?.[1]||technical||String(section).slice(0,3).toUpperCase();
                button=frostV28EnsureSidebarButton(section,icon,frostV28NavLabel(section));
            }

            if(!button)return;

            button.type='button';
            button.dataset.section=section;
            button.classList.add('sidebar-item','frost-v29-tab','n91-remade-tab');

            let iconEl=button.querySelector('.icon');
            if(!iconEl){
                iconEl=document.createElement('span');
                iconEl.className='icon';
                button.prepend(iconEl);
            }

            let labelEl=button.querySelector('.label');
            if(!labelEl){
                labelEl=document.createElement('span');
                labelEl.className='label';
                button.appendChild(labelEl);
            }

            labelEl.textContent=frostV28NavLabel(section);
            button.setAttribute('aria-label',frostV28NavLabel(section));

            if(!button.dataset.n91RouteBound){
                button.dataset.n91RouteBound='1';
                button.addEventListener('click',()=>switchSection(section));
            }
        });

        frostV29ApplyIconPack();
    }

