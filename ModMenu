    function frostV32PruneSettingsJunk(){
        const sidebar=document.getElementById('modMenuSidebar');
        const content=document.getElementById('modMenuContent');
        FROST_V32_REMOVED_SETTINGS_TABS.forEach(section=>{
            sidebar?.querySelectorAll(`.sidebar-item[data-section="${section}"]`).forEach(x=>x.remove());
            content?.querySelectorAll(`.section-panel[data-section="${section}"]`).forEach(x=>x.remove());
        });
        const removed=new Set(FROST_V32_REMOVED_SETTINGS_TABS);
        frostV29.hiddenTabs=(frostV29.hiddenTabs||[]).filter(x=>!removed.has(x));
        frostV29.tabOrder=(frostV29.tabOrder||[]).filter(x=>!removed.has(x));
        frostV29.favoriteTabs=(frostV29.favoriteTabs||[]).filter(x=>!removed.has(x));
        frostV29.recentFeatures=(frostV29.recentFeatures||[]).filter(x=>!removed.has(x.section));
        frostV29.pinnedFeatures=(frostV29.pinnedFeatures||[]).filter(k=>!FROST_V32_REMOVED_SETTINGS_TABS.some(sec=>String(k).startsWith(sec+'#')||String(k).startsWith(sec+':')));
        for(let i=FROST_COMMANDS.length-1;i>=0;i--){if(removed.has(FROST_COMMANDS[i]?.section))FROST_COMMANDS.splice(i,1)}
        frostV29Save();
    }

    function frostV32InstallReliableSidebarRouter(){
        const sidebar=document.getElementById('modMenuSidebar');if(!sidebar||sidebar.dataset.n91ReliableRouter==='1')return;
        sidebar.dataset.n91ReliableRouter='1';
        sidebar.addEventListener('click',e=>{
            const button=e.target.closest('.sidebar-item[data-section]');
            if(!button||button.hidden||button.classList.contains('n91-developer-hidden')||button.classList.contains('frost-v29-hidden-tab'))return;
            e.preventDefault();
            e.stopPropagation();
            switchSection(button.dataset.section);
        },true);
    }

