function playSound(type) {
    try {
        const frostAudioSettings = window.__frostUiSettings || {};
        if (frostAudioSettings.uiSoundEnabled === false) return;
        if (Number.isFinite(Number(frostAudioSettings.uiSoundVolume))) {
            menuSound.volume = Math.max(0, Math.min(1, Number(frostAudioSettings.uiSoundVolume)));
        }
        if (soundLocked) return;

        soundLocked = true;

        menuSound.pause();
        menuSound.currentTime = 0;

        menuSound.play().catch(err => {
            console.warn("[SOUND] Could not play audio:", err);
        });

        clearTimeout(unlockTimer);

        unlockTimer = setTimeout(() => {
            soundLocked = false;
        }, SOUND_LOCK_TIME);

    } catch (e) {
        console.warn("[SOUND] Error:", e);
        soundLocked = false;
    }
}

