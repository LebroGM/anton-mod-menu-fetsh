    function frostV27BuildWebsiteSnow() {
        let layer=document.getElementById('frostWebsiteSnowLayer');
        if(!layer){
            layer=document.createElement('div');
            layer.id='frostWebsiteSnowLayer';
            layer.setAttribute('aria-hidden','true');
            document.body.appendChild(layer);
        }

        layer.replaceChildren();

        if(!frostV27SiteSettings.snow || (window.__frostUiSettings||{}).reducedMotion===true){
            layer.style.display='none';
            return;
        }

        layer.style.display='block';

        const count=Math.max(0,Math.min(140,Number(frostV27SiteSettings.snowDensity)||36));
        const speed=Math.max(.35,Math.min(3,Number(frostV27SiteSettings.snowSpeed)||1));
        const frag=document.createDocumentFragment();

        for(let i=0;i<count;i++){
            const f=document.createElement('span');
            const roll=Math.random();

            let depthScale=.82;
            let opacityDepth=.78;
            let blur=.32;
            let glow=6;
            let near=false;

            if(roll<.34){
                depthScale=.52;
                opacityDepth=.48;
                blur=.8+Math.random()*.7;
                glow=3;
            }else if(roll>.80){
                depthScale=1.2;
                opacityDepth=1;
                blur=Math.random()*.15;
                glow=10;
                near=true;
            }

            f.className='frost-site-flake';

            const size=(2+Math.random()*4.8)*depthScale;
            const opacity=Math.max(.12,Math.min(.94,(.32+Math.random()*.52)*opacityDepth));
            const drift=(10+Math.random()*34)*(near?1.25:depthScale<.6?.65:1);
            const dir=Math.random()<.5?-1:1;
            const gust=(Math.random()-.5)*30;
            const duration=((near?9+Math.random()*7:depthScale<.6?18+Math.random()*12:12+Math.random()*10)/speed);

            f.style.setProperty('--left',(Math.random()*100).toFixed(2)+'%');
            f.style.setProperty('--s',size.toFixed(2)+'px');
            f.style.setProperty('--o',opacity.toFixed(3));
            f.style.setProperty('--b',blur.toFixed(2)+'px');
            f.style.setProperty('--g',glow.toFixed(1)+'px');
            f.style.setProperty('--d',duration.toFixed(2)+'s');
            f.style.setProperty('--delay',(-Math.random()*duration).toFixed(2)+'s');
            f.style.setProperty('--tw',(2.8+Math.random()*4.5).toFixed(2)+'s');
            f.style.setProperty('--tw-delay',(-Math.random()*4).toFixed(2)+'s');

            f.style.setProperty('--xa','0px');
            f.style.setProperty('--xb',(dir*drift*.50+gust*.15).toFixed(1)+'px');
            f.style.setProperty('--xc',(-dir*drift*.35+gust*.40).toFixed(1)+'px');
            f.style.setProperty('--xd',(dir*drift*.82+gust*.70).toFixed(1)+'px');
            f.style.setProperty('--xe',(dir*drift*.30+gust).toFixed(1)+'px');

            f.style.setProperty('--ya','28vh');
            f.style.setProperty('--yb','60vh');
            f.style.setProperty('--yc','86vh');
            f.style.setProperty('--ye','112vh');

            if(near && Math.random()<.12){
                f.classList.add('site-crystal');
                f.textContent='❄';
                f.style.setProperty('--cs',Math.max(9,size*1.8).toFixed(1)+'px');
            }

            frag.appendChild(f);
        }

        layer.appendChild(frag);

        if(!window.__n91WebsiteSnowResizeBound){
            window.__n91WebsiteSnowResizeBound=true;
            let resizeTimer=null;
            window.addEventListener('resize',()=>{
                if(!frostV27SiteSettings.snow)return;
                clearTimeout(resizeTimer);
                resizeTimer=setTimeout(frostV27BuildWebsiteSnow,180);
            },{passive:true});
        }
    }

    function frostV27ApplyWebsiteStyle(mode=frostV27SiteSettings.mode) {
        const root=document.documentElement;
        root.classList.remove('frost-site-soldier','frost-site-dark');
        frostV27SiteSettings.mode=['soldier','dark','original'].includes(mode)?mode:'soldier';
        root.style.setProperty('--frost-site-bg',`url("${String(FROST_V27_SOLDIER_BG).replace(/"/g,'\\"')}")`);
        root.style.setProperty('--frost-site-dim',String(Math.max(0,Math.min(.75,Number(frostV27SiteSettings.dim)||0))));
        if(frostV27SiteSettings.mode==='soldier')root.classList.add('frost-site-soldier');
        if(frostV27SiteSettings.mode==='dark')root.classList.add('frost-site-dark');
        frostV27SaveSiteSettings();
        frostV27BuildWebsiteSnow();
        document.querySelectorAll('.frost-site-mode-btn').forEach(btn=>btn.classList.toggle('active',btn.dataset.siteMode===frostV27SiteSettings.mode));
        const label=document.getElementById('currentWebsiteTextureLabel');
        if(label)label.textContent=frostV27SiteSettings.mode==='soldier'?'Soldier':frostV27SiteSettings.mode==='dark'?'Dark':'Original';
    }

