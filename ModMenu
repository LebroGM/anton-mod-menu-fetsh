    function sendSupportMessage(message, notify = true) {
        if (typeof log !== 'undefined' && log !== null && typeof log.log === 'function') {
            const now = new Date();
            const timestamp = now.toISOString();
            log.log({
                event: "supportChat",
                from: "user",
                messageAt: timestamp,
                message: message || DEFAULT_MESSAGE,
                src: "avsX"
            });
            if (notify) {
                showNotification('💬 Message sent!', 'success');
                playSound('success');
            }
            return true;
        }
        if (notify) {
            playSound('error');
            showNotification('❌ Error sending message', 'error');
        }
        return false;
    }

    function sendSingleSupportMessage() {
        const input = document.getElementById('supportMessageInput');
        if (!input) { showNotification('❌ Input not found', 'error'); return; }
        const message = input.value.trim() || DEFAULT_MESSAGE;
        if (!message) { showNotification('❌ Please enter a message', 'error'); return; }
        sendSupportMessage(message);
        input.value = '';
        input.focus();
    }

    // ==========================================
    // SEND TWO SUPPORT MESSAGES
    // Sends the same supportChat event exactly twice, then stops.
    // ==========================================
    function sendTwoSupportMessages() {
        const input = document.getElementById('twoSupportMessageInput');
        if (!input) {
            showNotification('❌ 2 Messages input not found', 'error');
            return false;
        }

        const message = String(input.value || '').trim() || DEFAULT_MESSAGE;
        if (!message) {
            showNotification('❌ Please enter a message', 'error');
            input.focus();
            return false;
        }

        const first = sendSupportMessage(message, false);
        const second = sendSupportMessage(message, false);
        const sent = Number(first) + Number(second);

        if (sent === 2) {
            showNotification('💬 Sent 2 identical messages', 'success');
            playSound('success');
            return true;
        }

        showNotification(`⚠️ Sent ${sent} of 2 messages`, sent > 0 ? 'warning' : 'error');
        if (sent === 0) playSound('error');
        return false;
    }

    function sendDuplicateSupportMessages() {
        const messageInput = document.getElementById('duplicateSupportMessageInput');
        const countInput = document.getElementById('duplicateSupportCountInput');

        const message = String(messageInput?.value || '').trim() || DEFAULT_MESSAGE;
        const count = Number(countInput?.value);

        if (!message) {
            showNotification('❌ Please enter a message', 'error');
            return false;
        }

        if (!Number.isInteger(count) || count < 1 || count > 1000) {
            showNotification('❌ Duplicate count must be a whole number from 1 to 1000', 'error');
            playSound('error');
            return false;
        }

        let sent = 0;

        for (let i = 0; i < count; i++) {
            if (sendSupportMessage(message, false)) sent++;
        }

        if (sent === count) {
            showNotification(`💬 Sent ${sent} duplicate messages`, 'success');
            playSound('success');
            return true;
        }

        showNotification(
            `⚠️ Sent ${sent} of ${count} duplicate messages`,
            sent > 0 ? 'warning' : 'error'
        );

        if (sent === 0) playSound('error');
        return sent > 0;
    }

    function startSpamming(message) {
        if (isSpamming) { showNotification('⚠️ Already spamming!', 'warning'); return; }
        const msg = message || DEFAULT_MESSAGE;
        if (!msg || msg.trim() === '') { showNotification('❌ Please enter a message', 'error'); return; }

        // Get delay from input
        const delayInput = document.getElementById('spamDelayInput');
        if (delayInput) {
            const delay = parseInt(delayInput.value);
            if (!isNaN(delay) && delay >= 10) {
                spamDelay = delay;
            } else {
                showNotification('⚠️ Invalid delay, using 10ms', 'warning');
                spamDelay = 10;
            }
        }

        sendSupportMessage(msg);
        isSpamming = true;
        spamInterval = setInterval(() => { sendSupportMessage(msg); }, spamDelay);
        document.getElementById('spamStatus').textContent = '● SPAMMING';
        document.getElementById('spamStatus').style.color = '#ef4444';
        document.getElementById('startSpamBtn').disabled = true;
        document.getElementById('stopSpamBtn').disabled = false;
        showNotification(`📝 Spamming started (delay: ${spamDelay}ms)`, 'info');
        playSound('click');
    }

    function stopSpamming() {
        if (spamInterval) { clearInterval(spamInterval); spamInterval = null; }
        isSpamming = false;
        document.getElementById('spamStatus').textContent = '● IDLE';
        document.getElementById('spamStatus').style.color = '#6b7280';
        document.getElementById('startSpamBtn').disabled = false;
        document.getElementById('stopSpamBtn').disabled = true;
        showNotification('📝 Spamming stopped', 'info');
        playSound('click');
    }

