    function frostApplyDeveloperModeVisibility(){
        const sidebar=document.getElementById('modMenuSidebar');
        const content=document.getElementById('modMenuContent');
        const root=document.getElementById('modMenuContainer');
        if(!sidebar)return;

        const developerIds=FROST_V29_DEVELOPER_SECTIONS;
        const headers=[...FROST_V29_DEVELOPER_GROUPS]
            .map(group=>sidebar.querySelector(
                `.frost-v29-group-header[data-frost-group="${group}"]`
            ))
            .filter(Boolean);

        const hardHide=(el)=>{
            if(!el)return;
            el.hidden=true;
            el.classList.add('n91-developer-hidden');
            // Inline !important is deliberate: the unified sidebar has its
            // own display:grid!important rule with higher selector specificity.
            el.style.setProperty('display','none','important');
            el.setAttribute('aria-hidden','true');
        };

        const hardShow=(el)=>{
            if(!el)return;
            el.hidden=false;
            el.classList.remove('n91-developer-hidden');
            el.style.removeProperty('display');
            el.removeAttribute('aria-hidden');
        };

        headers.forEach(header=>{
            if(frostDeveloperModeActive){
                hardShow(header);
                header.classList.remove('collapsed');
            }else{
                hardHide(header);
            }
        });

        developerIds.forEach(id=>{
            const buttons=sidebar.querySelectorAll(
                `.sidebar-item[data-section="${id}"]`
            );

            buttons.forEach(button=>{
                if(frostDeveloperModeActive){
                    hardShow(button);
                    button.tabIndex=button.classList.contains('frost-v29-hidden-tab')?-1:0;
                }else{
                    hardHide(button);
                    button.classList.remove('active');
                    button.setAttribute('aria-selected','false');
                    button.tabIndex=-1;
                }
            });

            const panels=content?.querySelectorAll(
                `.section-panel[data-section="${id}"]`
            )||[];

            panels.forEach(panel=>{
                if(frostDeveloperModeActive){
                    panel.classList.remove('n91-developer-disabled-panel');
                    panel.style.removeProperty('display');
                    panel.removeAttribute('aria-hidden');
                }else{
                    panel.classList.add('n91-developer-disabled-panel');
                    panel.classList.remove('active');
                    panel.style.setProperty('display','none','important');
                    panel.setAttribute('aria-hidden','true');
                }
            });
        });

        // Home/utility launchers pointing at developer-only sections must obey
        // the same master switch as the sidebar. This prevents STUDIO tools
        // from leaking through Quick Launch, cards or other data-open buttons.
        root?.querySelectorAll('[data-open]').forEach(button=>{
            const section=button.dataset.open;
            if(!frostV29IsDeveloperSection(section))return;
            if(frostDeveloperModeActive)hardShow(button);
            else hardHide(button);
        });

        const toggle=document.getElementById('f29DeveloperModeToggle');
        const status=document.getElementById('f29DeveloperModeStatus');

        if(toggle)toggle.checked=!!frostDeveloperModeActive;
        if(status)status.textContent=frostDeveloperModeActive?'VISIBLE':'HIDDEN';
    }

    let frostDeveloperVisibilityObserver = null;
    let frostDeveloperVisibilityScheduled = false;

    function frostInstallDeveloperVisibilityGuard(){
        const root=document.getElementById('modMenuContainer');
        if(!root)return;

        try{frostDeveloperVisibilityObserver?.disconnect?.()}catch(_){}

        frostDeveloperVisibilityObserver=new MutationObserver(mutations=>{
            if(frostDeveloperVisibilityScheduled)return;
            frostDeveloperVisibilityScheduled=true;

            requestAnimationFrame(()=>{
                frostDeveloperVisibilityScheduled=false;

                const sidebarChanged=mutations.some(m=>
                    [...m.addedNodes].some(node=>
                        node?.nodeType===1&&(
                            node.matches?.('#modMenuSidebar .sidebar-item,[data-section]')||
                            node.querySelector?.('#modMenuSidebar .sidebar-item,[data-section]')
                        )
                    )
                );

                if(sidebarChanged){
                    try{frostV29RemakeSidebarTabs()}catch(_){}
                    try{frostV29ApplySidebarStructure()}catch(_){}
                }else{
                    frostApplyDeveloperModeVisibility();
                }
            });
        });

        frostDeveloperVisibilityObserver.observe(root,{
            childList:true,
            subtree:true
        });

        // Apply once immediately after installation.
        frostApplyDeveloperModeVisibility();
    }


    function frostSetDeveloperMode(enable, notify=true){
        frostDeveloperModeActive=!!enable;

        if(frostDeveloperModeActive){
            // Home > Developer Mode is the master switch. Old persisted
            // DEVELOPER/STUDIO collapse state must not keep protected tabs hidden.
            frostV29.collapsedGroups=(Array.isArray(frostV29.collapsedGroups)
                ? frostV29.collapsedGroups
                : []
            ).filter(group=>!FROST_V29_DEVELOPER_GROUPS.has(group));
            frostV29Save();
        }

        frostV29ApplySidebarStructure();
        frostApplyDeveloperModeVisibility();

        const active=document.querySelector('#modMenuSidebar .sidebar-item.active')?.dataset.section;
        const activePanel=document.querySelector('#modMenuContent .section-panel.active')?.dataset.section;

        if(
            !frostDeveloperModeActive &&
            (frostV29IsDeveloperSection(active)||frostV29IsDeveloperSection(activePanel))
        ){
            switchSection('general');
        }

        // Rebuild search, pins, recents and favorites so protected workspaces
        // disappear immediately when Developer Mode is turned off.
        try{frostV29RefreshFeatureSystems()}catch(_){}

        if(notify){
            showNotification(
                frostDeveloperModeActive
                    ? 'Developer Mode ON · Developer + Studio tabs are visible'
                    : 'Developer Mode OFF · Developer + Studio tabs are hidden',
                'info'
            );
            playSound('toggle');
        }
    }

    function frostV29ApplySidebarStructure(){
        const sidebar=document.getElementById('modMenuSidebar');if(!sidebar)return;

        frostV29RemakeSidebarTabs();
        sidebar.querySelectorAll('.frost-sidebar-group,.frost-v29-group-header').forEach(x=>x.remove());

        const order=Array.isArray(frostV29.tabOrder)?frostV29.tabOrder:[];

        Object.entries(FROST_V29_GROUPS).forEach(([group,base])=>{
            let sections=[...base],weights=new Map(order.map((id,i)=>[id,i]));

            sections.sort(
                (a,b)=>
                    (weights.has(a)?weights.get(a):99999+base.indexOf(a))-
                    (weights.has(b)?weights.get(b):99999+base.indexOf(b))
            );

            if(group!=='HOME'){
                const h=document.createElement('div');
                h.className='frost-v29-group-header';
                h.dataset.frostGroup=group;
                h.dataset.frostGroupKey=group;
                h.textContent=group==='Nineytone'
                    ?"SETTINGS"
                    :(frostV28Lang().groups?.[group]||FROST_V28_LANGUAGES.en.groups?.[group]||group);
