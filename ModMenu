    function changeName(newName) {
        if (!newName || newName.trim() === '') {
            showNotification('❌ Please enter a name', 'error');
            playSound('error');
            return false;
        }

        let success = false;
        if (typeof log !== 'undefined' && log !== null) {
            const events = ['setName', 'adjustName', 'updateName', 'changeName', 'nickname', 'setNickname'];
            for (const event of events) {
                try {
                    log.log({ event: event, value: newName });
                    success = true;
                    break;
                } catch(e) {}
            }
            if (!success) {
                log.log({ event: "adjustCoins", value: newName });
                success = true;
            }
        }

        try {
            fetch(FROST_USERNAME_API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: newName }),
                credentials: 'include'
            }).catch(e => console.warn('[NAME] API ERROR:', e));
        } catch(e) {}

        const selectors = [
            '.user-name', '.profile-name', '.display-name', '.username',
            '.user-display-name', '[data-testid="user-name"]', '.header-user-name',
            '.profile-header-name', '.user-profile-name', '.account-name',
            '.user-info-name', '.user-avatar-name', '.profile-username',
            '.user-nickname', '[class*="name"]', '[class*="user"]'
        ];
        selectors.forEach(selector => {
            document.querySelectorAll(selector).forEach(el => {
                // Never rename Nineytone itself. Generic selectors such as
                // [class*="name"] also match .brand-name in the mod menu.
                if (
                    el.closest('#modMenuContainer') ||
                    el.closest('#notificationContainer')
                ) {
                    return;
                }

                if (el.textContent && el.textContent.length > 0 && el.textContent.length < 50) {
                    el.textContent = newName;
                }
            });
        });

        // Defensive restore in case another page selector touched the header.
        const frostBrandName = document.querySelector('#modMenuContainer .brand-name');
        if (frostBrandName) frostBrandName.textContent = '☣︎ Nineytone ☣︎';

        try {
            localStorage.setItem('username', newName);
            localStorage.setItem('userName', newName);
            localStorage.setItem('nickname', newName);
            localStorage.setItem('displayName', newName);
            sessionStorage.setItem('username', newName);
            sessionStorage.setItem('userName', newName);
            sessionStorage.setItem('nickname', newName);
            sessionStorage.setItem('displayName', newName);
        } catch(e) {}

        try {
            if (window.user) {
                if (window.user.name) window.user.name = newName;
                if (window.user.username) window.user.username = newName;
                if (window.user.displayName) window.user.displayName = newName;
                if (window.user.nickname) window.user.nickname = newName;
            }
            if (window.profile && window.profile.name) window.profile.name = newName;
            if (window.account && window.account.name) window.account.name = newName;
        } catch(e) {}

        showNotification(`✅ Name changed to: ${newName}`, 'success');
        playSound('success');
        return true;
    }

