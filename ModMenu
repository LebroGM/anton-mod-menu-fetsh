    function frostV29WrapSwitchSection(){
        if(window.__f29SwitchWrapped)return;window.__f29SwitchWrapped=true;
        const base=switchSection;

        switchSection=function(sectionName){
            if(
                frostV29IsDeveloperSection(sectionName) &&
                !frostDeveloperModeActive
            ){
                showNotification('Enable Developer Mode on Home to open Developer / Studio tabs','info');
                return false;
            }

            const result=base(sectionName);

            frostV29TabOpens++;
            frostV29RecordRecent({type:'tab',section:sectionName,label:frostV28NavLabel(sectionName)});
            frostV29UpdateBreadcrumb(sectionName);
            setTimeout(()=>{frostV29DecorateFeaturePins();frostV29DecorateTooltips();},0);

            return result;
        };
    }

    function frostV29EnhanceCommandPalette(){
