// ==========================================
// SNOW EFFECT
// ==========================================
let n91SnowResizeObserver = null;
let n91SnowResizeTimer = null;

function initSnowEffect() {
    const snowLayer = document.getElementById('modMenuSnowLayer');
    const menu = document.getElementById('modMenuContainer');
    if (!snowLayer || !menu) return;

    const settings = window.__frostUiSettings || {};

    snowLayer.replaceChildren();

    if (settings.snowEnabled === false || settings.reducedMotion === true) {
        snowLayer.style.display = 'none';
        return;
    }

    snowLayer.style.display = '';

    const rawDensity = Number(settings.snowDensity);
    const rawSpeed = Number(settings.snowSpeed);
    const rawSize = Number(settings.snowSize);
    const rawOpacity = Number(settings.snowOpacity);

    const flakeCount = Math.max(0, Math.min(110, Number.isFinite(rawDensity) ? rawDensity : 28));
    const speed = Math.max(.35, Math.min(2.8, Number.isFinite(rawSpeed) ? rawSpeed : 1));
    const sizeScale = Math.max(.45, Math.min(2.2, Number.isFinite(rawSize) ? rawSize : 1));
    const opacityScale = Math.max(.2, Math.min(1, Number.isFinite(rawOpacity) ? rawOpacity : 1));

    const rect = snowLayer.getBoundingClientRect();
    const height = Math.max(320, rect.height || menu.clientHeight || 720);
    const width = Math.max(320, rect.width || menu.clientWidth || 920);
    const fallEnd = height + 70;

    snowLayer.dataset.snowWidth = String(Math.round(width));
    snowLayer.dataset.snowHeight = String(Math.round(height));

    const frag = document.createDocumentFragment();

    for (let i = 0; i < flakeCount; i++) {
        const flake = document.createElement('span');
        const roll = Math.random();

        let depth = 'mid';
        let depthScale = .82;
        let opacityDepth = .78;
        let blur = .35;
        let glow = 6;

        if (roll < .34) {
            depth = 'far';
            depthScale = .55;
            opacityDepth = .48;
            blur = .9 + Math.random() * .6;
            glow = 3;
        } else if (roll > .79) {
            depth = 'near';
            depthScale = 1.18;
            opacityDepth = 1;
            blur = Math.random() * .18;
            glow = 9 + Math.random() * 5;
        }

        flake.className = `snowflake snow-${depth}`;

        const baseSize = (2.1 + Math.random() * 4.5) * sizeScale * depthScale;
        const opacity = Math.max(.12, Math.min(.96, (.34 + Math.random() * .52) * opacityScale * opacityDepth));

        const driftBase = (8 + Math.random() * 24) * (depth === 'near' ? 1.25 : depth === 'far' ? .65 : 1);
        const direction = Math.random() < .5 ? -1 : 1;
        const gust = (Math.random() - .5) * 22;

        const durationBase =
            depth === 'far' ? 17 + Math.random() * 11 :
            depth === 'near' ? 9 + Math.random() * 7 :
            12 + Math.random() * 9;

        const duration = durationBase / speed;

        flake.style.setProperty('--left', (Math.random() * 100).toFixed(2) + '%');
        flake.style.setProperty('--size', baseSize.toFixed(2) + 'px');
        flake.style.setProperty('--opacity', opacity.toFixed(3));
        flake.style.setProperty('--blur', blur.toFixed(2) + 'px');
        flake.style.setProperty('--glow', glow.toFixed(1) + 'px');
        flake.style.setProperty('--duration', duration.toFixed(2) + 's');
        flake.style.setProperty('--delay', (-Math.random() * duration).toFixed(2) + 's');
        flake.style.setProperty('--twinkle', (2.6 + Math.random() * 4.2).toFixed(2) + 's');
        flake.style.setProperty('--twinkle-delay', (-Math.random() * 4).toFixed(2) + 's');

        flake.style.setProperty('--drift-a', '0px');
        flake.style.setProperty('--drift-b', (direction * driftBase * .55 + gust * .15).toFixed(1) + 'px');
        flake.style.setProperty('--drift-c', (-direction * driftBase * .35 + gust * .42).toFixed(1) + 'px');
        flake.style.setProperty('--drift-d', (direction * driftBase * .82 + gust * .70).toFixed(1) + 'px');
        flake.style.setProperty('--drift-e', (direction * driftBase * .28 + gust).toFixed(1) + 'px');

        flake.style.setProperty('--fall-a', (fallEnd * .28).toFixed(1) + 'px');
        flake.style.setProperty('--fall-b', (fallEnd * .58).toFixed(1) + 'px');
        flake.style.setProperty('--fall-c', (fallEnd * .82).toFixed(1) + 'px');
        flake.style.setProperty('--fall-end', fallEnd.toFixed(1) + 'px');

        // A few foreground flakes use a real crystal glyph. Most stay as
        // soft particles so the effect remains clean and performant.
        if (depth === 'near' && Math.random() < .16) {
            flake.classList.add('snow-crystal');
            flake.textContent = '❄';
            flake.style.setProperty('--crystal-size', Math.max(8, baseSize * 1.75).toFixed(1) + 'px');
        }

        frag.appendChild(flake);
    }

    snowLayer.appendChild(frag);

    // Rebuild only when the GUI actually changes size. The old engine used a
