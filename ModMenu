    function frostV29NetStatusMatch(entry,filter){
        if(!filter||filter==='ALL')return true;
        const raw=entry.status;
        if(filter==='ERR')return raw==='ERR'||raw===0||raw===null||raw===undefined;
        const n=Number(raw);
        if(!Number.isFinite(n))return false;
        if(filter==='2xx')return n>=200&&n<300;
        if(filter==='3xx')return n>=300&&n<400;
        if(filter==='4xx')return n>=400&&n<500;
        if(filter==='5xx')return n>=500&&n<600;
        return String(raw)===filter;
    }

    function frostV29FilteredNet(){
        const q=(document.getElementById('f29NetFilter')?.value||'').trim().toLowerCase();
        const source=document.getElementById('f29NetSource')?.value||'ALL';
        const kind=document.getElementById('f29NetKind')?.value||'ALL';
        const method=document.getElementById('f29NetMethod')?.value||'ALL';
        const status=document.getElementById('f29NetStatus')?.value||'ALL';

        return frostV29Net.entries.filter(x=>{
            if(source!=='ALL'&&String(x.source||'PAGE')!==source)return false;
            if(kind!=='ALL'&&String(x.kind||'').toUpperCase()!==kind)return false;
            if(method!=='ALL'&&String(x.method||'').toUpperCase()!==method)return false;
            if(!frostV29NetStatusMatch(x,status))return false;

            if(!q)return true;

            const body=typeof x.requestBody==='string'
                ? x.requestBody
                : JSON.stringify(x.requestBody??'');
            const hay=`${x.source||''} ${x.endpoint||''} ${x.kind||''} ${x.method||''} ${x.url||''} ${x.status||''} ${body}`.toLowerCase();
            return hay.includes(q);
        });
    }

    function frostV29GroupedNet(data){
        if(!frostV29Net.groupDuplicates)return data.map(x=>({...x,__count:1}));

        const map=new Map();
        const order=[];

        data.forEach(x=>{
            const signature=[
                x.source||'PAGE',
                x.endpoint||'',
                x.kind||'',
                x.method||'',
                x.url||'',
                String(x.status)
            ].join('|');

            if(!map.has(signature)){
                const row={...x,__count:1};
                map.set(signature,row);
                order.push(row);
            }else{
                map.get(signature).__count++;
            }
        });

        return order;
    }

