        const button = document.getElementById('createAccountBtn');
        const oldText = button?.textContent || t.button;

        if (button) {
            button.disabled = true;
            button.textContent = '…';
        }

        showNotification(t.sending, 'info');

        try {
            const result = await new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                xhr.__frostGeneratedAccountRequest = true;
                xhr.open('POST', FROST_CREATE_ACCOUNT_API_URL, true);
                xhr.timeout = 15000;

                xhr.onload = () => {
                    const status = Number(xhr.status) || 0;
                    let responseText = '';
                    try { responseText = String(xhr.responseText || ''); } catch (_) {}

                    if (status >= 200 && status < 300) {
                        resolve({
                            status,
                            statusText: xhr.statusText || '',
                            responseText
                        });
                        return;
                    }

                    reject(new Error(
                        `HTTP ${status}${xhr.statusText ? ' ' + xhr.statusText : ''}`
                    ));
                };

                xhr.onerror = () => reject(new Error('XHR network/CORS error'));
                xhr.ontimeout = () => reject(new Error('XHR request timed out'));
                xhr.onabort = () => reject(new Error('XHR request aborted'));

