    let activeDragPointerId = null;
    let dragCaptureElement = null;

    function frostInteractiveDragTarget(target) {
        return !!target?.closest?.(
            'button, input, select, textarea, a, [contenteditable="true"], .resize-handle'
        );
    }

    header.addEventListener('pointerdown', function(e) {
        if (frostInteractiveDragTarget(e.target)) return;
