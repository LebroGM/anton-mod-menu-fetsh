    if (!n91SnowResizeObserver && typeof ResizeObserver === 'function') {
        n91SnowResizeObserver = new ResizeObserver(entries => {
            const entry = entries[0];
            if (!entry) return;

            const layer = document.getElementById('modMenuSnowLayer');
