                        <span class="frost-notice-title">${meta.title}</span>
                        <span class="frost-notice-time">${new Date().toLocaleTimeString([], {
                            hour:'2-digit',
                            minute:'2-digit',
                            second:'2-digit'
                        })}</span>
                        <span class="frost-notice-repeat">×1</span>
                    </div>

                    <div class="frost-notice-message"></div>
                </div>

                <button class="frost-notice-close" type="button" title="Dismiss">×</button>
            </div>

            <div class="frost-notice-progress-track">
                <div class="frost-notice-progress"></div>
            </div>
        `;

        card.querySelector('.frost-notice-message').textContent = text;

        card.__frostNoticeTiming = {
            duration,
            remaining: duration,
            startedAt: performance.now(),
            timer: null
        };

        card.querySelector('.frost-notice-close')?.addEventListener('click', e => {
            e.stopPropagation();
            frostDismissNotice(card);
        });

        card.addEventListener('mouseenter', () => frostPauseNotice(card));
        card.addEventListener('mouseleave', () => frostResumeNotice(card));

        box.appendChild(card);
        frostNoticeLive.set(key, card);
        frostScheduleNotice(card, duration);

        const maxVisible = Math.max(
            1,
            Math.min(8, Number(settings.notificationMaxVisible) || 4)
        );

        while (box.querySelectorAll('.frost-notice-card').length > maxVisible) {
            const oldest = box.querySelector('.frost-notice-card');
            if (!oldest || oldest === card) break;
            frostDismissNotice(oldest, true);
        }

        return card;
    }


