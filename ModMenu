        c('frostSnowEnabled',frostUiSettings.snowEnabled);v('frostSnowDensity',frostUiSettings.snowDensity);x('frostSnowDensityValue',String(frostUiSettings.snowDensity));
        v('frostSnowSpeed',frostUiSettings.snowSpeed);x('frostSnowSpeedValue',Number(frostUiSettings.snowSpeed).toFixed(1)+'×');
