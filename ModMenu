    const resizeHandles = document.querySelectorAll('.resize-handle');
    const RESIZE_MARGIN = 12;

    let isResizing = false;
    let resizeStartX = 0;
    let resizeStartY = 0;
    let startW = 0;
    let startH = 0;
    let startL = 0;
    let startT = 0;
    let resizeDir = '';

    function fitMenuIntoViewport() {
        if (!container || isMinimized) return;

        const rect = container.getBoundingClientRect();
        const maxW = Math.max(1, window.innerWidth - RESIZE_MARGIN * 2);
        const maxH = Math.max(1, window.innerHeight - RESIZE_MARGIN * 2);

        const width = Math.min(rect.width, maxW);
        const height = Math.min(rect.height, maxH);

        const left = Math.min(
            Math.max(RESIZE_MARGIN, rect.left),
            Math.max(RESIZE_MARGIN, window.innerWidth - width - RESIZE_MARGIN)
        );

        const top = Math.min(
            Math.max(RESIZE_MARGIN, rect.top),
            Math.max(RESIZE_MARGIN, window.innerHeight - height - RESIZE_MARGIN)
        );

        container.style.width = width + 'px';
        container.style.height = height + 'px';
        container.style.left = left + 'px';
        container.style.top = top + 'px';
        container.style.transform = 'none';
        container.style.right = 'auto';
        container.style.bottom = 'auto';
    }

    resizeHandles.forEach(handle => {
        handle.addEventListener('pointerdown', function(e) {
            if (isMinimized) return;

            e.preventDefault();
            e.stopPropagation();

            fitMenuIntoViewport();

            const rect = container.getBoundingClientRect();

            isResizing = true;
            resizeDir = this.dataset.resize || '';

            resizeStartX = e.clientX;
            resizeStartY = e.clientY;
            startW = rect.width;
            startH = rect.height;
            startL = rect.left;
            startT = rect.top;

            container.classList.add('resizing');
            document.body.style.userSelect = 'none';

            try {
                this.setPointerCapture?.(e.pointerId);
            } catch (_) {}

            document.addEventListener('pointermove', onResize);
            document.addEventListener('pointerup', onResizeEnd);
            document.addEventListener('pointercancel', onResizeEnd);
        });
    });

    function onResize(e) {
        if (!isResizing || isMinimized) return;

        const dx = e.clientX - resizeStartX;
        const dy = e.clientY - resizeStartY;

        const viewportRight = window.innerWidth - RESIZE_MARGIN;
        const viewportBottom = window.innerHeight - RESIZE_MARGIN;

        const maxW = Math.max(1, window.innerWidth - RESIZE_MARGIN * 2);
        const maxH = Math.max(1, window.innerHeight - RESIZE_MARGIN * 2);

        const minW = Math.min(720, maxW);
        const minH = Math.min(700, maxH);

        let left = startL;
        let top = startT;
        let right = startL + startW;
        let bottom = startT + startH;

        if (resizeDir.includes('e')) {
            right = Math.min(
                viewportRight,
                Math.max(left + minW, startL + startW + dx)
            );
        }

        if (resizeDir.includes('w')) {
            left = Math.max(
                RESIZE_MARGIN,
                Math.min(right - minW, startL + dx)
            );
        }

        if (resizeDir.includes('s')) {
            bottom = Math.min(
                viewportBottom,
                Math.max(top + minH, startT + startH + dy)
            );
        }

        if (resizeDir.includes('n')) {
            top = Math.max(
                RESIZE_MARGIN,
                Math.min(bottom - minH, startT + dy)
            );
        }

        const newW = Math.min(maxW, right - left);
        const newH = Math.min(maxH, bottom - top);

        container.style.width = newW + 'px';
        container.style.height = newH + 'px';
        container.style.left = left + 'px';
        container.style.top = top + 'px';
        container.style.transform = 'none';
        container.style.right = 'auto';
        container.style.bottom = 'auto';
