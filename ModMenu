        const rows=FROST_COMMANDS.filter(c=>{
            if(c.section&&!frostDeveloperModeActive&&frostV29IsDeveloperSection(c.section))return false;
            return !q||c.label.toLowerCase().includes(q)||c.keywords.includes(q);
        }).slice(0,18);
        host.innerHTML=rows.length?rows.map((c,i)=>`<button class="frost-command-result ${i===0?'active':''}" data-command-index="${FROST_COMMANDS.indexOf(c)}"><span>›</span>${frostEscapeHtml(c.label)}<code>${c.hint}</code></button>`).join(''):'<div class="frost-muted" style="padding:12px">No command found.</div>';
        host.querySelectorAll('[data-command-index]').forEach(b=>b.addEventListener('click',()=>{const c=FROST_COMMANDS[+b.dataset.commandIndex];closeFrostCommandPalette();c?.run();}));
