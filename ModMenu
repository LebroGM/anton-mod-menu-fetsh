    function frostV28BuildMusic() {
        const panel = frostV28EnsurePanel('music');
        if (!panel) return;
        panel.innerHTML = `
            <div class="panel-title"><span class="title-icon">♫</span> Music</div>
            <div class="frost-v27-intro">A separate Nineytone music player. Load an audio URL or choose a local audio file; nothing autoplays.</div>

            <div class="frost-v27-card">
                <div class="frost-v28-card-title"><span class="frost-v27-mini-icon">♪</span> Source</div>
                <div class="frost-v27-row">
                    <input id="frostV28MusicUrl" class="frost-v27-wide" type="url" placeholder="https://example.com/track.mp3">
                    <button class="btn" id="frostV28MusicLoadUrl">LOAD URL</button>
                    ${frostV28PanelClearButton('frostV28MusicUrl')}
                </div>
                <div class="frost-v27-row">
                    <label>Local file</label>
                    <input id="frostV28MusicFile" type="file" accept="audio/*">
                </div>
            </div>

            <div class="frost-v27-card" style="margin-top:8px">
                <div class="frost-v28-card-title"><span class="frost-v27-mini-icon">▶</span> Player</div>
                <div class="frost-v28-toolbar">
                    <button class="btn primary" id="frostV28MusicPlay">PLAY</button>
                    <button class="btn" id="frostV28MusicPause">PAUSE</button>
                    <button class="btn" id="frostV28MusicStop">STOP</button>
                    <span id="frostV28MusicTime" class="frost-v28-music-time">00:00 / 00:00</span>
                </div>
                <div class="frost-v27-row">
                    <label>Volume</label>
                    <input id="frostV28MusicVolume" type="range" min="0" max="1" step=".05" value="${Number(frostV28Prefs.musicVolume)||0.35}">
                    <span id="frostV28MusicVolumeValue" class="frost-v27-status">${Math.round((Number(frostV28Prefs.musicVolume)||0.35)*100)}%</span>
                    <label style="min-width:auto">Loop</label>
                    <input id="frostV28MusicLoop" class="frost-switch" type="checkbox" ${frostV28Prefs.musicLoop?'checked':''}>
                </div>
                <div id="frostV28MusicStatus" class="frost-v27-display">No track loaded.</div>
            </div>
        `;

        const status = document.getElementById('frostV28MusicStatus');
        const time = document.getElementById('frostV28MusicTime');

        const format = value => {
            if (!Number.isFinite(value)) return '00:00';
            const m = Math.floor(value/60);
            const sec = Math.floor(value%60);
            return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
        };
        const updateTime = () => {
            if (time) time.textContent = `${format(frostV28MusicAudio.currentTime)} / ${format(frostV28MusicAudio.duration)}`;
        };

        document.getElementById('frostV28MusicLoadUrl')?.addEventListener('click', () => {
            const value = document.getElementById('frostV28MusicUrl')?.value?.trim() || '';
            let parsed;
            try {
                parsed = new URL(value, location.href);
                if (!['http:','https:','data:','blob:'].includes(parsed.protocol)) throw new Error();
            } catch (e) {
                showNotification('Enter a valid audio URL','warning');
                return;
            }
            if (frostV28MusicObjectUrl) {
                URL.revokeObjectURL(frostV28MusicObjectUrl);
                frostV28MusicObjectUrl = null;
            }
            frostV28MusicAudio.pause();
            frostV28MusicAudio.src = parsed.href;
            frostV28MusicAudio.load();
            if (status) status.textContent = 'Loaded URL: ' + parsed.href;
        });

        document.getElementById('frostV28MusicFile')?.addEventListener('change', e => {
            const file = e.target.files?.[0];
            if (!file) return;
            if (frostV28MusicObjectUrl) URL.revokeObjectURL(frostV28MusicObjectUrl);
            frostV28MusicObjectUrl = URL.createObjectURL(file);
            frostV28MusicAudio.pause();
            frostV28MusicAudio.src = frostV28MusicObjectUrl;
            frostV28MusicAudio.load();
            if (status) status.textContent = 'Loaded local file: ' + file.name;
        });

        document.getElementById('frostV28MusicPlay')?.addEventListener('click', async () => {
            if (!frostV28MusicAudio.src) return showNotification('Load a track first','warning');
            try {
                await frostV28MusicAudio.play();
                if (status) status.textContent = 'Playing';
            } catch (e) {
                if (status) status.textContent = 'Playback was blocked: ' + e.message;
            }
        });
        document.getElementById('frostV28MusicPause')?.addEventListener('click', () => {
            frostV28MusicAudio.pause();
            if (status) status.textContent = 'Paused';
        });
        document.getElementById('frostV28MusicStop')?.addEventListener('click', () => {
            frostV28MusicAudio.pause();
            try { frostV28MusicAudio.currentTime = 0; } catch (e) {}
            updateTime();
            if (status) status.textContent = 'Stopped';
        });
        document.getElementById('frostV28MusicVolume')?.addEventListener('input', e => {
            const v = Math.max(0,Math.min(1,Number(e.target.value)||0));
            frostV28MusicAudio.volume = v;
            frostV28Prefs.musicVolume = v;
            frostV28SavePrefs();
            const out = document.getElementById('frostV28MusicVolumeValue');
            if (out) out.textContent = Math.round(v*100)+'%';
        });
        document.getElementById('frostV28MusicLoop')?.addEventListener('change', e => {
            frostV28MusicAudio.loop = !!e.target.checked;
            frostV28Prefs.musicLoop = !!e.target.checked;
            frostV28SavePrefs();
        });
        document.querySelector('[data-clear-target="frostV28MusicUrl"]')?.addEventListener('click', () => {
            const input = document.getElementById('frostV28MusicUrl');
            if (input) { input.value=''; input.focus(); }
        });

        frostV28MusicAudio.addEventListener('timeupdate', updateTime);
        frostV28MusicAudio.addEventListener('loadedmetadata', updateTime);
        frostV28MusicAudio.addEventListener('ended', () => {
            updateTime();
            if (status && !frostV28MusicAudio.loop) status.textContent = 'Finished';
        });
    }

