    function addAnimatedSoundToButton(selector, soundType, animationType) {
        document.querySelectorAll(selector).forEach(el => {
            el.addEventListener('click', function(e) {
                playSound(soundType || 'click');
                if (animationType === 'toggle') {
                    animateToggle(this);
                } else if (animationType === 'sidebar') {
                    animateSidebarItem(this);
                } else if (animationType === 'panel') {
                    animatePanelItem(this);
                } else {
                    animateClick(this);
                }
            });
        });
    }

