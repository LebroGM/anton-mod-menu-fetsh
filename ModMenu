    function frostV27CreateSelector(el) {
        if (!(el instanceof Element)) return '';

        // Prefer a stable unique id when available.
        if (el.id) {
            const byId = '#' + CSS.escape(el.id);
            try {
                if (document.querySelectorAll(byId).length === 1) return byId;
            } catch (_) {}
        }

        const attrCandidates = [
            ['data-testid', el.getAttribute('data-testid')],
            ['data-test', el.getAttribute('data-test')],
            ['aria-label', el.getAttribute('aria-label')],
            ['name', el.getAttribute('name')]
        ];

        for (const [name,value] of attrCandidates) {
            if (!value) continue;

            const escaped = String(value)
                .replace(/\\/g,'\\\\')
                .replace(/"/g,'\\"');

            const candidate = `${el.tagName.toLowerCase()}[${name}="${escaped}"]`;

            try {
                if (document.querySelectorAll(candidate).length === 1) {
                    return candidate;
                }
            } catch (_) {}
        }

        // Build a short, deterministic DOM path.
        const parts = [];
        let node = el;

        while (
            node &&
            node instanceof Element &&
            node !== document.body &&
            parts.length < 6
        ) {
            let part = node.tagName.toLowerCase();

            if (node.id) {
                part += '#' + CSS.escape(node.id);
                parts.unshift(part);
                break;
            }

            const usefulClasses = [...node.classList]
                .filter(c => c && !/\b(active|selected|hover|focus|disabled)\b/i.test(c))
                .slice(0,2);

            if (usefulClasses.length) {
                part += '.' + usefulClasses.map(c => CSS.escape(c)).join('.');
            }

            const parent = node.parentElement;
            if (parent) {
                const sameTag = [...parent.children]
                    .filter(child => child.tagName === node.tagName);

                if (sameTag.length > 1) {
                    part += `:nth-of-type(${sameTag.indexOf(node) + 1})`;
                }
            }

            parts.unshift(part);

            const candidate = parts.join(' > ');
            try {
                if (document.querySelectorAll(candidate).length === 1) {
                    return candidate;
                }
            } catch (_) {}

            node = parent;
        }

        return parts.join(' > ') || el.tagName.toLowerCase();
    }

    function frostV27NormalizeAutoKey(rawValue) {
        const raw = String(rawValue ?? '').trim() || 'Space';
        const lower = raw.toLowerCase();

        if (lower === 'space' || lower === 'spacebar' || raw === ' ') {
            return { key:' ', code:'Space', label:'Space' };
        }

        if (lower === 'enter' || lower === 'return') {
            return { key:'Enter', code:'Enter', label:'Enter' };
        }

        if (lower === 'escape' || lower === 'esc') {
            return { key:'Escape', code:'Escape', label:'Escape' };
        }

        const arrows = {
            arrowup:'ArrowUp',
            arrowdown:'ArrowDown',
            arrowleft:'ArrowLeft',
            arrowright:'ArrowRight'
        };

        if (arrows[lower]) {
            return { key:arrows[lower], code:arrows[lower], label:arrows[lower] };
        }

        if (/^key[a-z]$/i.test(raw)) {
            const letter = raw.slice(3).toUpperCase();
            return { key:letter.toLowerCase(), code:'Key'+letter, label:'Key'+letter };
        }

        if (/^digit[0-9]$/i.test(raw)) {
            const digit = raw.slice(5);
            return { key:digit, code:'Digit'+digit, label:'Digit'+digit };
        }

        if (/^[a-z]$/i.test(raw)) {
            const upper = raw.toUpperCase();
            return { key:raw, code:'Key'+upper, label:raw };
        }

        if (/^[0-9]$/.test(raw)) {
            return { key:raw, code:'Digit'+raw, label:raw };
        }

        return { key:raw, code:raw, label:raw };
    }

    function frostV27DispatchKeyboard(target, keyInfo) {
        const eventBase = {
            key:keyInfo.key,
            code:keyInfo.code,
            bubbles:true,
            cancelable:true,
            composed:true,
            repeat:false
        };

        target.dispatchEvent(new KeyboardEvent('keydown', eventBase));
        target.dispatchEvent(new KeyboardEvent('keyup', eventBase));
        return true;
    }

    function frostV27DispatchPointerClick(target, clientX, clientY, buttonName='left') {
        if (!(target instanceof Element)) {
            throw new Error('Target is not a clickable element');
        }

        if (target.closest?.('#modMenuContainer')) {
            throw new Error('Nineytone controls cannot be auto-clicked');
        }

        const rect = target.getBoundingClientRect();
        const x = Number.isFinite(clientX)
            ? clientX
            : rect.left + rect.width / 2;
        const y = Number.isFinite(clientY)
            ? clientY
            : rect.top + rect.height / 2;

        const button = buttonName === 'middle' ? 1 : buttonName === 'right' ? 2 : 0;
        const buttons = buttonName === 'middle' ? 4 : buttonName === 'right' ? 2 : 1;

        const common = {
            bubbles:true,
            cancelable:true,
            composed:true,
            clientX:x,
            clientY:y,
            screenX:x,
            screenY:y,
            button,
            buttons
        };

        // Many modern web UIs listen to pointer events rather than .click().
        if (typeof PointerEvent === 'function') {
            target.dispatchEvent(new PointerEvent('pointerdown', {
                ...common,
                pointerId:1,
                pointerType:'mouse',
                isPrimary:true
            }));
        }

        target.dispatchEvent(new MouseEvent('mousedown', common));

        if (typeof PointerEvent === 'function') {
            target.dispatchEvent(new PointerEvent('pointerup', {
                ...common,
                buttons:0,
                pointerId:1,
                pointerType:'mouse',
                isPrimary:true
            }));
        }

        target.dispatchEvent(new MouseEvent('mouseup', {
            ...common,
            buttons:0
        }));

        // HTMLElement.click() preserves the element's native activation
        // behavior while producing a single click event.
        if (typeof target.click === 'function') {
            target.click();
        } else {
            target.dispatchEvent(new MouseEvent('click', {
                ...common,
                buttons:0
            }));
        }

        frostV27AutoLastTarget = target;
        return true;
    }

    function frostV27AutoTargetLabel(target) {
        if (!(target instanceof Element)) return 'document';
        return frostV27CreateSelector(target) || target.tagName.toLowerCase();
    }

