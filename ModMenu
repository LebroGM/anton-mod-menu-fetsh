        const isDark = currentTheme !== 'standard';

        container.innerHTML = capturedEvents.map((ev, index) => {
            const color = getEventColor(ev.event);
            const isExpanded = ev._expanded || false;
            const dataStr = JSON.stringify(ev.data, null, 2);
            const shortData = dataStr.length > 80 ? dataStr.substring(0, 80) + '...' : dataStr;

            return `<div style="display:flex; flex-direction:column; padding:4px 8px; border-bottom:1px solid ${isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)'}; font-size:10px; font-family:'Inter',sans-serif; cursor:pointer; transition:background 0.15s;"
