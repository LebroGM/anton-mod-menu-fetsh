    function frostPreset(name) {
        if(name==='minimal') Object.assign(frostUiSettings,{snowEnabled:false,vignette:false,grain:false,frostBorder:false,backgroundDim:.02});
        if(name==='soft') Object.assign(frostUiSettings,{snowEnabled:true,snowDensity:26,snowSpeed:.75,snowSize:.9,snowOpacity:.7,vignette:false,grain:false,frostBorder:true,backgroundDim:.10});
        if(name==='blizzard') Object.assign(frostUiSettings,{snowEnabled:true,snowDensity:90,snowSpeed:1.8,snowSize:1.25,snowOpacity:.95,vignette:true,grain:true,frostBorder:true,backgroundDim:.18});
        if(name==='glass') Object.assign(frostUiSettings,{snowEnabled:true,snowDensity:18,snowSpeed:.6,snowSize:.8,snowOpacity:.6,vignette:true,grain:false,frostBorder:true,backgroundDim:.16});
        frostSaveUiSettings('Frost Lab preset: '+name); applyFrostUiSettings(); initSnowEffect(); frostSyncControls(); showNotification('❄ Preset: '+name,'success');
    }

    function frostRefreshInspector() {
        const q=id=>document.getElementById(id);
        if(q('frostInspectorTitle'))q('frostInspectorTitle').textContent=(document.title||'Untitled').slice(0,25);
        if(q('frostInspectorViewport'))q('frostInspectorViewport').textContent=window.innerWidth+'×'+window.innerHeight;
        if(q('frostInspectorDom'))q('frostInspectorDom').textContent=document.getElementsByTagName('*').length.toLocaleString();
        if(q('frostInspectorProtocol'))q('frostInspectorProtocol').textContent=location.protocol.replace(':','').toUpperCase();
        if(q('frostInspectorUrl'))q('frostInspectorUrl').textContent=location.href;
    }

    function frostRefreshPerformance() {
        const q=id=>document.getElementById(id);
        if(q('frostPerfFps'))q('frostPerfFps').textContent=frostFps?Math.round(frostFps):'…';
        if(q('frostPerfDom'))q('frostPerfDom').textContent=document.getElementsByTagName('*').length.toLocaleString();
        const mem=performance.memory?.usedJSHeapSize||0;
        if(q('frostPerfMemory'))q('frostPerfMemory').textContent=mem?(mem/1024/1024).toFixed(1)+' MB':'N/A';
        const sec=Math.floor((Date.now()-FROST_SESSION_START)/1000);
        if(q('frostPerfUptime'))q('frostPerfUptime').textContent=Math.floor(sec/60)+'m '+String(sec%60).padStart(2,'0')+'s';
    }

    function frostPerformanceLoop(now) {
        if(!document.getElementById('modMenuContainer'))return;
        frostFpsFrames++;
        if(now-frostFpsLast>=1000){frostFps=frostFpsFrames*1000/(now-frostFpsLast);frostFpsFrames=0;frostFpsLast=now;frostRefreshPerformance();}
        frostPerformanceFrame=requestAnimationFrame(frostPerformanceLoop);
    }

    function frostCopyText(text) {
        text=String(text??'');
        if(navigator.clipboard?.writeText)return navigator.clipboard.writeText(text);
        return new Promise((resolve,reject)=>{try{const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();resolve();}catch(e){reject(e);}});
    }

    function frostResetWindow() {
        const menu=document.getElementById('modMenuContainer'); if(!menu||isMinimized)return;
        const w=Math.min(860,window.innerWidth-24),h=Math.min(900,window.innerHeight-24);
        menu.style.width=w+'px';menu.style.height=h+'px';menu.style.left=((window.innerWidth-w)/2)+'px';menu.style.top=((window.innerHeight-h)/2)+'px';
        menu.style.transform='none';menu.dataset.restoreW=w;menu.dataset.restoreH=h;updateStoredPosition();frostLogActivity('Window centered and reset');
    }

