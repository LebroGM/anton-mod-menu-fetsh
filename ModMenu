        v('frostFontFamily',frostUiSettings.fontFamily);v('frostCornerRadius',frostUiSettings.cornerRadius);x('frostCornerRadiusValue',frostUiSettings.cornerRadius+'px');v('frostTextScale',frostUiSettings.textScale);x('frostTextScaleValue',Number(frostUiSettings.textScale).toFixed(2)+'×');
        v('frostBackgroundUrl',frostUiSettings.backgroundUrl || FROST_DEFAULT_BACKGROUND);v('frostBackgroundFit',frostUiSettings.backgroundFit);v('frostBackgroundPosition',frostUiSettings.backgroundPosition);
        v('frostSidebarWidth',frostUiSettings.sidebarWidth);x('frostSidebarWidthValue',frostUiSettings.sidebarWidth+'px');
        c('frostCompactMode',frostUiSettings.compactMode);c('frostShowClock',frostUiSettings.showClock);c('frostShowMarquee',frostUiSettings.showMarquee);
