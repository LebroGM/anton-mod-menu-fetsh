    const FROST_RESERVED_BINDINGS = new Set([
        'Ctrl+Shift+A',
        'Ctrl+Shift+S'
    ]);

    let frostKeybinds = loadFrostKeybinds();
    let frostCapturingAction = null;

    function loadFrostKeybinds() {
        try {
            const saved = JSON.parse(localStorage.getItem(FROST_KEYBIND_STORAGE) || '{}');
            return { ...FROST_KEYBIND_DEFAULTS, ...saved };
        } catch (e) {
            return { ...FROST_KEYBIND_DEFAULTS };
        }
    }

    function saveFrostKeybinds() {
        try {
            localStorage.setItem(FROST_KEYBIND_STORAGE, JSON.stringify(frostKeybinds));
        } catch (e) {
            console.warn('[Nineytone] Could not save JKeybinds:', e);
        }
    }

    function frostKeyFromEvent(e) {
        const key = e.key;
        if (['Control', 'Shift', 'Alt', 'Meta'].includes(key)) return '';

        const parts = [];
        if (e.ctrlKey) parts.push('Ctrl');
        if (e.altKey) parts.push('Alt');
        if (e.shiftKey) parts.push('Shift');
        if (e.metaKey) parts.push('Meta');

        let normalized = key;
        if (key.length === 1) normalized = key.toUpperCase();
        if (key === ' ') normalized = 'Space';
        if (key === 'Esc') normalized = 'Escape';

        parts.push(normalized);
        return parts.join('+');
    }

    function frostPrettyBinding(binding) {
        if (!binding) return 'Not set';
        return binding.replaceAll('+', ' + ');
    }

    function frostIsEditableTarget(target) {
        if (!target) return false;
        const tag = target.tagName ? target.tagName.toLowerCase() : '';
        return target.isContentEditable || tag === 'input' || tag === 'textarea' || tag === 'select';
    }

    function frostFindActionByBinding(binding) {
        return Object.keys(frostKeybinds).find(action => frostKeybinds[action] === binding) || null;
    }

    function renderFrostKeybinds() {
        document.querySelectorAll('[data-keybind-action]').forEach(row => {
            const action = row.dataset.keybindAction;
            const value = row.querySelector('.keybind-value');
            const change = row.querySelector('.keybind-change');
            const binding = frostKeybinds[action] || '';

            if (value) {
                value.textContent = frostCapturingAction === action
                    ? 'PRESS KEYS…'
                    : frostPrettyBinding(binding);
                value.classList.toggle('capturing', frostCapturingAction === action);
                value.classList.toggle('empty', !binding && frostCapturingAction !== action);
            }

            if (change) {
                change.textContent = frostCapturingAction === action ? 'Cancel' : 'Change';
            }
        });
    }

    function cycleFrostTabs(direction) {
        const items = Array.from(document.querySelectorAll('#modMenuSidebar .sidebar-item[data-section]'));
        if (!items.length) return;

        let currentIndex = items.findIndex(item => item.classList.contains('active'));
        if (currentIndex < 0) currentIndex = 0;

        const nextIndex = (currentIndex + direction + items.length) % items.length;
        switchSection(items[nextIndex].dataset.section);
    }

    function ensureFrostMenuVisible() {
        if (typeof isMenuOpen !== 'undefined' && !isMenuOpen && typeof window.toggleAntonHacks === 'function') {
            window.toggleAntonHacks();
        }
        if (isMinimized) toggleMinimize();
    }

    function runFrostKeybindAction(action) {
        switch (action) {
            case 'toggleMenu':
                if (typeof window.toggleAntonHacks === 'function') window.toggleAntonHacks();
                break;
            case 'minimizeMenu':
                if (typeof isMenuOpen !== 'undefined' && !isMenuOpen && typeof window.toggleAntonHacks === 'function') {
                    window.toggleAntonHacks();
                }
                toggleMinimize();
                break;
            case 'nextTab':
                ensureFrostMenuVisible();
                cycleFrostTabs(1);
                break;
            case 'previousTab':
                ensureFrostMenuVisible();
                cycleFrostTabs(-1);
                break;
            case 'openGeneral':
                ensureFrostMenuVisible();
                switchSection('general');
                break;
            case 'openKeybinds':
                ensureFrostMenuVisible();
                switchSection('jkeybinds');
                break;
            case 'openCommandPalette':
                ensureFrostMenuVisible();
                if (typeof openFrostCommandPalette === 'function') openFrostCommandPalette();
                break;
        }
    }

    function handleFrostKeydown(e) {
        if (frostCapturingAction) {
            e.preventDefault();
            e.stopPropagation();

            if (e.key === 'Escape') {
                frostCapturingAction = null;
                renderFrostKeybinds();
                showNotification('Keybind change cancelled', 'info');
                return;
            }

            const binding = frostKeyFromEvent(e);
            if (!binding) return;

            if (FROST_RESERVED_BINDINGS.has(binding)) {
                showNotification('That shortcut is already reserved by the existing script', 'warning');
                return;
            }

            const duplicate = frostFindActionByBinding(binding);
            if (duplicate && duplicate !== frostCapturingAction) {
                showNotification(`Already used by ${FROST_KEYBIND_META[duplicate].label}`, 'warning');
                return;
            }

            frostKeybinds[frostCapturingAction] = binding;
            saveFrostKeybinds();
            const savedAction = frostCapturingAction;
            frostCapturingAction = null;
            renderFrostKeybinds();
            showNotification(`${FROST_KEYBIND_META[savedAction].label}: ${frostPrettyBinding(binding)}`, 'success');
            return;
        }

        const binding = frostKeyFromEvent(e);
        if (!binding) return;

        const action = frostFindActionByBinding(binding);
        if (!action) return;

        if (frostIsEditableTarget(e.target) && action !== 'toggleMenu') return;

        e.preventDefault();
        e.stopPropagation();
        runFrostKeybindAction(action);
    }

    function initJKeybinds() {
        renderFrostKeybinds();

        document.querySelectorAll('.keybind-change').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const row = this.closest('[data-keybind-action]');
                if (!row) return;

                const action = row.dataset.keybindAction;
                frostCapturingAction = frostCapturingAction === action ? null : action;
                renderFrostKeybinds();
            });
        });

        document.querySelectorAll('.keybind-clear').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const row = this.closest('[data-keybind-action]');
                if (!row) return;

                const action = row.dataset.keybindAction;
                frostKeybinds[action] = '';
                frostCapturingAction = null;
                saveFrostKeybinds();
                renderFrostKeybinds();
                showNotification(`${FROST_KEYBIND_META[action].label} cleared`, 'info');
            });
        });

        const resetBtn = document.getElementById('resetKeybindsBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                frostKeybinds = { ...FROST_KEYBIND_DEFAULTS };
                frostCapturingAction = null;
                saveFrostKeybinds();
                renderFrostKeybinds();
                showNotification('JKeybinds reset to defaults', 'success');
            });
        }

        const openKeybindsBtn = document.getElementById('openKeybindsFromGeneral');
        if (openKeybindsBtn) {
            openKeybindsBtn.addEventListener('click', () => switchSection('jkeybinds'));
        }

        const openThemesBtn = document.getElementById('openThemesFromGeneral');
        if (openThemesBtn) {
            openThemesBtn.addEventListener('click', () => switchSection('themes'));
        }

        document.addEventListener('keydown', handleFrostKeydown, true);
    }

