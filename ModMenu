    function frostV29SafeTarget(el) {
        if (!el || !el.tagName) return 'unknown';
        let out=el.tagName.toLowerCase();
        if(el.id) out+='#'+String(el.id).slice(0,60);
        const cls=[...(el.classList||[])].slice(0,2);
        if(cls.length) out+='.'+cls.join('.');
        return out.slice(0,140);
    }

    function frostV29EventMeta(e) {
        const meta={};
        if(e.type==='click'||e.type==='dblclick'||e.type==='pointerdown'){
            meta.x=Math.round(e.clientX||0);meta.y=Math.round(e.clientY||0);meta.button=Number(e.button||0);
        } else if(e.type==='keydown'){
            meta.keyKind=e.key?.length===1?'character':'control';
            meta.ctrl=!!e.ctrlKey;meta.alt=!!e.altKey;meta.shift=!!e.shiftKey;meta.meta=!!e.metaKey;
        } else if(e.type==='input'||e.type==='change'){
            const t=e.target;
            meta.inputType=t?.type||t?.tagName?.toLowerCase()||'unknown';
            if(t?.tagName==='SELECT') meta.optionCount=t.options?.length||0;
        } else if(e.type==='submit'){
            meta.method=(e.target?.method||'get').toUpperCase();
            try{meta.action=new URL(e.target?.action||location.href,location.href).origin+new URL(e.target?.action||location.href,location.href).pathname}catch(_){}
        }
        return meta;
    }

    function frostV29PushEvent(entry){
        frostV29EventMonitor.entries.unshift(entry);
        frostV29EventMonitor.entries=frostV29EventMonitor.entries.slice(0,frostV29EventMonitor.max);
