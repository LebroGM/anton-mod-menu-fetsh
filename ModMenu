    // ☣︎ Nineytone ☣︎ v29 - PLUGIN SLOTS
    // Local registration API only; no remote plugin loader.
    // ==========================================================
    function frostV29InstallPluginApi(){
        window.Nineytone=window.Nineytone||{};
        window.Nineytone.registerUtilityPlugin=function(plugin){
            if(!plugin||typeof plugin!=='object')throw new Error('Plugin object required');
            const id='plugin_'+frostV29Slug(plugin.id||plugin.title);
            if(!plugin.title||typeof plugin.render!=='function')throw new Error('Plugin title and render() required');
            frostV29PluginRegistry.set(id,{...plugin,id});
