    let nextCoinStarsOverrideOriginalLogMethod = null;
    let nextCoinStarsOverrideWrapper = null;
    let nextCoinStarsOverrideInterceptCount = 0;

    function frostNormalizeNextCoinStarsValue(value) {
        const num = Number(value);

        if (
            !Number.isFinite(num) ||
            !Number.isSafeInteger(num) ||
            num < 0
        ) {
            return null;
        }

        return num;
    }

    function frostSetNextCoinStarsOverrideValue(value, notify = true) {
        const num = frostNormalizeNextCoinStarsValue(value);

        if (num === null) {
            if (notify) {
                showNotification('❌ Required Stars must be a non-negative whole number', 'error');
                playSound('error');
            }
            return false;
        }

        nextCoinStarsOverrideValue = num;

        const input = document.getElementById('nextCoinStarsValueInput');
        const current = document.getElementById('nextCoinStarsCurrentValue');

        if (input) input.value = String(num);
        if (current) current.textContent = num.toLocaleString();

        if (notify) {
            showNotification(`⭐ Next Coin requirement override = ${num.toLocaleString()} Stars`, 'success');
            playSound('toggle');
        }

        return true;
