    // ==========================================
    // ANTI AFK - No Website Lost Focus
    // ==========================================
    let antiAfkOriginalLogMethod = null;

    let antiAfkInterceptCount = 0;

    function frostAntiAfkTransform(data) {
        if (!antiAfkActive || !data || data.event !== 'sessionEnd' || data.type !== 'suspend') {
            return data;
        }

        // Do exactly what Disable Coin Loss does conceptually:
        // transform the outgoing event BEFORE the downstream logger sees it.
        try {
            data.type = '';
        } catch (_) {}

        if (data.type === 'suspend') {
            return { ...data, type: '' };
        }

        return data;
    }

    function toggleAntiAfk(enable) {
        antiAfkActive = !!enable;

        if (antiAfkActive) {
            if (typeof log === 'undefined' || log === null || typeof log.log !== 'function') {
                antiAfkActive = false;
                showNotification('❌ Anti AFK could not attach to log.log', 'error');
                playSound('error');
                return false;
            }

            // Same interception model as Disable Coin Loss:
            // save the current downstream logger and replace log.log with
            // a small wrapper that modifies matching events before forwarding.
            if (!antiAfkOriginalLogMethod) {
                antiAfkOriginalLogMethod = log.log.bind(log);
            }

            log.log = function(data) {
                const matched = !!(
                    data &&
                    data.event === 'sessionEnd' &&
                    data.type === 'suspend'
                );

                const outgoing = frostAntiAfkTransform(data);

                if (matched) {
                    antiAfkInterceptCount++;
                    console.log(
                        `[ANTI AFK] Intercepted sessionEnd: suspend → "" ` +
                        `(Blocked: ${antiAfkInterceptCount})`
                    );
                    showNotification(
                        `🛡️ Session suspend removed! (${antiAfkInterceptCount})`,
                        'success'
                    );
                }

                if (antiAfkOriginalLogMethod) {
                    return antiAfkOriginalLogMethod(outgoing);
                }

                // Defensive fallback matching the other log wrappers.
                if (
                    typeof log !== 'undefined' &&
                    log !== null &&
                    typeof log.log === 'function' &&
                    log.log !== arguments.callee
                ) {
                    return log.log(outgoing);
                }
            };

            const toggle = document.getElementById('antiAfkToggle');
            const label = document.getElementById('antiAfkLabel');

            toggle?.classList.add('active');
            if (label) {
                label.textContent = 'ON';
                label.classList.add('active');
            }

            showNotification('🛡️ Anti AFK activated', 'success');
            playSound('toggle');
            return true;
        }

        if (antiAfkOriginalLogMethod && typeof log !== 'undefined' && log !== null) {
            log.log = antiAfkOriginalLogMethod;
            antiAfkOriginalLogMethod = null;
        }

        antiAfkInterceptCount = 0;

        const toggle = document.getElementById('antiAfkToggle');
        const label = document.getElementById('antiAfkLabel');

        toggle?.classList.remove('active');
        if (label) {
            label.textContent = 'OFF';
            label.classList.remove('active');
        }

        showNotification('🛡️ Anti AFK deactivated', 'info');
        playSound('toggle');
        return true;
    }

    function toggleAntiAfkHandler() {
        toggleAntiAfk(!antiAfkActive);
    }

