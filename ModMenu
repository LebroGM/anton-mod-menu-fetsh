    // ==========================================
    // CALCULATOR ENGINE - ENHANCED
    // ==========================================
    let calcDisplay = '0';
    let calcExpression = '';
    let calcMemory = 0;
    let calcHasMemory = false;
    let calcHistory = [];
    let calcJustEvaluated = false;

    function updateCalcDisplay() {
        const resultDisplay = document.getElementById('calcResultDisplay');
        const expressionDisplay = document.getElementById('calcExpressionDisplay');
        const memoryDisplay = document.getElementById('calcMemoryDisplay');

        if (resultDisplay) resultDisplay.textContent = calcDisplay || '0';
        if (expressionDisplay) expressionDisplay.textContent = calcExpression || '0';
        if (memoryDisplay) memoryDisplay.textContent = calcHasMemory ? `M: ${calcMemory}` : 'M: 0';
    }

    function calcAppend(value) {
        if (calcJustEvaluated) {
            calcDisplay = '0';
            calcExpression = '';
            calcJustEvaluated = false;
        }
        if (calcDisplay === '0' && value !== '.') {
            calcDisplay = value;
        } else {
            if (value === '.' && calcDisplay.includes('.')) return;
            calcDisplay += value;
        }
        updateCalcDisplay();
    }

    function calcOperator(op) {
        if (calcJustEvaluated) {
            calcExpression = calcDisplay + ' ' + op + ' ';
            calcJustEvaluated = false;
        } else {
            if (calcDisplay !== '' && calcDisplay !== '0') {
                calcExpression += calcDisplay + ' ' + op + ' ';
            } else {
                calcExpression = calcExpression.replace(/[+\-*/%]\s*$/, '') + ' ' + op + ' ';
            }
        }
        calcDisplay = '0';
        updateCalcDisplay();
    }

    function calcEvaluate() {
        try {
            let expr = (calcExpression + calcDisplay).trim();
            let open = (expr.match(/\(/g) || []).length;
            let close = (expr.match(/\)/g) || []).length;
            while (close < open) { expr += ')'; close++; }

            const result = frostV29CalcParse(expr);
            const pretty = frostV29CalcFormat(result);

            const historyEntry = `${expr} = ${pretty}`;
            calcHistory.push(historyEntry);
            if (calcHistory.length > 20) calcHistory.shift();
            updateCalcHistory();

            calcExpression = pretty + ' ';
            calcDisplay = pretty;
            calcJustEvaluated = true;
            updateCalcDisplay();
            playSound('success');
            showNotification(`Calculator result: ${pretty}`, 'success');
        } catch(e) {
            showNotification(`Calculation error: ${e.message}`, 'error');
            playSound('error');
            calcDisplay = 'Error';
            updateCalcDisplay();
            setTimeout(() => {
                calcDisplay = '0';
                calcExpression = '';
                calcJustEvaluated = false;
                updateCalcDisplay();
            }, 1500);
        }
    }

    function calcClear() {
        calcDisplay = '0';
        calcExpression = '';
        calcJustEvaluated = false;
        updateCalcDisplay();
        playSound('click');
    }

    function calcMemoryOp(op) {
        const current = parseFloat(calcDisplay);
        if (isNaN(current)) { showNotification('❌ Invalid number', 'error'); return; }

        switch(op) {
            case 'mc':
                calcHasMemory = false;
                calcMemory = 0;
                showNotification('🧮 Memory cleared', 'info');
                break;
            case 'mr':
                if (calcHasMemory) {
                    calcDisplay = calcMemory.toString();
                    calcJustEvaluated = false;
                    showNotification('🧮 Memory recalled', 'info');
                } else {
                    showNotification('❌ No memory stored', 'warning');
                }
                break;
            case 'm+':
                calcMemory += current;
                calcHasMemory = true;
                showNotification(`🧮 Added to memory: ${calcMemory}`, 'info');
                break;
            case 'm-':
                calcMemory -= current;
                calcHasMemory = true;
                showNotification(`🧮 Subtracted from memory: ${calcMemory}`, 'info');
                break;
        }
        updateCalcDisplay();
        playSound('click');
    }

    function calcScientific(func) {
        const current = parseFloat(calcDisplay);
        if (isNaN(current)) { showNotification('❌ Invalid number', 'error'); return; }

        let result;
        switch(func) {
            case 'sin': result = Math.sin(current); break;
            case 'cos': result = Math.cos(current); break;
            case 'tan': result = Math.tan(current); break;
            case 'log': result = Math.log10(current); break;
            case 'ln': result = Math.log(current); break;
            case 'sqrt': result = Math.sqrt(current); break;
            case 'square': result = current * current; break;
            case 'cube': result = current * current * current; break;
            case 'pi': result = Math.PI; break;
            case 'e': result = Math.E; break;
            case 'fact': result = calcFactorial(current); break;
            case 'inv':
                if (current === 0) { showNotification('❌ Division by zero', 'error'); return; }
                result = 1 / current;
                break;
            default: return;
        }

        if (typeof result === 'number' && !isNaN(result) && isFinite(result)) {
            calcDisplay = result.toString();
            const historyEntry = `${func}(${current}) = ${result}`;
            calcHistory.push(historyEntry);
            if (calcHistory.length > 20) calcHistory.shift();
            updateCalcHistory();
            calcJustEvaluated = true;
            updateCalcDisplay();
            playSound('success');
            showNotification(`🧮 ${func}(${current}) = ${result}`, 'success');
        } else {
            showNotification('❌ Error in scientific function', 'error');
            playSound('error');
        }
    }

    function calcFactorial(n) {
        if (n < 0) return NaN;
        if (n === 0 || n === 1) return 1;
        if (n > 170) return Infinity;
        if (!Number.isInteger(n)) return NaN;
        let result = 1;
        for (let i = 2; i <= n; i++) result *= i;
        return result;
    }

    function updateCalcHistory() {
        const historyEl = document.getElementById('calcHistoryList');
        if (!historyEl) return;
        if (calcHistory.length === 0) {
            historyEl.innerHTML = '<span style="color:#9ca3af; font-style:italic;">No history yet</span>';
            return;
        }
