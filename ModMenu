    }

    function frostV28EnsureSafeTabRegistry() {
        if (!FROST_SAFE_TABS.some(row => row[0] === 'music')) FROST_SAFE_TABS.push(['music','♫','Music']);
        if (!FROST_SAFE_TABS.some(row => row[0] === 'config')) FROST_SAFE_TABS.push(['config','⚙','Config']);

        if (!FROST_COMMANDS.some(cmd => cmd.keywords?.includes('v28music'))) {
            FROST_COMMANDS.push({
                label:'Open Music',
                keywords:'music audio player v28music',
                hint:'TAB',
                section:'music',
                run:()=>switchSection('music')
            });
        }
        if (!FROST_COMMANDS.some(cmd => cmd.keywords?.includes('v28config'))) {
            FROST_COMMANDS.push({
                label:'Open Config',
                keywords:'config reset settings v28config',
                hint:'TAB',
                section:'config',
                run:()=>switchSection('config')
            });
        }
    }

