        v('frostSnowOpacity',frostUiSettings.snowOpacity);x('frostSnowOpacityValue',Math.round(Number(frostUiSettings.snowOpacity)*100)+'%');
        c('frostVignette',frostUiSettings.vignette);c('frostGrain',frostUiSettings.grain);c('frostBorder',frostUiSettings.frostBorder);
        v('frostBackgroundDim',frostUiSettings.backgroundDim);x('frostBackgroundDimValue',Math.round(Number(frostUiSettings.backgroundDim)*100)+'%');
