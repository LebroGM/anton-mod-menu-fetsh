    function frostRemakeLang(){
        const code=frostV28Prefs?.language||'en';
        return FROST_REMAKE_I18N[code]||FROST_REMAKE_I18N.en;
    }

    function frostRemakeText(key){
        const lang=frostRemakeLang();
        return lang[key]||FROST_REMAKE_I18N.en[key]||key;
    }

    function frostApplyRemakeLanguage(){
        document.querySelectorAll('#modMenuContainer [data-frost-remake-i18n]').forEach(el=>{
            const key=el.dataset.frostRemakeI18n;
            if(key)el.textContent=frostRemakeText(key);
        });

        document.querySelectorAll('#modMenuContainer [data-frost-remake-placeholder]').forEach(el=>{
            const key=el.dataset.frostRemakePlaceholder;
            if(key)el.setAttribute('placeholder',frostRemakeText(key));
        });

        // Hide/Show is state-dependent. The try/catch keeps the early v28
        // language pass safe before the v29 state object is initialized.
        let hidden=false;
        try{hidden=!!frostV29.hideModStamp;}catch(_){}
        const stamp=document.getElementById('f29HideModStampLabel');
        if(stamp)stamp.textContent=frostRemakeText(hidden?'showModStamp':'hideModStamp');

        document.querySelectorAll('[data-f29-net-expand]').forEach(btn=>{
            const expanded=btn.dataset.expanded==='1';
            btn.textContent=frostRemakeText(expanded?'collapse':'expand');
        });
    }

